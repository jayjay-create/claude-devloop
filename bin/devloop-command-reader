  expect "the third addendum, block 30 of 30: singleinstance to stack, each judged at brew or handing it on" 0 "1|0|list|0|3|singleinstance|%1|brew|install|ah" "2|0|list|0|4|Start|/box:DefaultBox|/wait|brew|install|ai" "3|0|list|0|1|win-sudo|brew|install|aj" "4|0|list|0|1|wsudox|brew|install|ak" "5|0|list|0|1|capsh|--caps=|--|-c|brew install al" "6|5|shell|0|1|brew|install|al" "7|0|list|0|5|dockerize|-wait|tcp://db:5432|-exec|brew|install|am" "8|0|list|0|1|tar|--use-compress-program=brew install an|-cf|a.tar|f" "9|8|shell|0|1|brew|install|an" "10|0|list|0|1|fzf|--preview|brew install ao" "11|10|shell|0|1|brew|install|ao" "12|0|list|0|3|coreutils|nice|brew|install|ap" "13|0|list|0|2|run-one|brew|install|aq" "14|0|list|0|2|run-one-constantly|brew|install|ar" "15|0|list|0|2|run-one-until-success|brew|install|as" "16|0|list|0|2|run-one-until-failure|brew|install|at" "17|0|list|0|2|run-this-one|brew|install|au" "18|0|list|0|2|keep-one-running|brew|install|av" "19|0|list|0|4|wait-for-it.sh|db:5432|--|brew|install|aw" "20|0|list|0|1|ncat|-l|8080|--sh-exec|brew install ax" "21|20|shell|0|1|brew|install|ax" "22|0|list|0|1|mate-terminal|-e|brew install ay" "23|22|shell|0|1|brew|install|ay" "24|0|list|0|1|guix|shell|python|--|brew|install|az" "25|24|exec|0|1|brew|install|az" "26|0|list|0|1|fades|-d|requests|brew|install|ba" "27|26|exec|0|1|brew|install|ba" "28|0|list|0|1|stack|exec|--package|hlint|--|brew|install|bb" "29|28|exec|0|1|brew|install|bb"
  lines "the third addendum, block 30 of 30: singleinstance to stack, each judged at brew or handing it on" 29

  # what cannot be taken apart goes through: parsed no, no line
  runc 'echo "x && brew install ripgrep';   expect "a double quote not closed" 0 "parsed: no: a double quote is not closed"
  lines "a double quote not closed" 0
  runc "echo 'x";                           expect "a single quote not closed" 0 "parsed: no: a single quote is not closed"
  runc 'echo $(brew install x';             expect "a substitution not closed" 0 "parsed: no: a \$( or ( is not closed"
  runc 'echo `x';                           expect "a backtick not closed" 0 "parsed: no: a backtick is not closed"
  runc 'echo ${X';                          expect "a \${ not closed" 0 "parsed: no: a \${ is not closed"
  runc 'npm test &&';                       expect "an operator with nothing behind it" 0 "parsed: no: nothing stands behind '&&'"
  runc '| a';                               expect "an operator with nothing before it" 0 "parsed: no: '|' with no command before it"
  runc 'if true; then a';                   expect "an if without its fi" 0 "parsed: no: 'fi' was expected and the text ended"
  runc 'a; fi';                             expect "a fi without its if" 0 "parsed: no: 'fi' without the opening it closes"
  runc 'a ;; b';                            expect "a ;; outside a case" 0 "parsed: no: ';;' outside a case"
  runc 'a )';                               expect "a parenthesis that closes nothing" 0 "parsed: no: ')' without the opening it closes"
  runc '( )';                               expect "an empty subshell" 0 "parsed: no: ')' with no command before it"
  runc 'case x in a) b; esac';              expect "a case whose list is not closed by ;;: read as bash reads it" 0 "1|0|list|0|1|b"
  echo "SELF-TEST PASSED: $n cases"
  exit 0
}
[ $# -eq 1 ] && [ "$1" = --self-test ] && selftest
[ $# -eq 0 ] || usage "expected no argument, or --self-test alone, got $#"

# The system this runs on, for the one question the reader asks of it: which
# program is the platform shell a vendor hands a text to - sh here, cmd.exe on
# Windows with Git Bash, whose command line is code in another language and
# is not read. Read off bash's own OSTYPE, msys under Git Bash and cygwin
# under Cygwin, so that no program is started for it; DEVLOOP_READER_OS
# stands in for it in the self-test alone.
OS="${DEVLOOP_READER_OS:-${OSTYPE:-}}"
LC_ALL=C awk -v me="$me" -v os="$OS" -f /dev/fd/3 3<<'AWK'
# ----------------------------------------------------------------- the JSON
BEGIN {
  US = sprintf("%c", 31); Q = sprintf("%c", 39)
  WINDOWS = (os ~ /^(msys|cygwin|MINGW|MSYS|CYGWIN)/); MACOS = (os ~ /^darwin/)
  WANT["hook_event_name"] = 1; WANT["tool_name"] = 1; WANT["cwd"] = 1
  WANT["permission_mode"] = 1; WANT["session_id"] = 1
  WANT["tool_input.command"] = 1; WANT["tool_input.file_path"] = 1
  # the wrappers read over, one word and two words, each with the options that take a value, read off the vendors as docs/roadmap.md names them under the entry on the command reader and its addenda of 13 October 2026
  ONEWORD = " - timeout time nice nohup stdbuf command builtin noglob nocorrect watch setsid ionice flock xargs sudo doas su run0 pkexec env trap exec caffeinate chrt taskset strace valgrind hyperfine unbuffer chronic script arch xcrun sandbox-exec systemd-run nix-shell runuser setpriv gsudo runas login gosu prlimit numactl setarch linux32 linux64 nocache cpulimit ltrace heaptrack gdb lldb rr uclampset winpty firejail ssh-agent lockf apply msgexec kinit sc_usage dtruss dapptrace dappprof procsystime dtrace leaks sg bpftrace ifne lckdo pee mispipe parallel fd tmux screen dtach abduco nq tsp daemon daemonize entr watchexec nodemon reflex chokidar onchange watchman-make when-changed wgo gow chruby-exec envchain godotenv env-cmd cross-env cross-env-shell dotenv npx "
