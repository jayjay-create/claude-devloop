  runc 'STATUS=$(curl -s u); x+=1';         expect "an assignment alone: no first word, its substitution a command" 0 "1|0|list|0|0|STATUS=\$(curl -s u)" "2|1|subst|0|1|curl|-s|u" "3|0|list|0|0|x+=1"
  runc 'timeout 600 brew install a; timeout -s KILL -k 5 10 b; timeout --signal=INT 1 c'
