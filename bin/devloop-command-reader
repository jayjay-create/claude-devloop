  lines "the third addendum, block 27 of 30: withlock to xss, each judged at brew or handing it on" 42
  runm $'xss-lock -- brew install ripgrep; printf \'x\' | xstream brew install ripgrep; xterm -e brew install ripgrep; xtrace -- brew install ripgrep; xtruss brew install ripgrep; xuserrun brew install ripgrep; xvfb-run brew install ripgrep; echo ripgrep | yargs brew install %; yas brew install ripgrep; echo ripgrep | yup-xargs brew install; za \'(*)\' brew install ripgrep; zdaemon -p \'brew install ripgrep\' fg; zenv -f .env -- brew install ripgrep; zinkrun brew install ripgrep; zip -T -TT \'brew install ripgrep #\' out.zip file; zitify -i id.json brew install ripgrep; zkexec -c zk:2181 -e "brew install ripgrep"; zmx run s1 brew install ripgrep; zrun brew install ripgrep; zutty -e brew install ripgrep; zvbi-chains brew install ripgrep; socat - SYSTEM:\'brew install a\'; man -P \'brew install zz1\' ls; bat --pager \'brew install zz2\' f; sk -c \'brew install zz3\'; rsync -e \'brew install zz4\' a b:c; tcpclient host 80 brew install zz5; feh --action \'brew install zz6\' a.jpg; websocat -s 8080 cmd:\'brew install b\'; swayidle timeout 1 \'brew install c\''
  expect "the third addendum, block 28 of 30: xss-lock to swayidle, each judged at brew or handing it on" 0 "1|0|list|0|3|xss-lock|--|brew|install|ripgrep" "2|0|list|0|1|printf|x" "3|0|list|2|2|xstream|brew|install|ripgrep" "4|0|list|0|3|xterm|-e|brew|install|ripgrep" "5|0|list|0|3|xtrace|--|brew|install|ripgrep" "6|0|list|0|2|xtruss|brew|install|ripgrep" "7|0|list|0|2|xuserrun|brew|install|ripgrep" "8|0|list|0|2|xvfb-run|brew|install|ripgrep" "9|0|list|0|1|echo|ripgrep" "10|0|list|9|2|yargs|brew|install|%" "11|0|list|0|2|yas|brew|install|ripgrep" "12|0|list|0|1|echo|ripgrep" "13|0|list|12|2|yup-xargs|brew|install" "14|0|list|0|3|za|(*)|brew|install|ripgrep" "15|0|list|0|1|zdaemon|-p|brew install ripgrep|fg" "16|15|exec|0|1|brew|install|ripgrep" "17|0|list|0|5|zenv|-f|.env|--|brew|install|ripgrep" "18|0|list|0|2|zinkrun|brew|install|ripgrep" "19|0|list|0|1|zip|-T|-TT|brew install ripgrep #|out.zip|file" "20|19|shell|0|1|brew|install|ripgrep" "21|0|list|0|4|zitify|-i|id.json|brew|install|ripgrep" "22|0|list|0|1|zkexec|-c|zk:2181|-e|brew install ripgrep" "23|22|shell|0|1|brew|install|ripgrep" "24|0|list|0|4|zmx|run|s1|brew|install|ripgrep" "25|0|list|0|2|zrun|brew|install|ripgrep" "26|0|list|0|3|zutty|-e|brew|install|ripgrep" "27|0|list|0|2|zvbi-chains|brew|install|ripgrep" "28|0|list|0|1|socat|-|SYSTEM:brew install a" "29|28|shell|0|1|brew|install|a" "30|0|list|0|1|man|-P|brew install zz1|ls" "31|30|shell|0|1|brew|install|zz1" "32|0|list|0|1|bat|--pager|brew install zz2|f" "33|32|exec|0|1|brew|install|zz2" "34|0|list|0|1|sk|-c|brew install zz3" "35|34|shell|0|1|brew|install|zz3" "36|0|list|0|1|rsync|-e|brew install zz4|a|b:c" "37|36|exec|0|1|brew|install|zz4" "38|0|list|0|4|tcpclient|host|80|brew|install|zz5" "39|0|list|0|1|feh|--action|brew install zz6|a.jpg" "40|39|shell|0|1|brew|install|zz6" "41|0|list|0|1|websocat|-s|8080|cmd:brew install b" "42|41|shell|0|1|brew|install|b" "43|0|list|0|1|swayidle|timeout|1|brew install c" "44|43|shell|0|1|brew|install|c"
  lines "the third addendum, block 28 of 30: xss-lock to swayidle, each judged at brew or handing it on" 44
  runc $'xidlehook --timer 1 \'brew install d\' \'\'; shellinaboxd -s \'/:nobody:nogroup:/:brew install e\'; multiplex \'x,brew install f\'; sinfonia \'x=brew install g\'; rmux new-session -d \'brew install h\'; busybox timeout 9 brew install i; toybox nice brew install j; rust-parallel \'brew install {}\' ::: k; watchmedo shell-command --command=\'brew install l\' .; watchmedo auto-restart -d . -- brew install m; nircmd elevate brew install n; sv shell -- brew install o; uftrace record brew install p; forever start -c brew install q; tuios new-window w -- brew install r; ksu root -e brew install s; scl enable c1 \'brew install t\'; pbrun brew install u; dzdo brew install v; devenv shell brew install w; lerna exec -- brew install x; yarn workspaces foreach -A exec brew install y; pm2 start \'brew install z\'; AdvancedRun /EXEFilename brew /CommandLine \'install aa\' /Run; kdesu brew install ab; MinSudo --NoLogo brew install ac; RunAsDate 22.10.2002 12:35:22 brew install ad; RunAsTI \'brew install ae\'; RunFromProcess admin winlogon.exe brew install af; shellrunas /netonly brew install ag'
