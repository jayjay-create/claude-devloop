    j = skip_opts(d, j, " -n --interval -q --equexit -s --shotsdir ")
    if (m) return j
    if (j <= NW[d]) add_st(d, joined(d, j, NW[d]))
    return NW[d] + 1
  }
  if (name == "nodemon") {
    # nodemon [options] [script] [args]: -x and --exec take the program as one
    # word, its parser reading the exact word and no =value; every word that is
    # no option and no value of one - the script and its arguments, and all
    # that stands behind -- - is appended, and the whole is one string sh -c
    # runs, cmd /c on Windows, where it is not read; without --exec it runs
    # node, or the program its extension map names, on the script file, which
    # is not read; -h, --help, -v and --version run nothing
    t = ""; m = ""
    for (k = j; k <= NW[d]; k++) {
      w = W[d, k]
      if (is_redir_op(w)) { k++; continue }
      if (w == "--") { if (k < NW[d]) m = m (m == "" ? "" : " ") joined(d, k + 1, NW[d]); break }
      if (w == "-x" || w == "--exec") { if (k < NW[d]) { t = W[d, k + 1]; k++ } continue }
      if (w ~ /^-/) { if (index(" -h --help -? -v --version ", " " w " ") > 0) return -1; k += opt_width(VALS["nodemon"], w); continue }
      m = m (m == "" ? "" : " ") w
