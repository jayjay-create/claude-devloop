  if (name == "feh") {
    # feh 3.13.1: -A, --action, --action1 to --action9 and --info hand a text to /bin/sh, a leading ; and a [title] taken off
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; m = w; sub(/=.*/, "", m); if (m ~ /^(-A|--action[1-9]?|--info)$/) { if (m != w) t = substr(w, length(m) + 2); else if (k < NW[d]) { t = W[d, k + 1]; k++ } else t = ""; sub(/^;/, "", t); if (t ~ /^\[[^ ]*\]/) sub(/^\[[^]]*\]/, "", t); if (t != "") add_st(d, t) } else if (w ~ /^-/) k += opt_width(VALS[name], w) }
    return -1
  }
  if (name == "sk") {
    # skim v5.7.4: -c and --cmd and --preview texts for sh -c, on Windows for cmd /c and not read; --bind takes one or more bindings, each read as fzf reads its own
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (w == "--bind" || w == "-b") { for (m = k + 1; m <= NW[d] && W[d, m] !~ /^-/; m++) fzf_bind(d, W[d, m]); k = m - 1 } else if (w ~ /^--bind=/) fzf_bind(d, substr(w, 8)); else if ((w == "-c" || w == "--cmd" || w == "--preview") && k < NW[d]) { if (!WINDOWS) add_st(d, W[d, k + 1]); k++ } else if (w ~ /^--(cmd|preview)=/) { if (!WINDOWS) add_st(d, substr(w, index(w, "=") + 1)) } else if (w ~ /^-/) k += opt_width(VALS[name], w) }
    return -1
  }
  if (name == "socat") {
    # socat 1.8: an address SYSTEM:text hands the text to /bin/sh, EXEC:command hands its words to execvp; the address options follow behind a comma
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (toupper(substr(w, 1, 7)) == "SYSTEM:") { t = substr(w, 8); sub(/,.*/, "", t); add_st(d, t) } else if (toupper(substr(w, 1, 5)) == "EXEC:") { t = substr(w, 6); sub(/,.*/, "", t); add_cht(d, t) } }
    return -1
  }
  if (name == "websocat") {
    # websocat: the specifiers cmd: and sh-c: hand a text to a shell, exec: names a program whose arguments --exec-args gives as words
    t = ""
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (w ~ /^(cmd|sh-c):/) add_st(d, substr(w, index(w, ":") + 1)); else if (w ~ /^exec:/) t = substr(w, 6); else if (w == "--exec-args") { if (t != "" && k < NW[d]) t = t " " joined(d, k + 1, NW[d]); break } }
    if (t != "") add_cht(d, t)
    return -1
  }
  if (name == "swayidle") {
    # swayidle: the command of each event a text for sh - timeout N cmd [resume cmd], before-sleep, after-resume, lock and unlock with their cmd
    j = skip_opts(d, j, " -C -S ")
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (w == "timeout" || w == "idlehint") { k++; if (w == "timeout" && k < NW[d]) { add_st(d, W[d, k + 1]); k++ } continue } if (index(" resume before-sleep after-resume lock unlock ", " " w " ") > 0 && k < NW[d]) { add_st(d, W[d, k + 1]); k++ } }
    return -1
  }
  if (name == "xidlehook") {
    # xidlehook --timer SECONDS COMMAND CANCELLER: both texts for sh -c, an empty one running nothing
    for (k = j; k <= NW[d]; k++) if (W[d, k] == "--timer" && k + 2 <= NW[d]) { add_st(d, W[d, k + 2]); if (k + 3 <= NW[d]) add_st(d, W[d, k + 3]); k += 3 }
    return -1
  }
  if (name == "shellinaboxd") {
    # shellinaboxd -s URL:USER:GROUP:CWD:CMD: the command behind the fourth colon a text; LOGIN and SSH as the second field run no command of the line
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if ((w == "-s" || w == "--service") && k < NW[d]) { w = W[d, k + 1]; k++ } else if (w ~ /^--service=/) { w = substr(w, 11) } else continue; t = w; for (m = 0; m < 4 && index(t, ":") > 0; m++) t = substr(t, index(t, ":") + 1); if (m == 4 && t != "") add_st(d, t) }
    return -1
  }
  if (name == "multiplex" || name == "sinfonia") {
    # multiplex: each operand a command, a label before a comma; sinfonia: each operand name=command; the command a text for the shell
    j = skip_opts(d, j, " --cwd --buffer-size --stream-buffer-size --title -b -l -c ")
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (name == "multiplex" && w ~ /^[^ ,]+,/) w = substr(w, index(w, ",") + 1); if (name == "sinfonia" && w ~ /^[^ =]+=/) w = substr(w, index(w, "=") + 1); add_st(d, w) }
    return -1
  }
  if (name == "gsudo") {
    # gsudo v2.6.1 started from Git Bash joins the words into one text for bash -c; -d and --direct hand them to cmd /c, code in another language; the verbs config, status, cache, help and !! run no command of the line, run is read over
    if (j <= NW[d] && index(" config status cache !! help ", " " W[d, j] " ") > 0) return -1
    if (has_optv(d, j, " -d --direct -h --help -v --version ", VALS["gsudo"])) return -1
    j = skip_opts(d, j, VALS["gsudo"])
    if (j <= NW[d] && W[d, j] == "run") j++
    if (j <= NW[d]) add_st(d, joined(d, j, NW[d]))
    return NW[d] + 1
  }
  if (name == "run0" && has_optv(d, j, " --via-shell -i ", VALS["run0"]) && !has_optv(d, j, SELF["run0"], VALS["run0"])) {
    # run0 v262 with --via-shell or -i joins the words with blanks, unquoted, into one text for the login shell of the target user
    j = skip_opts(d, j, VALS["run0"])
    if (j <= NW[d]) add_st(d, joined(d, j, NW[d]))
    return NW[d] + 1
  }
  # onchange v7.1.0: a -- as its very first argument leaves it no command, index 0 being false in its getArgs, nothing run, since the fourth addendum of 14 October 2026
  if (name == "onchange" && j <= NW[d] && W[d, j] == "--") return -1
  if (name == "man") {
    # man is the command itself; -P and --pager: on macOS /usr/bin/man is a shell script that evals the value, a text for sh; man-db 2.13.1 splits the value with shell quoting into words and runs no pipe, "It may not use pipes to connect multiple commands", so elsewhere the words judged at the first, since the fourth addendum of 14 October 2026
    for (k = j; k <= NW[d]; k++) {
      w = W[d, k]; m = w; sub(/=.*/, "", m)
      if (m == "-P" || m == "--pager") { if (m != w) t = substr(w, length(m) + 2); else if (k < NW[d]) { t = W[d, k + 1]; k++ } else continue; if (MACOS) add_st(d, t); else add_chw(d, t); continue }
      if (w ~ /^-/) k += opt_width(VALS["man"], w)
    }
    return -1
  }
  if (name == "msgexec") {
    # msgexec 1.0: -h, -V and the built-in command 0 run no program, since the fourth addendum of 14 October 2026
    if (has_optv(d, j, SELF["msgexec"], VALS["msgexec"])) return -1
    j = skip_opts(d, j, VALS["msgexec"])
    if (j <= NW[d] && W[d, j] == "0") return -1
    return j
  }
  if (name in VALS) {
    # the generic one-word programs, read by their tables; SLASH reads a word such as /min or /box:x as an option, the form of a Windows program
    SLASH = (name in SLASHOPT)
    if (SELF[name] != "" && has_optv(d, j, SELF[name], VALS[name])) { SLASH = 0; return -1 }
    if (TEXTOPT[name] != "" || CHTOPT[name] != "") note_textopts(d, j, name)
    if (EXECOPT[name] != "") { k = exec_at(d, j, EXECOPT[name], VALS[name]); if (k > 0) { SLASH = 0; return (name in DDARGS) ? dd_args(d, k) : k } }
    if (PROGOPT[name] != "") prog_args(d, j, PROGOPT[name], ARGOPT[name])
    if (name in SELFALWAYS) { SLASH = 0; return -1 }
    if (name in DDONLY) { SLASH = 0; return behind_dd(d, j) }
    j = skip_opts(d, j, VALS[name])
    if (name in SKIP1) { if (j <= NW[d]) j++ }
    for (k = 0; k < SKIPN[name] && j <= NW[d]; k++) j = skip_opts(d, j + 1, VALS[name])
    SLASH = 0
    if ((name in JOIN) && !(JOINX[name] != "" && has_optv(d, i + 1, JOINX[name], VALS[name]))) { if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 }
    if ((name in HANDON) && j <= NW[d]) { add_ch(d, j, NW[d]); return -1 }
    return (name in DDARGS) ? dd_args(d, j) : j
  }
  return -1
}
# tmux [-2CDhlNuVv] [-c shell-command] [-f file] [-L socket-name] [-S socket-path] [-T features] [command [flags]]: -c a text for the shell; then tmux commands separated by ; words, each with its options; a shell-command of one word a text for sh, of several words run as they stand (new-session, new-window, split-window, respawn-pane, respawn-window, display-popup, run-shell, pipe-pane); the first word of if-shell a text for sh; the words of send-keys up to Enter, C-m or KPEnter joined a text typed into the shell of the pane
function tmux_read(d, j,   w, k, c, a, n, t, got, m) {
  got = 0
  while (j <= NW[d]) {
    w = W[d, j]
    if (w == "--") { j++; break }
    if (substr(w, 1, 1) != "-") break
    if (w == "-c" && j < NW[d]) { add_st(d, W[d, j + 1]); got = 1; j += 2; continue }
    j += opt_width(" -c -f -L -S -T ", w) + 1
  }
  while (j <= NW[d]) {
    c = W[d, j]; j++
    if (c == ";") continue
    if (c in TMUXALIAS) c = TMUXALIAS[c]
    k = j
    while (k <= NW[d] && W[d, k] != ";") { w = W[d, k]; if (w == "--") { k++; break } if (substr(w, 1, 1) != "-") break; k += opt_width(TMUXOPTS[c], w) + 1 }
    a = k
    while (k <= NW[d] && W[d, k] != ";") k++
    n = k - a
    if (index(TMUXSHELL, " " c " ") > 0 && n > 0) { if (n == 1) add_st(d, W[d, a]); else add_ch(d, a, k - 1); got = 1 }
    else if (c == "run-shell" && n > 0 && !has_tmux_flag(d, j, a, "C")) { add_st(d, W[d, a]); got = 1 }
    else if (c == "if-shell" && n > 0 && !has_tmux_flag(d, j, a, "F")) { add_st(d, W[d, a]); got = 1 }
    else if (c == "detach-client") { for (m = j; m < a; m++) if (W[d, m] == "-E" && m + 1 < a) { add_st(d, W[d, m + 1]); got = 1 } }
    # send-keys types into the pane, whose program the line does not name: not read, since the fourth addendum of 14 October 2026
    j = k
  }
  return got ? NW[d] + 1 : -1
}
# whether a flag letter stands among the option words of a tmux command, from j to a
function has_tmux_flag(d, j, a, f,   m) { for (m = j; m < a; m++) if (W[d, m] ~ /^-[A-Za-z]+$/ && index(substr(W[d, m], 2), f) > 0) return 1; return 0 }
# screen [options] [cmd [args]]: the command words run as they stand; -X sends a screen command: stuff with a text that ends a line is typed into the shell of the window, exec and ! run a command, screen the command of a new window; attaching, listing and every other form run nothing here
function screen_read(d, j,   w, k, c, xmode) {
  xmode = 0
  while (j <= NW[d]) {
    w = W[d, j]
    if (w == "--") { j++; break }
    if (substr(w, 1, 1) != "-") break
    if (w == "-X") { xmode = 1; j++; break }
    if (w == "-r" || w == "-R" || w == "-RR" || w == "-x" || w == "-ls" || w == "-list" || w == "-wipe" || w == "-v") return -1
    if (w == "-d" || w == "-D") { j++; if (j <= NW[d] && W[d, j] ~ /^[0-9]+\./) j++; continue }
    j += opt_width(" -c -e -h -p -S -s -t -T -Logfile ", w) + 1
  }
  if (!xmode) return j <= NW[d] ? j : NW[d] + 1
  if (j > NW[d]) return NW[d] + 1
  c = W[d, j]
  # stuff types into the window, whose program the line does not name: not read, since the fourth addendum of 14 October 2026
  if (c == "stuff") return -1
  if (c == "exec" || c ~ /^!/) {
    k = j + 1
    if (k <= NW[d] && W[d, k] ~ /^[.!|:]+$/) k++
    if (c ~ /^!./) add_cht(d, substr(c, 2) (k <= NW[d] ? " " joined(d, k, NW[d]) : ""))
    else if (k <= NW[d]) add_ch(d, k, NW[d])
    return NW[d] + 1
  }
  if (c == "screen") { k = skip_opts(d, j + 1, " -t -h "); if (k <= NW[d]) add_ch(d, k, NW[d]); return NW[d] + 1 }
  # backtick id lifespan autorefresh cmd args: the command run as words, again and again; printcmd cmd: a text for /bin/sh when the terminal prints
  if (c == "backtick") { if (j + 4 <= NW[d]) add_ch(d, j + 4, NW[d]); return NW[d] + 1 }
  if (c == "printcmd") { if (j < NW[d]) add_st(d, joined(d, j + 1, NW[d])); return NW[d] + 1 }
  return -1
}
# the index of the word behind a two-word wrapper at i - the program, its
# options, its second word, the options behind that - NW+1 where it leaves no
# command, -1 where the program is judged itself, -2 where no second word or
# another stands, which a program with a one-word table reads by that table
function skip_two(d, i, name,   j, sc, w, k, text, key, m) {
  if (name == "rvm") {
    # rvm [selector] do command: the command behind do
    for (k = i + 1; k <= NW[d]; k++) { w = W[d, k]; if (w == "do" || w == "exec") return k < NW[d] ? k + 1 : NW[d] + 1; if (w ~ /^-/ && w !~ /^--(verbose|summary|yaml|json)$/) return -1 }
    return -1
  }
  if (SELFPRE[name] != "" && has_optv(d, i + 1, SELFPRE[name], PRE[name])) return -1
  j = skip_opts(d, i + 1, PRE[name])
  if (j > NW[d]) return -2
  sc = W[d, j]
  if (name == "nix") {
    # nix develop: the command behind -c or --command run as it stands, a shell without it; nix shell and nix env shell: the program itself, read by the install guard as a fetch-and-run form, the command behind -c a line of its own
    if (sc == "env" && j < NW[d] && W[d, j + 1] == "shell") j++
    else if (sc != "develop" && sc != "shell") return -1
    for (k = j + 1; k <= NW[d]; k++) { w = W[d, k]; if (w == "-c" || w == "--command") { if (sc == "develop") return k < NW[d] ? k + 1 : NW[d] + 1; if (k < NW[d]) add_ch(d, k + 1, NW[d]); break } }
    return sc == "develop" ? NW[d] + 1 : -1
  }
  if (index(SUBS[name], " " sc " ") == 0) return -2
  j++
  key = name " " sc
  if (name == "mise" || name == "rtx") {
    # the tools before -- are not the command; -c takes shell text; the command stands behind -- and is run as it stands; without either a shell
    while (j <= NW[d]) {
      w = W[d, j]
      if (w == "--") return j < NW[d] ? j + 1 : NW[d] + 1
      if (w == "-c" || w == "--command") { if (j < NW[d]) add_st(d, W[d, j + 1]); j += 2; continue }
      if (w ~ /^--command=/) { sub(/^--command=/, "", w); add_st(d, w); j++; continue }
      if (w ~ /^-/) { j += opt_width(MISEOPTS, w) + 1; continue }
      j++
    }
    return NW[d] + 1
  }
  if (name == "direnv") return j <= NW[d] ? j + 1 : j
  if (name == "yarn" && sc == "workspaces") {
    # yarn workspaces foreach [options] COMMAND...: runs yarn COMMAND in each workspace; its exec read as yarn exec is
    if (j > NW[d] || W[d, j] != "foreach") return -1
    j = skip_opts(d, j + 1, " -j --jobs --since --from --include --exclude ")
    if (j > NW[d] || W[d, j] != "exec") return -1
    j++
    if (j <= NW[d] && W[d, j] ~ /[ \t;&|<>$`]/) { add_st(d, W[d, j]); return NW[d] + 1 }
    return j
  }
  if (name == "pm2" && sc == "start") {
    # pm2 7.0.4: a script word holding a blank is run with bash -c, sh -c where bash is missing, on Windows not; otherwise the word names a file or a program on PATH and the words behind -- are its arguments
    j = skip_opts(d, j, POST[key])
    if (j <= NW[d] && W[d, j] ~ / / && !WINDOWS) { add_st(d, W[d, j]); return NW[d] + 1 }
    return dd_args(d, j)
  }
  if (name == "yarn") {
    # yarn exec: berry 4.18.1 reads the first word as a script of its portable shell and appends the others as literal arguments, classic 1.22.22 runs the words; a first word holding a blank or an operator is read as that text
    if (j <= NW[d] && W[d, j] ~ /[ \t;&|<>$`]/) { add_st(d, W[d, j]); return NW[d] + 1 }
    return j
  }
  if (name == "pnpm" || name == "pn") {
    # -c or --shell-mode before exec: the words behind exec, joined, are run by a shell
    if (has_opt(d, i + 1, " -c --shell-mode ") || has_opt(d, j, " -c --shell-mode ")) { while (j <= NW[d] && (W[d, j] == "-c" || W[d, j] == "--shell-mode")) j++; text = joined(d, j, NW[d]); if (text != "") add_st(d, text); return NW[d] + 1 }
    return j
  }
  if (name == "npm") {
    # npm explore pkg [--] command: the words behind the package joined raw, a text for the script shell
    if (sc == "explore") { k = skip_opts(d, j, ""); k++; if (k <= NW[d] && W[d, k] == "--") k++; if (k <= NW[d]) add_st(d, joined(d, k, NW[d])); return -1 }
    # npm exec and npm x resolve a package and are the command itself; the text of -c or --call before or behind exec is a text for a shell
    for (k = i + 1; k <= NW[d]; k++) { w = W[d, k]; if (w == "-c" || w == "--call") { if (k < NW[d]) add_st(d, W[d, k + 1]); k++ } else if (w ~ /^--call=/) { sub(/^--call=/, "", w); add_st(d, w) } }
    return -1
  }
  if (name == "uv") {
    # uv run: the command behind the options of uv is run as it stands; with --with, -w, --with-editable or --with-requirements among them the form fetches a package first, is read by the install guard at its own name and hands the command on as a line of its own; -m runs a module
    if (has_optv(d, j, " -m --module ", POST[key])) return -1
    m = has_optv(d, j, " -w --with --with-editable --with-requirements ", POST[key])
    j = skip_opts(d, j, POST[key])
    if (m) { if (j <= NW[d]) add_ch(d, j, NW[d]); return -1 }
    return j
  }
  if (name == "machinectl") {
    # machinectl shell [[user@]name [path [args]]]: the command behind the name of the machine, on this host for .host; a container is elsewhere
    j = skip_opts(d, j, POST[key])
    if (j > NW[d]) return NW[d] + 1
    if (W[d, j] != ".host" && W[d, j] !~ /@\.host$/) return -1
    return j < NW[d] ? j + 1 : NW[d] + 1
  }
  if (name == "launchctl" && sc == "submit") {
    # launchctl submit -l label [-p executable] [-o path] [-e path] -- command [args]: -p names the program launchd runs, the words behind -- its argument vector; without -p the words behind -- are the command
    t = ""
    for (k = j; k <= NW[d] && W[d, k] != "--"; k++) { w = W[d, k]; if (w == "-p" && k < NW[d]) { t = W[d, k + 1]; k++ } else if (w ~ /^-/) k += opt_width(POST[key], w) }
    if (t == "") return behind_dd(d, j)
    m = behind_dd(d, j)
    add_cht(d, t (m < NW[d] ? " " joined(d, m + 1, NW[d]) : ""))
    return -1
  }
  if (name == "ktrace") {
    # ktrace trace [options] -c command [...]: every word behind -c is the command
    for (k = j; k <= NW[d]; k++) if (W[d, k] == "-c") { if (k < NW[d]) add_ch(d, k + 1, NW[d]); break }
    return -1
  }
  if (name == "zellij" && (sc == "action" || sc == "ac")) {
    # zellij action new-pane and new-tab: the command behind --; write-chars: a text that ends a line is typed into the shell of the pane
    w = (j <= NW[d]) ? W[d, j] : ""
    if (w == "new-pane" || w == "new-tab") return behind_dd(d, j + 1)
    # write-chars and paste type into the pane, whose program the line does not name: not read, since the fourth addendum of 14 October 2026
    if (w == "write-chars" || w == "paste") return -1
    return -1
  }
  if (name == "cargo" && sc == "env-run") return j
  if (name == "cargo" && sc == "workspaces") { if (j <= NW[d] && W[d, j] == "exec") return skip_opts(d, j + 1, " --ignore "); return -1 }
  if (name == "cargo") {
    # cargo watch: -x a cargo command and -s a shell command, each a text for the shell, the words behind -- joined one too
    for (k = j; k <= NW[d]; k++) {
      w = W[d, k]
      if (w == "--") { if (k < NW[d]) add_ch(d, k + 1, NW[d]); break }
      if (w == "-x" || w == "--exec") { if (k < NW[d]) add_st(d, "cargo " W[d, k + 1]); k++; continue }
      if (w ~ /^--exec=/) { sub(/^--exec=/, "", w); add_st(d, "cargo " w); continue }
      if (w == "-s" || w == "--shell") { if (k < NW[d]) add_st(d, W[d, k + 1]); k++; continue }
      if (w ~ /^--shell=/) { sub(/^--shell=/, "", w); add_st(d, w); continue }
      if (w ~ /^-/) k += opt_width(" -w --watch -i --ignore -d --delay -B -C --workdir --use-shell -L -E --env --env-file --features ", w)
    }
    return -1
  }
  if (key == "composer exec") {
    # composer 2.10.3: the binary and its escaped arguments make one command line the shell runs, the binary inserted as it stands
    if (has_optv(d, j, SELF2[key], POST[key])) return -1
    j = skip_opts(d, j, POST[key]); if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1
  }
  if (name == "aws-vault" && sc == "exec") {
    # kingpin reads the flags anywhere before --, behind the profile as well
    j = skip_opts(d, j, POST[key]); if (j <= NW[d]) j++; j = skip_opts(d, j, POST[key]); if (j <= NW[d] && W[d, j] == "--") j++
    return j
  }
  if (name == "sops") {
    # sops exec-env and exec-file: the file, then a text the shell runs
    j = skip_opts(d, j, POST[key])
    if (j < NW[d]) { k = skip_opts(d, j + 1, POST[key]); if (k <= NW[d]) add_st(d, W[d, k]) }
    return NW[d] + 1
  }
  if (name == "teller") { m = has_optv(d, i + 1, " -s --shell ", PRE["teller"]) || has_opt(d, j, " -s --shell "); j = behind_dd(d, j); if (m) { if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 } return j }
  if (name == "pueue" && sc == "add") { m = 0; while (j <= NW[d]) { w = W[d, j]; if (w == "--") { j++; break } if (substr(w, 1, 1) != "-") break; if (w == "-e" || w == "--escape") m = 1; if (w == "-a" || w == "--after") { for (j++; j <= NW[d] && W[d, j] !~ /^-/; j++) ; continue } j += opt_width(POST[key], w) + 1 } if (m) return j; if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 }
  # the generic two-word programs, read by their tables
  if (SELF2[key] != "" && has_optv(d, j, SELF2[key], POST[key])) return -1
  if (TEXTOPT2[key] != "" || CHTOPT2[key] != "") { for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (w == "--" || w !~ /^-/) { if (key in SELFALWAYS2) continue; break } m = w; sub(/=.*/, "", m); if (index(TEXTOPT2[key] CHTOPT2[key], " " m " ") > 0) { if (index(w, "=") > 0) { w = substr(w, index(w, "=") + 1) } else if (k < NW[d]) { w = W[d, k + 1] } else { continue } if (index(TEXTOPT2[key], " " m " ") > 0) add_st(d, w); else add_cht(d, w) } k += opt_width(POST[key], w) } }
  if (EXECOPT2[key] != "") { k = exec_at(d, j, EXECOPT2[key], POST[key]); if (k > 0) return (key in DDARGS) ? dd_args(d, k) : k }
  if (PROGOPT[key] != "") prog_args(d, j, PROGOPT[key], ARGOPT[key])
  if (key in SELFALWAYS2) return -1
  if (key in DD2) { j = behind_dd(d, j); if ((key in HANDON) && j <= NW[d]) { add_ch(d, j, NW[d]); return -1 } return j }
  j = skip_opts(d, j, POST[key])
  if (key in SKIP2) { if (j <= NW[d]) j++; if (j <= NW[d] && W[d, j] == "--") j++ }
  for (k = 0; k < SKIPN2[key] && j <= NW[d]; k++) j = skip_opts(d, j + 1, POST[key])
  if (name == "pixi") { j = skip_opts(d, j, POST[key]); if (j != NW[d]) return j; add_st(d, W[d, j]); return NW[d] + 1 }
  if (name == "hatch") while (j <= NW[d] && W[d, j] ~ /^\+/) j++
  if (key in JOIN2) { if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 }
  if (((key in HANDON) || (name == "stack" && has_optv(d, i + 2, " --package ", POST[key]))) && j <= NW[d]) { add_ch(d, j, NW[d]); return -1 }
  return (key in DDARGS) ? dd_args(d, j) : j
}
# the number of the word the command at depth d is judged by, 0 where none
function first_of(d,   i, name, j) {
  i = 1
  while (i <= NW[d]) {
    if (is_assignment(W[d, i])) { i++; continue }
    if (is_redir_op(W[d, i])) { i += 2; continue }
    name = basename(W[d, i])
    if (index(ONEWORD, " " name " ") > 0) {
      j = skip_wrapper(d, i, name)
      if (j < 0) return i
      i = j; continue
    }
    if (index(TWOWORD, " " name " ") > 0) {
      j = skip_two(d, i, name)
      if (j == -2 && (name in VALS)) j = skip_wrapper(d, i, name)
      if (j < 0) { return i }
      i = j; continue
    }
    return i
  }
  return 0
}
function is_shell(name) { return index(" sh bash zsh dash ksh mksh ash fish ", " " name " ") > 0 }
# how the shell at word f of depth d takes its commands: "c" with SCRIPT set, "stdin", or "file"
function shell_mode(d, f,   j, w, cmode, sflag) {
  j = f + 1; cmode = 0; sflag = 0
  while (j <= NW[d]) {
    w = W[d, j]
    if (is_redir_op(w)) { j += 2; continue }
    if (w == "--") { j++; break }
    if (w == "-") { sflag = 1; j++; break }
    if (w ~ /^--/) { if (w == "--rcfile" || w == "--init-file") j++; j++; continue }
    if (w ~ /^[-+]/) {
      if (w ~ /^-[^-]*c/) cmode = 1
      if (w ~ /^-[^-]*s/) sflag = 1
      if (w == "-o" || w == "+o" || w == "-O" || w == "+O") j++
      j++; continue
    }
    break
  }
  while (j <= NW[d] && is_redir_op(W[d, j])) j += 2
  if (cmode) { SCRIPT = (j <= NW[d]) ? W[d, j] : ""; return "c" }
  if (sflag || j > NW[d]) return "stdin"
  return "file"
}
function clean(w) { gsub(/\n/, " ", w); gsub(/\x1f/, " ", w); return w }
function emit(d, parent, rel, pipe,   i, line) {
  NID++
  FIRSTW[d] = first_of(d)
  line = NID US parent US rel US pipe US FIRSTW[d]
  for (i = 1; i <= NW[d]; i++) line = line US clean(W[d, i])
  OUT = OUT line "\n"
  return NID
}
# a heredoc noted while the words of a command are read; its body comes after the line
function add_heredoc(delim, strip, quoted) { HPN[D]++; HD[D, HPN[D]] = delim; HS[D, HPN[D]] = strip; HQ[D, HPN[D]] = quoted; HC[D, HPN[D]] = -1; HSH[D, HPN[D]] = 0 }
# the bodies of the pending heredocs, P standing after a newline
function flush_heredocs(   k, body, line, q, d, done, s) {
  for (k = 1; k <= HPN[D] && PERR == ""; k++) {
    if (HC[D, k] == -2) continue
    body = ""; done = 0
    while (P <= N) {
      q = index(substr(S, P), "\n")
      if (q == 0) { line = substr(S, P); P = N + 1 } else { line = substr(S, P, q - 1); P += q }
      s = line
      if (HS[D, k]) sub(/^\t+/, "", s)
      if (s == HD[D, k]) { done = 1; break }
      body = body line "\n"
    }
    HC[D, k] = HC[D, k] < 0 ? 0 : HC[D, k]
    if (HSH[D, k]) parse_text(body, HC[D, k], "shell")
    else if (!HQ[D, k]) { d = D; NTN[d] = 0; note_inside(body); flush_nt(HC[D, k]) }
    HC[D, k] = -2
  }
}
# the commands noted in the words read so far, each taken apart with its holder
function flush_nt(parent,   k, n) {
  n = NTN[D]; NTN[D] = 0
  for (k = 1; k <= n && PERR == ""; k++) parse_text(NT[D, k], parent, NTR[D, k])
}
function parse_text(text, parent, rel,   sS, sP, sN) {
  sS = S; sP = P; sN = N
  D++; S = text; P = 1; N = length(S); NTN[D] = 0; HPN[D] = 0; PARENT[D] = parent; REL[D] = rel; STN[D] = 0; CHN[D] = 0
  parse_list(" ")
  if (PERR == "" && P <= N) { skip_newlines(); if (P <= N) perr(Q peek_token() Q " without the opening it closes") }
  if (PERR == "") flush_heredocs()
  D--; S = sS; P = sP; N = sN
}
function parse_list(stop,   w, c) {
  while (PERR == "") {
    skip_newlines()
    if (P > N) return
    w = peek_token()
    if (w != "" && index(stop, " " w " ") > 0) return
    if (index(" ) } ;; ;& ;;& fi then elif else do done esac in ", " " w " ") > 0) { perr(Q w Q " without the opening it closes"); return }
    if (index(" && || | |& ; & ", " " w " ") > 0) { perr(Q w Q " with no command before it"); return }
    parse_andor()
    if (PERR != "") return
    skip_blanks()
    if (P > N) return
    c = ch()
    if (c == "\n") { P++; flush_heredocs(); continue }
    if (c == "#") continue
    if (ch3() == ";;&" || ch2() == ";;" || ch2() == ";&") { w = (ch3() == ";;&") ? ";;&" : ch2(); if (index(stop, " " w " ") > 0) return; perr(Q ";;" Q " outside a case"); return }
    if (c == ";") { P++; continue }
    if (c == "&") { P++; continue }
    w = peek_token()
    if (w != "" && index(stop, " " w " ") > 0) return
    perr(Q w Q " without the opening it closes"); return
  }
}
function parse_andor(   op, w) {
  parse_pipeline()
  while (PERR == "") {
    skip_blanks()
    if (ch2() == "&&" || ch2() == "||") {
      op = ch2(); P += 2; skip_newlines()
      if (P > N) { perr("nothing stands behind " Q op Q); return }
      w = peek_token()
      if (index(" && || | |& ; & ) } ;; ;& ;;& fi then elif else do done esac in ", " " w " ") > 0) { perr("nothing stands behind " Q op Q); return }
      parse_pipeline()
    } else return
  }
}
function parse_pipeline(   last, w) {
  skip_blanks()
  while (PERR == "") {
    w = peek_token()
    if (w == "!") { P++; skip_blanks(); continue }
    if (w == "time") { P += 4; skip_blanks(); if (substr(S, P, 2) == "-p" && delim_after(P + 2)) { P += 2; skip_blanks() } continue }
    break
  }
  last = parse_command(0)
  while (PERR == "") {
    skip_blanks()
    if (ch2() == "|&") P += 2
    else if (ch() == "|" && ch2() != "||") P++
    else return
    skip_newlines()
    if (P > N) { perr("nothing stands behind " Q "|" Q); return }
    w = peek_token()
    if (index(" && || | |& ; & ) } ;; ;& ;;& fi then elif else do done esac in ", " " w " ") > 0) { perr("nothing stands behind " Q "|" Q); return }
    last = parse_command(last)
  }
}
# the redirections behind a compound command: a line of their own with no
# judged word, read as those of a simple command are, a heredoc among them noted for
# the body after the line; the id of the last command of the body stays the one a
# pipe behind the compound reads from
function compound_end(   op, w, d, first, last) {
  d = D; NW[d] = 0; NTN[d] = 0; STN[d] = 0; CHN[d] = 0
  first = HPN[d] + 1
  while (PERR == "") {
    skip_blanks()
    op = read_redir()
    if (op == "") break
    NW[d]++; W[d, NW[d]] = op
    skip_blanks()
    if (P > N || ch() == "\n" || index(";&|()", ch()) > 0) { perr("a redirection without its target"); return LASTID }
    w = read_word(); if (PERR != "") return LASTID
    NW[d]++; W[d, NW[d]] = w
    if (op ~ /<<-?$/ && op !~ /<<<$/) { add_heredoc(w, op ~ /<<-$/, WQ) }
  }
  if (NW[d] == 0) { flush_nt(PARENT[D]); return LASTID }
  last = LASTID
  judge(d, 0, first)
  LASTID = last
  return LASTID
}
function parse_command(pipe,   w, q, name) {
  skip_blanks()
  if (P > N) { perr("a command was expected and the text ended"); return 0 }
  w = peek_token()
  if (w == "(") {
    if (ch2() == "((") { P += 2; scan_balanced("arith"); return compound_end() }
    P++; q = NID; parse_list(" ) "); if (PERR != "") return 0
    if (NID == q) { perr(Q ")" Q " with no command before it"); return 0 }
    expect_token(")"); return compound_end()
  }
  if (w == "{") { P++; q = NID; parse_list(" } "); if (PERR == "" && NID == q) { perr(Q "}" Q " with no command before it"); return 0 } expect_word("}"); return compound_end() }
  if (w == "if") {
    P += 2; parse_list(" then "); expect_word("then"); parse_list(" elif else fi ")
    while (PERR == "") {
      skip_newlines(); w = peek_token()
      if (w == "elif") { P += 4; parse_list(" then "); expect_word("then"); parse_list(" elif else fi ") }
      else if (w == "else") { P += 4; parse_list(" fi ") }
      else break
    }
    expect_word("fi"); return compound_end()
  }
  if (w == "for" || w == "select") {
    P += length(w); skip_blanks()
    if (ch2() == "((") { P += 2; scan_balanced("arith") }
    else {
      read_word(); skip_blanks()
      if (ch() == "\n") skip_newlines()
      if (peek_token() == "in") {
        P += 2
        while (PERR == "") { skip_blanks(); if (P > N || ch() == "\n" || ch() == ";") break; read_word() }
        flush_nt(PARENT[D])
      }
    }
    skip_blanks(); if (ch() == ";") P++
    expect_word("do"); parse_list(" done "); expect_word("done"); return compound_end()
  }
  if (w == "while" || w == "until") { P += length(w); parse_list(" do "); expect_word("do"); parse_list(" done "); expect_word("done"); return compound_end() }
  if (w == "case") {
    P += 4; skip_blanks(); read_word(); flush_nt(PARENT[D]); expect_word("in")
    while (PERR == "") {
      skip_newlines()
      if (peek_token() == "esac") { P += 4; break }
      if (P > N) { perr(Q "esac" Q " was expected and the text ended"); return 0 }
      if (ch() == "(") P++
      while (PERR == "") { skip_blanks(); read_word(); skip_blanks(); if (ch() == "|" && ch2() != "||") { P++; continue } break }
      flush_nt(PARENT[D])
      expect_token(")"); if (PERR != "") return 0
      parse_list(" ;; ;& ;;& esac ")
      skip_blanks()
      if (ch3() == ";;&") P += 3; else if (ch2() == ";;" || ch2() == ";&") P += 2
    }
    return compound_end()
  }
  if (w == "function") { P += 8; skip_blanks(); read_word(); skip_blanks(); if (ch2() == "()") P += 2; skip_newlines(); return parse_command(0) }
  if (w == "[[") {
    P += 2
    while (PERR == "") {
      skip_newlines()
      if (ch2() == "]]" && delim_after(P + 2)) { P += 2; break }
      if (P > N) { perr("a [[ is not closed"); return 0 }
      if (index(";&|()", ch()) > 0) { P++; continue }
      read_word()
    }
    flush_nt(PARENT[D]); return compound_end()
  }
  if (w == "coproc") {
    P += 6; skip_blanks()
    q = P; while (q <= N && substr(S, q, 1) ~ /[A-Za-z0-9_]/) q++
    if (q > P) { name = q; while (name <= N && is_blank(substr(S, name, 1))) name++; if (substr(S, name, 1) == "{" || substr(S, name, 1) == "(") P = name }
    return parse_command(pipe)
  }
  if (index(" ) } ;; ;& ;;& fi then elif else do done esac in ", " " w " ") > 0) { perr(Q w Q " without the opening it closes"); return 0 }
  return parse_simple(pipe)
}
# a simple command: its words and redirections, then every command it holds
function parse_simple(pipe,   d, w, op, first) {
  d = D; NW[d] = 0; NTN[d] = 0; STN[d] = 0; CHN[d] = 0
  first = HPN[d] + 1
  while (PERR == "") {
    skip_blanks()
    if (P > N || ch() == "\n" || ch() == "#" || (index(";&|)", ch()) > 0 && ch2() != "&>")) break
    if (ch() == "(" && NW[d] == 1 && ch2() == "()" ) {
      # name() : a function definition; the body is the command that follows
      P += 2; skip_newlines(); NW[d] = 0; NTN[d] = 0
      return parse_command(0)
    }
    if (ch() == "(") { perr("a " Q "(" Q " inside a command"); return 0 }
    if (ch2() == "&&" || ch2() == "||") break
    op = read_redir()
    if (PERR != "") return 0
    if (op != "") {
      NW[d]++; W[d, NW[d]] = op
      skip_blanks()
      if (P > N || ch() == "\n" || index(";&|()", ch()) > 0) { perr("a redirection without its target"); return 0 }
      w = read_word(); if (PERR != "") return 0
      NW[d]++; W[d, NW[d]] = w
      if (op ~ /<<-?$/ && op !~ /<<<$/) add_heredoc(w, op ~ /<<-$/, WQ)
      continue
    }
    w = read_word(); if (PERR != "") return 0
    NW[d]++; W[d, NW[d]] = w
  }
  if (NW[d] == 0) return LASTID
  return judge(d, pipe, first)
}
# the command whose words stand at depth d: its line, then every command it
# holds - the texts its wrappers hand to a shell, the commands they hand on
# as words, the words of eval, the actions of find, the forms of git, the -c
# of a shell and a shell, at or batch reading its commands from stdin; LASTID
# stays this command, the one a pipe behind a compound reads from
function judge(d, pipe, first,   id, k, i, name, mode, text, j, n, hs) {
  id = emit(d, PARENT[d], REL[d], pipe)
  for (k = first; k <= HPN[d]; k++) if (HC[d, k] == -1) HC[d, k] = id
  flush_nt(id)
  LASTID = id
  if (PERR != "") return id
  i = FIRSTW[d]
  if (STN[d] > 0) {
    n = STN[d]; STN[d] = 0
    for (k = 1; k <= n && PERR == ""; k++) parse_text(ST[d, k], id, "shell")
    LASTID = id
  }
  if (CHN[d] > 0) {
    n = CHN[d]; CHN[d] = 0
    for (k = 1; k <= n && PERR == ""; k++) { if (CHM[d, k] == "words") childwords(d, id, CHT[d, k]); else if (CHT[d, k] != "") childtext(d, id, CHT[d, k]); else child(d, id, CHA[d, k], CHB[d, k]) }
    LASTID = id
  }
  if (i == 0) return id
  name = basename(W[d, i])
  if (name == "eval") {
    text = ""
    for (j = i + 1; j <= NW[d]; j++) text = text (j > i + 1 ? " " : "") W[d, j]
    if (text != "") parse_text(text, id, "shell")
    LASTID = id
    return id
  }
  if (name == "find" || name == "bfs" || name == "ippfind") {
    for (j = i + 1; j <= NW[d] && PERR == ""; j++) {
      if (W[d, j] == "-exec" || W[d, j] == "-execdir" || W[d, j] == "-ok" || W[d, j] == "-okdir" || (name == "ippfind" && (W[d, j] == "--exec" || W[d, j] == "-x"))) {
        for (k = j + 1; k <= NW[d] && W[d, k] != ";" && !(W[d, k] == "+" && W[d, k - 1] == "{}" && (W[d, j] == "-exec" || W[d, j] == "-execdir")); k++) ;
        child(d, id, j + 1, k - 1)
        j = k
      }
    }
    LASTID = id
    return id
  }
  if (name == "git") {
    git_read(d, id)
    LASTID = id
    return id
  }
  mode = ""
  if (is_shell(name)) mode = shell_mode(d, i)
  else if (name == "at" || name == "batch" || (name in STDINCMD)) mode = "stdin"
  if (mode != "") {
    if (mode == "c") { if (SCRIPT != "") parse_text(SCRIPT, id, "shell") }
    else if (mode == "stdin") {
      for (k = first; k <= HPN[d]; k++) if (HC[d, k] == id) HSH[d, k] = 1
      hs = 0
      for (j = i + 1; j <= NW[d]; j++) if (W[d, j] == "<<<" && j < NW[d]) { hs++; HS[d, hs] = W[d, j + 1] }
      for (j = 1; j <= hs && PERR == ""; j++) parse_text(HS[d, j], id, "shell")
    }
  }
  LASTID = id
  return id
}
# a text split at blanks as a command of its own at depth d+1, relation exec of its holder
function childtext(d, parent, text,   n, parts, k) {
  n = split(text, parts, /[ \t\n]+/)
  NW[d + 1] = 0; NTN[d + 1] = 0; STN[d + 1] = 0; CHN[d + 1] = 0; HPN[d + 1] = 0
  for (k = 1; k <= n; k++) if (parts[k] != "") { NW[d + 1]++; W[d + 1, NW[d + 1]] = parts[k] }
  if (NW[d + 1] == 0) return
  PARENT[d + 1] = parent; REL[d + 1] = "exec"
  judge(d + 1, 0, 1)
}
# a text split as a shell splits words, with no shell run, as a command of its own at depth d+1, relation exec of its holder
function childwords(d, parent, text,   n, parts, k) {
  n = shwords(text, parts)
  NW[d + 1] = 0; NTN[d + 1] = 0; STN[d + 1] = 0; CHN[d + 1] = 0; HPN[d + 1] = 0
  for (k = 1; k <= n; k++) { NW[d + 1]++; W[d + 1, NW[d + 1]] = parts[k] }
  if (n < 1) return
  PARENT[d + 1] = parent; REL[d + 1] = "exec"
  judge(d + 1, 0, 1)
}
# the subcommands of git that run a command, since 13 October 2026: rebase -x and --exec, submodule foreach, the filters of filter-branch and difftool -x and --extcmd without -d hand a text to a shell, under -d one program word with two directories, not read, as rg --pre is not, since the third addendum of that day; bisect run hands its words on as a line of their own
function git_read(d, id,   c, k, w, m, gc) {
  c = 0
  for (k = FIRSTW[d] + 1; k <= NW[d]; k++) {
    w = W[d, k]
    if (w == "-C" || w == "-c" || w == "--git-dir" || w == "--work-tree" || w == "--namespace" || w == "--super-prefix" || w == "--config-env" || w == "--exec-path") { k++; continue }
    if (w ~ /^-/) continue
    c = k; break
  }
  if (c == 0) return
  gc = W[d, c]
  # an ext:: URL of git-remote-ext names a command of its own, its words split at blanks; the options of send-email, grep, the transports, archive and instaweb whose value is a command, read off git 2.56.0
  for (k = c + 1; k <= NW[d] && PERR == ""; k++) {
    w = W[d, k]
    if (w ~ /^ext::/) childtext(d, id, substr(w, 6))
    else if (w ~ /^--(sendmail-cmd|to-cmd|cc-cmd|header-cmd|upload-pack|receive-pack|exec|httpd)=/ && gc != "rebase" && gc != "test") parse_text(substr(w, index(w, "=") + 1), id, "shell")
    else if (k < NW[d] && ((gc == "send-email" && w ~ /^--(sendmail-cmd|to-cmd|cc-cmd|header-cmd)$/) || ((gc == "clone" || gc == "fetch" || gc == "pull" || gc == "ls-remote" || gc == "fetch-pack") && (w == "--upload-pack" || (gc == "clone" && w == "-u"))) || ((gc == "push" || gc == "send-pack") && (w == "--receive-pack" || w == "--exec")) || ((gc == "archive" || gc == "fetch-pack") && w == "--exec") || (gc == "instaweb" && (w == "-d" || w == "--httpd")))) { parse_text(W[d, k + 1], id, "shell"); k++ }
    else if (gc == "send-email" && w ~ /^--smtp-server=\//) childtext(d, id, substr(w, 15))
    else if (gc == "grep" && w ~ /^(-O|--open-files-in-pager=)./) { m = (w ~ /^-O/) ? substr(w, 3) : substr(w, 24); parse_text(m, id, "shell") }
  }
  if (gc == "test") { for (k = c + 1; k <= NW[d] && PERR == ""; k++) { w = W[d, k]; if ((w == "-x" || w == "--exec") && k < NW[d]) { parse_text(W[d, k + 1], id, "shell"); k++ } else if (w ~ /^--exec=/) { sub(/^--exec=/, "", w); parse_text(w, id, "shell") } } }
  if (gc == "rebase") { for (k = c + 1; k <= NW[d] && PERR == ""; k++) { w = W[d, k]; if ((w == "-x" || w == "--exec") && k < NW[d]) { parse_text(W[d, k + 1], id, "shell"); k++ } else if (w ~ /^-x./) { parse_text(substr(w, 3), id, "shell") } else if (w ~ /^--exec=/) { sub(/^--exec=/, "", w); parse_text(w, id, "shell") } } }
  else if (gc == "bisect") { if (c < NW[d] && W[d, c + 1] == "run") { k = c + 2; while (k <= NW[d] && W[d, k] ~ /^--reset-when-found/) k++; if (k <= NW[d]) child(d, id, k, NW[d]) } }
  else if (gc == "submodule") { for (k = c + 1; k <= NW[d]; k++) if (W[d, k] == "foreach") { for (m = k + 1; m <= NW[d] && W[d, m] ~ /^-/; m++) ; if (m <= NW[d]) parse_text(m < NW[d] ? joined(d, m, NW[d]) : W[d, m], id, "shell"); break } }
  else if (gc == "filter-branch") { for (k = c + 1; k <= NW[d] && PERR == ""; k++) { w = W[d, k]; if (w ~ /^--(setup|env-filter|tree-filter|index-filter|parent-filter|msg-filter|commit-filter|tag-name-filter)$/ && k < NW[d]) { parse_text(W[d, k + 1], id, "shell"); k++ } else if (w ~ /^--(setup|env-filter|tree-filter|index-filter|parent-filter|msg-filter|commit-filter|tag-name-filter)=/) { sub(/^--[a-z-]*=/, "", w); parse_text(w, id, "shell") } else if (w == "--subdirectory-filter" || w == "--original" || w == "-d" || w == "--state-branch") k++ } }
  else if (gc == "difftool") {
    # under -d or --dir-diff git v2.56.0 runs the value of -x as one program word with the two directories, use_shell 0 in run_dir_diff: not read, as rg --pre is not
    m = 0; for (k = c + 1; k <= NW[d] && W[d, k] != "--"; k++) { w = W[d, k]; if (w == "-d" || w == "--dir-diff") m = 1; else if (w == "--no-dir-diff") m = 0; else if (w ~ /^-[A-Za-z]+$/ && w ~ /^-[^xt]*d/) m = 1; else if (w == "-x" || w == "--extcmd" || w == "-t" || w == "--tool") k++ }
    if (!m) for (k = c + 1; k <= NW[d] && PERR == ""; k++) { w = W[d, k]; if ((w == "-x" || w == "--extcmd") && k < NW[d]) { parse_text(W[d, k + 1], id, "shell"); k++ } else if (w ~ /^--extcmd=/) { sub(/^--extcmd=/, "", w); parse_text(w, id, "shell") } }
  }
}
# the words from a to b of depth d as a command of their own at depth d+1, relation exec of its holder, judged as a line is
function child(d, parent, a, b,   k) {
  if (a > b) return
  NW[d + 1] = 0; NTN[d + 1] = 0; STN[d + 1] = 0; CHN[d + 1] = 0; HPN[d + 1] = 0
  for (k = a; k <= b; k++) { NW[d + 1]++; W[d + 1, NW[d + 1]] = W[d, k] }
  PARENT[d + 1] = parent; REL[d + 1] = "exec"
  judge(d + 1, 0, 1)
}

END {
  if (J == "") err("nothing on stdin: expected the JSON of a hook")
  NP = split(J, QPARTS, /"/)
  jpart(1)
  jskip()
  if (jc() != "{") err("the input is not a JSON object")
  jvalue("")
  if ("hook_event_name" in HAVE) printf "event: %s\n", clean(FIELD["hook_event_name"])
  if ("tool_name" in HAVE) printf "tool: %s\n", clean(FIELD["tool_name"])
  if ("cwd" in HAVE) printf "cwd: %s\n", clean(FIELD["cwd"])
  if ("permission_mode" in HAVE) printf "permission_mode: %s\n", clean(FIELD["permission_mode"])
  if ("session_id" in HAVE) printf "session_id: %s\n", clean(FIELD["session_id"])
  if ("tool_input.file_path" in HAVE) printf "file: %s\n", clean(FIELD["tool_input.file_path"])
  if (!("tool_input.command" in HAVE)) { print "parsed: none"; exit 0 }
  OUT = ""; NID = 0; LASTID = 0; D = 0; PERR = ""
  parse_text(FIELD["tool_input.command"], 0, "list")
  if (PERR != "") { print "parsed: no: " PERR; exit 0 }
  print "parsed: yes"
  printf "%s", OUT
  exit 0
}
