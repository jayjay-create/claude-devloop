  runc 'prlimit --nofile=1024 a; prlimit --pid 1 --nofile; numactl -m 0 b; numactl -H; setarch x86_64 -R c; linux32 d; setarch -R e; nocache -n 2 f; cpulimit -l 50 g; cpulimit -l 50 -- h; cpulimit -l 50 -e firefox; ltrace -e malloc -o out i; ltrace -p 1; heaptrack j; heaptrack --analyze f.gz; gdb -batch -ex run --args k; gdb l; lldb -o run -- m; lldb --file n; lldb -p 1; rr record -n o; rr p; rr replay; uclampset -m 10 q; winpty -- r; firejail --net=none s; firejail --list; ssh-agent -t 1h t; ssh-agent -k; lockf -t 0 /tmp/l u'
