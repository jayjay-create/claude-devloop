  expect "direnv exec, devbox run, mise exec and the nix shells: devbox run a text for a shell, mise exec and nix develop read over to the command behind -- or -c, the nix shells judged themselves with the command handed on a line of its own" 0 "1|0|list|0|4|direnv|exec|.|brew|install|a" "2|0|list|0|0|devbox|run|--|b" "3|2|shell|0|1|b" "4|0|list|0|0|devbox|run|--env|X=1|c" "5|4|shell|0|1|c" "6|0|list|0|4|mise|exec|--|go|install|d@latest" "7|0|list|0|5|mise|x|node@20|--|e" "8|0|list|0|0|mise|exec|-c|f g" "9|8|shell|0|1|f|g" "10|0|list|0|1|mise|install|h" "11|0|list|0|0|mise|exec|node@20" "12|0|list|0|4|nix|develop|-c|i" "13|0|list|0|0|nix|develop" "14|0|list|0|1|nix|shell|nixpkgs#j|-c|k" "15|14|exec|0|1|k" "16|0|list|0|1|nix|env|shell|nixpkgs#l|--command|m" "17|16|exec|0|1|m" "18|0|list|0|1|nix|run|nixpkgs#n"
  lines "direnv exec, devbox run, mise exec and the nix shells: devbox run a text for a shell, mise exec and nix develop read over to the command behind -- or -c, the nix shells judged themselves with the command handed on a line of its own" 18
  runc 'asdf exec a; rbenv exec b; pyenv exec -N c; nodenv exec d; volta run --node 20 e; fnm exec --using=18 f; fnm exec --using 18 g; pipenv run h; pipenv --python 3.12 run i; poetry run j; poetry -C x run k; pdm run -p x l; hatch run +py=3.12 m; hatch -e test run n; rye run o; conda run -n env -- p; pixi run -e dev q; bundle exec r; yarn exec s; poetry install t'
  expect "the exec and run forms of the version and environment managers, pixi run a text for its shell, another second word the program itself" 0 "1|0|list|0|3|asdf|exec|a" "2|0|list|0|3|rbenv|exec|b" "3|0|list|0|4|pyenv|exec|-N|c" "4|0|list|0|3|nodenv|exec|d" "5|0|list|0|5|volta|run|--node|20|e" "6|0|list|0|4|fnm|exec|--using=18|f" "7|0|list|0|5|fnm|exec|--using|18|g" "8|0|list|0|3|pipenv|run|h" "9|0|list|0|5|pipenv|--python|3.12|run|i" "10|0|list|0|3|poetry|run|j" "11|0|list|0|5|poetry|-C|x|run|k" "12|0|list|0|5|pdm|run|-p|x|l" "13|0|list|0|4|hatch|run|+py=3.12|m" "14|0|list|0|5|hatch|-e|test|run|n" "15|0|list|0|3|rye|run|o" "16|0|list|0|6|conda|run|-n|env|--|p" "17|0|list|0|0|pixi|run|-e|dev|q" "18|17|shell|0|1|q" "19|0|list|0|3|bundle|exec|r" "20|0|list|0|3|yarn|exec|s" "21|0|list|0|1|poetry|install|t"
  runc 'mise exec -- sh -c "brew install a"; find . -exec bash -c "b" \;'
