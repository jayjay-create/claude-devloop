  if (name == "flock") {
    # flock [options] file|directory command [arguments], or file|directory -c
    # command: -c and --command are read only as the word right after the file,
    # the one place flock.c of util-linux 2.42.4 takes them - before the file
    # they are an option it does not know, the invocation fails and nothing
    # runs; -w, --wait, --timeout, -E, --conflict-exit-code, --start and
    # --length take a value; the file alone, or a number, runs nothing
    while (j <= NW[d]) {
      w = W[d, j]
      if (is_redir_op(w)) { j += 2; continue }
      if (w == "--") { j++; break }
      if (w !~ /^-/) break
      if (w == "-c" || w == "--command" || (w ~ /^-[^-]+$/ && w ~ /c/)) return NW[d] + 1
      j += opt_width(" -w --wait --timeout -E --conflict-exit-code --start --length ", w) + 1
    }
    if (j >= NW[d]) return NW[d] + 1
    j++
    if (W[d, j] == "-c" || W[d, j] == "--command") { if (j < NW[d]) add_st(d, W[d, j + 1]); return NW[d] + 1 }
    return j
  }
  if (name == "sudo") {
