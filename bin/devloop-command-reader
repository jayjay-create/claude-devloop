# sudo-rs, super, sux, sv, syca, tsudo, voix, win-sudo, wsudox, xchpst,
# xdg-su, xfsudo, xuserrun and yas; (2) process control - aa-exec, aidbg,
# annotate-output, ansicon, aoss, apitrace trace, asciinema rec, attempt,
# austin, authbind, baeru, bench, bencher run, bkt, blackfire run, care,
# catatonit, catflap, ccache, cde, cdy, cgexec, cgproxy, checkrun.sh, chill,
# choom, cmail, cmake, cmdbench, cmdmix, cmdperf, colorless, compendium,
