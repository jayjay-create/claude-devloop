{ J = J $0 "\n" }
function err(msg) { printf "%s: %s\n", me, msg > "/dev/stderr"; exit 2 }
# The JSON is split once at every quote: QPARTS[1], QPARTS[3], ... stand
# outside strings and the parts between them inside, a part ending on an odd
# number of backslashes continuing its string through the next part. JK is the
# part being read, JP the position in it; jc() answers a quote where the part
# ends before a string.
function jc() { if (JP <= JL) return substr(QPARTS[JK], JP, 1); if (JK < NP) return "\""; return "" }
function jpart(k) { JK = k; JP = 1; JL = length(QPARTS[JK]) }
function jskip() { while (JP <= JL && index(" \t\n\r", substr(QPARTS[JK], JP, 1)) > 0) JP++ }
function odd_backslashes(str,   i, n) { n = 0; i = length(str); while (i > 0 && substr(str, i, 1) == "\\") { n++; i-- } return n % 2 }
function hex(h,   i, v, c) {
  v = 0
  if (length(h) != 4) err("a \\u escape in the JSON is not four hex digits")
  for (i = 1; i <= 4; i++) { c = index("0123456789abcdef", tolower(substr(h, i, 1))); if (c == 0) err("a \\u escape in the JSON is not four hex digits"); v = v * 16 + c - 1 }
  return v
}
function utf8(cp) {
  if (cp == 0) return ""
  if (cp < 128) return sprintf("%c", cp)
  if (cp < 2048) return sprintf("%c%c", 192 + int(cp / 64), 128 + cp % 64)
  if (cp < 65536) return sprintf("%c%c%c", 224 + int(cp / 4096), 128 + int(cp / 64) % 64, 128 + cp % 64)
  return sprintf("%c%c%c%c", 240 + int(cp / 262144), 128 + int(cp / 4096) % 64, 128 + int(cp / 64) % 64, 128 + cp % 64)
}
# the escapes of a JSON string undone; the segments between backslashes are read once each
function decode(s,   segs, n, i, out, seg, c, rest, cp, lo) {
  if (index(s, "\\") == 0) return s
  n = split(s, segs, /\\/)
  out = segs[1]; i = 2
  while (i <= n) {
    seg = segs[i]
    if (seg == "") { out = out "\\"; i++; if (i <= n) out = out segs[i]; i++; continue }
    c = substr(seg, 1, 1); rest = substr(seg, 2)
    if (c == "n") out = out "\n"; else if (c == "t") out = out "\t"; else if (c == "r") out = out "\r"
    else if (c == "b") out = out "\b"; else if (c == "f") out = out "\f"
    else if (c == "u") {
      cp = hex(substr(rest, 1, 4)); rest = substr(rest, 5)
      if (cp >= 55296 && cp <= 56319 && rest == "" && i < n && substr(segs[i + 1], 1, 1) == "u") {
        lo = hex(substr(segs[i + 1], 2, 4))
        if (lo >= 56320 && lo <= 57343) { cp = 65536 + (cp - 55296) * 1024 + (lo - 56320); i++; rest = substr(segs[i], 6) }
      }
      out = out utf8(cp)
    }
    else out = out c
    out = out rest
    i++
  }
  return out
}
# the string whose opening quote ends the part being read; decoded where build is set
function jstr(build,   k, s) {
  k = JK + 1
  if (k > NP) err("a string in the JSON is not closed")
  s = build ? QPARTS[k] : ""
  while (odd_backslashes(QPARTS[k])) { k++; if (k > NP) err("a string in the JSON is not closed"); if (build) s = s "\"" QPARTS[k] }
  if (k + 1 > NP) err("a string in the JSON is not closed")
  jpart(k + 1)
  return build ? decode(s) : ""
}
function jvalue(path,   c, k, first) {
  jskip(); c = jc()
  if (c == "{") {
    JP++; first = 1
    while (1) {
      jskip(); c = jc()
      if (c == "") err("the JSON ends inside an object")
      if (c == "}") { JP++; return }
      if (!first) { if (c != ",") err("expected , or } in the JSON object"); JP++; jskip(); c = jc() }
      first = 0
      if (c != "\"") err("expected a key in the JSON object")
      k = jstr(1); jskip()
      if (jc() != ":") err("expected : after a key"); JP++
      jvalue(path == "" ? k : path "." k)
    }
  }
  if (c == "[") {
    JP++; first = 1
    while (1) {
      jskip(); c = jc()
      if (c == "") err("the JSON ends inside an array")
      if (c == "]") { JP++; return }
      if (!first) { if (c != ",") err("expected , or ] in the JSON array"); JP++ }
      first = 0
      jvalue(path "[]")
    }
  }
  if (c == "\"") { k = jstr(path in WANT); if (path in WANT) { FIELD[path] = k; HAVE[path] = 1 } return }
  if (c == "t" && substr(QPARTS[JK], JP, 4) == "true") { JP += 4; return }
  if (c == "f" && substr(QPARTS[JK], JP, 5) == "false") { JP += 5; return }
  if (c == "n" && substr(QPARTS[JK], JP, 4) == "null") { JP += 4; return }
  if (c ~ /[-0-9]/) { while (JP <= JL && substr(QPARTS[JK], JP, 1) ~ /[-+0-9.eE]/) JP++; return }
  if (c == "") err("the JSON ends where a value was expected")
  err("unexpected character in the JSON: " c)
}

# ---------------------------------------------------------- the shell text
# S the text, P the position (from 1), N its length, D the depth of nested
# text; PERR the first thing that could not be taken apart, after which every
# loop returns.
function perr(msg) { if (PERR == "") PERR = msg }
function ch() { return substr(S, P, 1) }
function ch2() { return substr(S, P, 2) }
function ch3() { return substr(S, P, 3) }
function is_blank(c) { return c == " " || c == "\t" || c == "\r" }
function skip_blanks() { while (P <= N) { if (is_blank(ch())) P++; else if (ch2() == "\\\n") P += 2; else break } }
function skip_comment() { if (ch() == "#") while (P <= N && ch() != "\n") P++ }
# newlines, blanks and comments; a newline is where the pending heredoc bodies stand
function skip_newlines() {
  while (PERR == "") {
    skip_blanks(); skip_comment()
    if (ch() == "\n") { P++; flush_heredocs() } else break
  }
}
function delim_after(q) { return q > N || index(" \t\n\r;&|()<>", substr(S, q, 1)) > 0 }
# the operator or reserved word standing at P, "" where a plain word stands
function peek_token(   c, q, w) {
  c = ch()
  if (c == "") return ""
  if (ch3() == ";;&") return ";;&"
  if (ch2() == ";;") return ";;"
  if (ch2() == ";&") return ";&"
  if (ch2() == "&&") return "&&"
  if (ch2() == "||") return "||"
  if (ch2() == "|&") return "|&"
  if (ch2() == "&>") return ""
  if (index(";&|()", c) > 0) return c
  if (c == "{" || c == "}" || c == "!") return delim_after(P + 1) ? c : ""
  if (ch2() == "[[") return delim_after(P + 2) ? "[[" : ""
  q = P; w = ""
  while (q <= N && substr(S, q, 1) ~ /[a-z]/) { w = w substr(S, q, 1); q++ }
  if (w == "" || !delim_after(q)) return ""
  if (index(" if then elif else fi for while until do done case esac in select function time coproc ", " " w " ") > 0) return w
  return ""
}
function expect_word(w) { skip_newlines(); if (PERR != "") return; if (peek_token() == w) { P += length(w); return } if (P > N) perr(Q w Q " was expected and the text ended"); else perr(Q w Q " was expected") }
function expect_token(t) { skip_blanks(); if (PERR != "") return; if (substr(S, P, length(t)) == t) { P += length(t); return } if (P > N) perr("a " t " is not closed"); else perr(Q t Q " was expected") }

# the balanced text behind an opener, P standing after the opener; P is left after the closer
function scan_balanced(kind,   depth, c, start, inner, q) {
  start = P; depth = 1
  while (P <= N) {
    c = ch()
    if (c == "\\") { P += 2; continue }
    if (c == Q) { q = index(substr(S, P + 1), Q); if (q == 0) { perr("a single quote is not closed"); return "" } P += q + 1; continue }
    if (c == "\"") { P++; skip_dq(); if (PERR != "") return ""; continue }
    if (c == "`") { P++; skip_backtick(); if (PERR != "") return ""; continue }
    if (c == "#" && kind != "brace" && (P == start || index(" \t\n;&|(", substr(S, P - 1, 1)) > 0)) { while (P <= N && ch() != "\n") P++; continue }
    if (kind == "arith") {
      if (c == "(") depth++
      else if (c == ")") { if (depth == 1 && ch2() == "))") { inner = substr(S, start, P - start); P += 2; return inner } depth-- }
      P++; continue
    }
    if (kind == "paren") {
      if (c == "(") depth++
      else if (c == ")") { depth--; if (depth == 0) { inner = substr(S, start, P - start); P++; return inner } }
      P++; continue
    }
    if (c == "{") depth++
    else if (c == "}") { depth--; if (depth == 0) { inner = substr(S, start, P - start); P++; return inner } }
    P++
  }
  if (kind == "arith") perr("a $(( is not closed"); else if (kind == "paren") perr("a $( or ( is not closed"); else perr("a ${ is not closed")
  return ""
}
# over a double-quoted string, P standing after the opening quote, with no word built
function skip_dq(   c) {
  while (P <= N) {
    c = ch()
    if (c == "\"") { P++; return }
    if (c == "\\") { P += 2; continue }
    if (ch3() == "$((") { P += 3; scan_balanced("arith"); if (PERR != "") return; continue }
    if (ch2() == "$(") { P += 2; scan_balanced("paren"); if (PERR != "") return; continue }
    if (ch2() == "${") { P += 2; scan_balanced("brace"); if (PERR != "") return; continue }
    if (c == "`") { P++; skip_backtick(); if (PERR != "") return; continue }
    P++
  }
  perr("a double quote is not closed")
}
function skip_backtick() { while (P <= N) { if (ch() == "\\") { P += 2; continue } if (ch() == "`") { P++; return } P++ } perr("a backtick is not closed") }
# the text inside backticks, P standing after the opening one, with \` \\ and \$ undone
function read_backtick(   s, c) {
  s = ""
  while (P <= N) {
    c = ch()
    if (c == "\\") { c = substr(S, P + 1, 1); if (c == "`" || c == "\\" || c == "$") { s = s c; P += 2 } else { s = s "\\"; P++ } continue }
    if (c == "`") { P++; return s }
    s = s c; P++
  }
  perr("a backtick is not closed"); return ""
}
function add_nt(text, rel) { NTN[D]++; NT[D, NTN[D]] = text; NTR[D, NTN[D]] = rel }
# a text the command at depth d hands to a shell, noted by a wrapper; taken apart once the line is emitted
function add_st(d, text) { STN[d]++; ST[d, STN[d]] = text }
# an expansion at P: $(( )), $( ), ${ } or a backtick; the raw text is returned, a command noted
function read_expansion(   inner) {
  if (ch3() == "$((") { P += 3; inner = scan_balanced("arith"); return "$((" inner "))" }
  if (ch2() == "$(") { P += 2; inner = scan_balanced("paren"); if (PERR == "") add_nt(inner, "subst"); return "$(" inner ")" }
  if (ch2() == "${") { P += 2; inner = scan_balanced("brace"); if (PERR == "") note_inside(inner); return "${" inner "}" }
  if (ch() == "`") { P++; inner = read_backtick(); if (PERR == "") add_nt(inner, "subst"); return "`" inner "`" }
  return ""
}
# the substitutions inside a ${ } or a heredoc body, each noted as a command
function note_inside(text,   sS, sP, sN) {
  sS = S; sP = P; sN = N
  S = text; P = 1; N = length(S)
  read_dq("body")
  S = sS; P = sP; N = sN
}
# the text inside double quotes, P standing after the opening quote; mode body never ends on a quote
function read_dq(mode,   w, c, c2, q) {
  w = ""
  while (P <= N) {
    c = ch()
    if (c == "\"" && mode != "body") { P++; return w }
    if (c == "\\") {
      c2 = substr(S, P + 1, 1)
      if (c2 == "\n") { P += 2; continue }
      if (c2 == "$" || c2 == "`" || c2 == "\\" || (c2 == "\"" && mode != "body")) { w = w c2; P += 2; continue }
      w = w "\\"; P++; continue
    }
    if (c == "$" || c == "`") { c2 = read_expansion(); if (PERR != "") return w; if (c2 != "") { w = w c2; continue } }
    q = P + 1
    while (q <= N && index("\\\"$`", substr(S, q, 1)) == 0) q++
    w = w substr(S, P, q - P); P = q
  }
  if (mode != "body") perr("a double quote is not closed")
  return w
}
# $Q...Q, P standing after the opening quote, Q the single quote
function read_ansi(   w, c, c2) {
  w = ""
  while (P <= N) {
    c = ch()
    if (c == Q) { P++; return w }
    if (c == "\\") {
      c2 = substr(S, P + 1, 1); P += 2
      if (c2 == "n") w = w "\n"; else if (c2 == "t") w = w "\t"; else if (c2 == "r") w = w "\r"
      else if (c2 == "a") w = w "\a"; else if (c2 == "b") w = w "\b"; else if (c2 == "f") w = w "\f"; else if (c2 == "v") w = w "\v"
      else if (c2 == "e" || c2 == "E") w = w sprintf("%c", 27)
      else if (c2 == "x" && substr(S, P, 2) ~ /^[0-9a-fA-F][0-9a-fA-F]$/) { w = w utf8(hex(substr(S, P, 2))); P += 2 }
      else w = w c2
      continue
    }
    w = w c; P++
  }
  perr("a single quote is not closed"); return w
}
# one word at P, its quotes removed; WQ says whether any part was quoted
function read_word(   w, c, q, inner) {
  w = ""; WQ = 0
  while (P <= N) {
    c = ch()
    if ((c == "<" || c == ">") && ch2() ~ /^[<>]\(/) { P += 2; inner = scan_balanced("paren"); if (PERR != "") return w; add_nt(inner, "procsub"); w = w c "(" inner ")"; continue }
    if (is_blank(c) || index("\n;&|()<>", c) > 0) break
    if (c == "\\") { if (ch2() == "\\\n") { P += 2; continue } if (P == N) { w = w "\\"; P++; continue } w = w substr(S, P + 1, 1); P += 2; continue }
    if (c == Q) { P++; q = index(substr(S, P), Q); if (q == 0) { perr("a single quote is not closed"); return w } w = w substr(S, P, q - 1); P += q; WQ = 1; continue }
    if (c == "\"") { P++; w = w read_dq("dq"); if (PERR != "") return w; WQ = 1; continue }
    if (ch2() == "$" Q) { P += 2; w = w read_ansi(); if (PERR != "") return w; WQ = 1; continue }
    if (ch2() == "$\"") { P += 2; w = w read_dq("dq"); if (PERR != "") return w; WQ = 1; continue }
    if (c == "$" || c == "`") { inner = read_expansion(); if (PERR != "") return w; if (inner != "") { w = w inner; continue } }
    # an array assignment: name=( … ) is one word
    if (c == "(" ) break
    if (c == "=" && ch2() == "=(" && w ~ /^[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?\+?$/) { P += 2; inner = scan_balanced("paren"); if (PERR != "") return w; w = w "=(" inner ")"; continue }
    # a run of plain characters at once
    q = P + 1
    while (q <= N && index(" \t\r\n;&|()<>\\\"$`=", substr(S, q, 1)) == 0 && substr(S, q, 1) != Q) q++
    w = w substr(S, P, q - P); P = q
  }
  return w
}
function is_redir_op(w) { return w ~ /^[0-9]*(>>|>\||>&|<&|<>|<<<|<<-|<<|&>>|&>|>|<)$/ }
# a redirection at P, "" where none stands there: the operator with its descriptor
function read_redir(   q, op, c) {
  q = P
  while (q <= N && substr(S, q, 1) ~ /[0-9]/) q++
  c = substr(S, q, 1)
  if (c != "<" && c != ">" && !(q == P && substr(S, q, 2) ~ /^&>/)) return ""
  if (substr(S, q, 2) ~ /^[<>]\(/) return ""
  if (substr(S, q, 3) == "<<<") op = "<<<"
  else if (substr(S, q, 3) == "<<-") op = "<<-"
  else if (substr(S, q, 3) == "&>>") op = "&>>"
  else if (substr(S, q, 2) == "<<") op = "<<"
  else if (substr(S, q, 2) == ">>") op = ">>"
  else if (substr(S, q, 2) == ">|") op = ">|"
  else if (substr(S, q, 2) == ">&") op = ">&"
  else if (substr(S, q, 2) == "<&") op = "<&"
  else if (substr(S, q, 2) == "<>") op = "<>"
  else if (substr(S, q, 2) == "&>") op = "&>"
  else op = c
  op = substr(S, P, q - P) op
  P = q + length(op) - (q - P)
  return op
}
function basename(w,   i) { i = w; while (index(i, "/") > 0) i = substr(i, index(i, "/") + 1); return i }
function is_assignment(w) { return w ~ /^[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?\+?=/ }
# the number of values an option takes, read off a list " -x --long -L:2 ":
# one where it is listed without a count, none where it is not listed
function optn(vals, w,   p) {
  p = index(vals, " " w ":")
  if (p > 0) return int(substr(vals, p + length(w) + 2))
  return index(vals, " " w " ") > 0 ? 1 : 0
}
# the words an option at w takes behind it: its values where nothing is
# attached; in a cluster of letters the first letter that takes a value takes
# the rest of the cluster, or the next word where it is the last letter
function opt_width(vals, w,   n, k) {
  if (w ~ /^--/) return index(w, "=") == 0 ? optn(vals, w) : 0
  if (length(w) == 2 || index(vals, " " w " ") > 0 || index(vals, " " w ":") > 0) return optn(vals, w)
  if (w ~ /^-[A-Za-z]+$/) for (k = 2; k <= length(w); k++) if (optn(vals, "-" substr(w, k, 1)) > 0) return k == length(w) ? optn(vals, "-" substr(w, k, 1)) : 0
  return 0
}
# skips option words from j on, each with the values it takes
function skip_opts(d, j, vals,   w) {
  while (j <= NW[d]) {
    w = W[d, j]
    if (is_redir_op(w)) { j += 2; continue }
    if (w == "--") { DDSEEN = 1; return j + 1 }
    if (w !~ /^-/) return j
    j += opt_width(vals, w) + 1
  }
  return j
}
# whether one of the options in list stands among the option words from j on,
# an attached =value left out, a letter of a cluster counted
function has_opt(d, j, list,   w, k) {
  while (j <= NW[d]) {
    w = W[d, j]
    if (is_redir_op(w)) { j += 2; continue }
    if (w == "--" || w !~ /^-/) return 0
    sub(/=.*/, "", w)
    if (index(list, " " w " ") > 0) return 1
    if (w ~ /^-[A-Za-z]+$/ && length(w) > 2) for (k = 2; k <= length(w); k++) if (index(list, " -" substr(w, k, 1) " ") > 0) return 1
    j++
  }
  return 0
}
# a command the wrapper at depth d hands on: the words from a to b as a line of their own, or a text split at blanks
function add_ch(d, a, b) { CHN[d]++; CHA[d, CHN[d]] = a; CHB[d, CHN[d]] = b; CHT[d, CHN[d]] = "" }
function add_cht(d, text) { CHN[d]++; CHA[d, CHN[d]] = 0; CHB[d, CHN[d]] = 0; CHT[d, CHN[d]] = text }
# the words from a to b joined with one blank
function joined(d, a, b,   k, t) { t = ""; for (k = a; k <= b; k++) t = t (k > a ? " " : "") W[d, k]; return t }
# whether a text typed into a terminal ends a line: a newline or a carriage return, or the escapes \n, \r, \012, \015 and ^M the vendors read
function ends_line(w) { return w ~ /(\n|\r|\\n|\\r|\\012|\\015|\^M)$/ }
# whether every letter of a cluster of short options is a flag on the list
function flags_only(vals, w,   k) { if (w !~ /^-[A-Za-z]+$/) return 0; for (k = 2; k <= length(w); k++) if (optn(vals, "-" substr(w, k, 1)) > 0) return 0; return 1 }
# has_opt with the values of the options on vals read over, so that an option behind a valued one is seen
function has_optv(d, j, list, vals,   w, k, m) {
  while (j <= NW[d]) {
    w = W[d, j]
    if (is_redir_op(w)) { j += 2; continue }
    if (w == "--") return 0
    if (w !~ /^-/) return 0
    m = w; sub(/=.*/, "", m)
    if (index(list, " " m " ") > 0) return 1
    if (w ~ /^-[A-Za-z]+$/ && length(w) > 2) { for (k = 2; k <= length(w); k++) if (index(list, " -" substr(w, k, 1) " ") > 0) return 1 }
    j += opt_width(vals, w) + 1
  }
  return 0
}
# the index behind the first -- from j on, NW+1 where none stands
function behind_dd(d, j,   k) { for (k = j; k <= NW[d]; k++) if (W[d, k] == "--") return k + 1; return NW[d] + 1 }
# the texts an option hands to a shell (TEXTOPT) or the commands it hands on as words (CHTOPT), among the option words from j on
function note_textopts(d, j, name,   k, w, m) {
  for (k = j; k <= NW[d]; k++) {
    w = W[d, k]
    if (w == "--" || w !~ /^-/) { if (name in SELFALWAYS) continue; break }
    m = w; sub(/=.*/, "", m)
    if (index(TEXTOPT[name], " " m " ") > 0 || index(CHTOPT[name], " " m " ") > 0) {
      if (index(w, "=") > 0) { sub(/^[^=]*=/, "", w) } else if (k < NW[d]) { w = W[d, k + 1] } else continue
      if (index(TEXTOPT[name], " " m " ") > 0) add_st(d, w); else add_cht(d, w)
      k += opt_width(VALS[name], W[d, k]); continue
    }
    k += opt_width(VALS[name], w)
  }
}
# the index of the word behind the wrapper at i, NW+1 where it leaves no
# command, -1 where it is the command itself; a text it hands to a shell is
# noted with add_st, a command it hands on with add_ch or add_cht
function skip_wrapper(d, i, name,   j, w, cmode, dd, k, m, t, uflag) {
  j = i + 1; DDSEEN = 0
  if (name == "nocorrect") return j
  if (name == "runas") return -1
  if (name == "command") {
    while (j <= NW[d] && W[d, j] ~ /^-/) { if (W[d, j] ~ /^-[pvV]+$/ && W[d, j] ~ /[vV]/) return -1; if (W[d, j] == "--") { j++; break } j++ }
    return j
  }
  if (name == "doas") {
    # -C and -L run no command, -s runs a shell; -a and -u take a value
    while (j <= NW[d] && W[d, j] ~ /^-/) {
      w = W[d, j]
      if (w == "--") { j++; break }
      if (w ~ /[CL]/) return -1
      if (w ~ /s/) return NW[d] + 1
      if (w ~ /[au]$/) j++
      j++
    }
    return j
  }
  if (name == "su" || name == "runuser") {
    # the text of -c, --command and --session-command is run by the shell of the user named; the words behind the user are arguments of that shell and no command; runuser -u user [--] command runs the command as it stands
    uflag = 0
    while (j <= NW[d]) {
      w = W[d, j]
      if (w == "--") { if (uflag) return j + 1; break }
      if (w == "-") { j++; continue }
      if (w !~ /^-/) {
        if (uflag) return j
        # the user; -c among the arguments behind it reaches the shell as its own -c, so its text is shell text too
        for (k = j + 1; k < NW[d]; k++) if (W[d, k] == "-c" || W[d, k] ~ /^-[^-]*c$/) { add_st(d, W[d, k + 1]); break }
        break
      }
      if (w == "--command" || w == "--session-command") { if (j < NW[d]) add_st(d, W[d, j + 1]); j += 2; continue }
      if (w ~ /^--(session-)?command=/) { sub(/^--[a-z-]*=/, "", w); add_st(d, w); j++; continue }
      if (w ~ /^-[^-]*c$/) { if (j < NW[d]) add_st(d, W[d, j + 1]); j += 2; continue }
      if (w == "-u" || w == "--user") { uflag = 1; j += 2; continue }
      if (w ~ /^--user=/) { uflag = 1; j++; continue }
      if (w ~ /^--/) { j += opt_width(SUOPTS, w) + 1; continue }
      if (w ~ /^-[^-]*[gGsw]$/) { j += 2; continue }
      j++
    }
    return NW[d] + 1
  }
  if (name == "login") {
    # login -f user prog args runs the program as the user; without -f or a program it is a login
    if (!has_opt(d, j, " -f ")) return -1
    j = skip_opts(d, j, " -h ")
    if (j <= NW[d]) j++
    return j
  }
  if (name == "hyperfine") {
    # every word that is no option is a command, run through a shell with -S and split like one without
    while (j <= NW[d]) {
      w = W[d, j]
      if (is_redir_op(w)) { j += 2; continue }
      if (w == "--") { j++; continue }
      if (w ~ /^-/) { j += opt_width(HYPEROPTS, w) + 1; continue }
      add_st(d, w); j++
    }
    return NW[d] + 1
  }
  if (name == "script") {
    # -c and --command take shell text; otherwise the first word behind the options names the file and the command stands behind it, behind -- where one stands
    cmode = 0; dd = 0
    while (j <= NW[d]) {
      w = W[d, j]
      if (is_redir_op(w)) { j += 2; continue }
      if (w == "--") { j++; dd = 1; break }
      if (w !~ /^-/) { break }
      if (w == "-c" || w == "--command") { if (j < NW[d]) add_st(d, W[d, j + 1]); cmode = 1; j += 2; continue }
      if (w ~ /^--command=/) { sub(/^--command=/, "", w); add_st(d, w); cmode = 1; j++; continue }
      if (w ~ /^-[^-]*c$/) { if (j < NW[d]) add_st(d, W[d, j + 1]); cmode = 1; j += 2; continue }
      j += opt_width(SCRIPTOPTS, w) + 1
    }
    if (cmode) return NW[d] + 1
    if (dd) return j
    if (j <= NW[d]) j++
    if (j <= NW[d] && W[d, j] == "--") j++
    return j
  }
  if (name == "nix-shell") {
    # judged itself, since the install guard reads -p; the text of --run and --command is shell text of this line
    for (k = j; k <= NW[d]; k++) {
      w = W[d, k]
      if (w == "--run" || w == "--command") { if (k < NW[d]) add_st(d, W[d, k + 1]); k++ }
      else if (w ~ /^--(run|command)=/) { sub(/^--[a-z]*=/, "", w); add_st(d, w) }
    }
    return -1
  }
  if (name == "timeout") { j = skip_opts(d, j, " -s --signal -k --kill-after "); if (j <= NW[d]) j++; return j }
  if (name == "chrt") { if (has_opt(d, j, " -p --pid -m --max -h --help -V --version ")) return -1; j = skip_opts(d, j, " -T --sched-runtime -P --sched-period -D --sched-deadline -U -X "); if (j <= NW[d] && W[d, j] ~ /^[0-9]+$/) j++; return j }
  if (name == "taskset") { if (has_opt(d, j, " -p --pid -h --help -V --version ")) return -1; j = skip_opts(d, j, ""); if (j <= NW[d]) j++; return j }
  if (name == "watch") {
    # the command words joined are given to sh -c; with -x or --exec they are run as they stand
    m = has_optv(d, j, " -x --exec ", " -n --interval -q --equexit -s --shotsdir ")
    j = skip_opts(d, j, " -n --interval -q --equexit -s --shotsdir ")
    if (m) return j
    if (j <= NW[d]) add_st(d, joined(d, j, NW[d]))
    return NW[d] + 1
  }
  if (name == "flock") {
    cmode = 0
    while (j <= NW[d]) {
      w = W[d, j]
      if (w == "--") { j++; break }
      if (w !~ /^-/) break
      if (w == "-c" || w == "--command" || w ~ /^-[^-]*c/) cmode = 1
      if ((w == "-w" || w == "--timeout" || w == "-E" || w == "--conflict-exit-code") && j < NW[d]) j++
      j++
    }
    if (j > NW[d]) return j
    j++
    if (!cmode) { while (j <= NW[d] && W[d, j] ~ /^-/) { w = W[d, j]; if (w == "-c" || w == "--command" || w ~ /^-[^-]*c/) cmode = 1; j++ } }
    if (cmode) { if (j <= NW[d]) add_st(d, W[d, j]); return NW[d] + 1 }
    return j
  }
  if (name == "sudo") { j = skip_opts(d, j, " -u --user -g --group -p --prompt -C --close-from -D --chdir -h --host -r --role -t --type -T --command-timeout -U --other-user "); while (j <= NW[d] && is_assignment(W[d, j])) j++; if (j <= NW[d] && W[d, j] == "--") j++; return j }
  if (name == "env") { j = skip_opts(d, j, " -u --unset -C --chdir -S --split-string "); while (j <= NW[d] && is_assignment(W[d, j])) j++; if (j <= NW[d] && W[d, j] == "--") j++; return j }
  if (name == "cross-env" || name == "cross-env-shell") {
    # the assignments, then the command as it stands; cross-env-shell joins its words into a text for a shell
    while (j <= NW[d] && is_assignment(W[d, j])) j++
    if (name == "cross-env-shell") { if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 }
    return j
  }
  if (name == "env-cmd") {
    # the command as it stands, or joined into a text for a shell with --use-shell
    m = has_optv(d, j, " --use-shell ", VALS["env-cmd"])
    j = skip_opts(d, j, VALS["env-cmd"])
    if (m) { if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 }
    return j
  }
  if (name == "dotenv") {
    # three programs of one name: python-dotenv with run behind its options, the ruby one and dotenv-cli with the command behind theirs, -- in between where one stands
    if (has_optv(d, j, SELF["dotenv"], VALS["dotenv"])) return -1
    j = skip_opts(d, j, VALS["dotenv"])
    if (j <= NW[d] && W[d, j] == "run") { j++; j = skip_opts(d, j, "") }
    return j
  }
  if (name == "trap") {
    while (j <= NW[d] && W[d, j] ~ /^-/ && W[d, j] != "-") { if (W[d, j] == "--") { j++; break } if (W[d, j] ~ /^-[lpP]+$/) return -1; j++ }
    if (j <= NW[d] && W[d, j] != "-" && W[d, j] != "") add_st(d, W[d, j])
    return NW[d] + 1
  }
  if (name == "setarch" || name == "linux32" || name == "linux64") {
    # setarch [arch] [options] [program]: a known architecture may stand first, then the options, then the program
    if (name == "setarch" && j <= NW[d] && W[d, j] !~ /^-/ && W[d, j] ~ /^(linux32|linux64|i[3-6]86|x86_64|x86-64|amd64|ppc|ppc64|ppcle|ppc64le|s390|s390x|sparc|sparc64|sparc32bash|arm|armv[0-9a-z]*|aarch64|mips|mips64|mipsel|mips64el|ia64|alpha|sh|sh64|hppa|hppa64|parisc|parisc64|loongarch|loongarch64|riscv|riscv64|m68k)$/) j++
    if (has_optv(d, j, " -p --pid --show ", " -p --pid ")) return -1
    return skip_opts(d, j, " -p --pid ")
  }
  if (name == "entr") {
    # -s: the first argument is a text for the shell; otherwise the utility and its arguments as they stand
    m = has_opt(d, j, " -s ")
    j = skip_opts(d, j, "")
    if (m) { if (j <= NW[d]) add_st(d, W[d, j]); return NW[d] + 1 }
    return j
  }
  if (name == "watchexec") {
    # the command words joined are a text for the shell; with -n, --shell=none or --shell none they are run as they stand
    m = 0
    for (k = j; k <= NW[d]; k++) {
      w = W[d, k]
      if (w == "--" || w !~ /^-/) break
      if (w == "--shell=none" || w == "--no-shell" || (w == "--shell" && k < NW[d] && W[d, k + 1] == "none")) m = 1
      if (w == "-n" || (flags_only(VALS["watchexec"], w) && w ~ /n/)) m = 1
      k += opt_width(VALS["watchexec"], w)
    }
    j = skip_opts(d, j, VALS["watchexec"])
    if (m) return j
    if (j <= NW[d]) add_st(d, joined(d, j, NW[d]))
    return NW[d] + 1
  }
  if (name == "when-changed") {
    # when-changed [-vr1s] FILE COMMAND..., or FILE... -c COMMAND...; one word is a text for the shell, several the command as they stand (subprocess with shell where the list has one item)
    j = skip_opts(d, j, "")
    m = 0
    for (k = j; k <= NW[d]; k++) if (W[d, k] == "-c") { m = k; break }
    if (m) j = m + 1; else j++
    if (j > NW[d]) return NW[d] + 1
    if (j == NW[d]) { add_st(d, W[d, j]); return NW[d] + 1 }
    return j
  }
  if (name == "apply") {
    # apply [-a c] [-d] [-#] command argument ...: the command is a text the shell runs once per argument
    j = skip_opts(d, j, " -a ")
    if (j <= NW[d]) add_st(d, W[d, j])
    return NW[d] + 1
  }
  if (name == "sg") {
    # sg [-] group [[-c] command]: the command is a text for /bin/sh
    if (j <= NW[d] && W[d, j] == "-") j++
    j++
    if (j <= NW[d] && W[d, j] == "-c") j++
    if (j <= NW[d]) add_st(d, W[d, j])
    return NW[d] + 1
  }
  if (name == "pee" || name == "mispipe") {
    # every argument is a text the shell runs (popen and system)
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (w ~ /^--/) continue; add_st(d, w) }
    return NW[d] + 1
  }
  if (name == "sc_usage") {
    # -E: the executable with its arguments behind it; a pid or a name otherwise
    for (k = j; k <= NW[d]; k++) if (W[d, k] == "-E") return k + 1
    return -1
  }
  if (name == "leaks") {
    # leaks [options] -atExit -- command launches the command; every other form names a process or a file
    if (!has_opt(d, j, " -atExit ")) return -1
    for (k = j; k <= NW[d]; k++) if (W[d, k] == "--") return k + 1
    return -1
  }
  if (name == "gdb") { for (k = j; k <= NW[d]; k++) if (W[d, k] == "--args") return k + 1; return -1 }
  if (name == "lldb") {
    # the executable is the value of -f or --file, else the first word that is no option, or the word behind --; an attach runs no program
    if (has_optv(d, j, SELF["lldb"], VALS["lldb"])) return -1
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (w == "--") break; if (substr(w, 1, 1) != "-") break; if ((w == "-f" || w == "--file") && k < NW[d]) return k + 1; if (w ~ /^--file=/) { add_cht(d, substr(w, 8)); return NW[d] + 1 } k += opt_width(VALS["lldb"], w) }
    return skip_opts(d, j, VALS["lldb"])
  }
  if (name == "rr") {
    # rr [record] [options] exe args: record is the one subcommand that runs a program, and it may be left out; the others replay or read a trace
    j = skip_opts(d, j, VALS["rr"])
    if (j <= NW[d] && W[d, j] == "record") return skip_opts(d, j + 1, VALS["rr"])
    if (j <= NW[d] && index(" replay ps dump rerun traceinfo pack cpufeatures buildid sources explicit-sources mv help ", " " W[d, j] " ") > 0) return -1
    return j
  }
  if (name == "parallel") {
    # GNU parallel and moreutils parallel: the command words up to ::: :::: :::+ ::::+ joined are a text the shell runs, the words behind the separator its arguments; with no command words, or behind a -- directly after the options, every argument is a text of its own
    j = skip_opts(d, j, VALS["parallel"])
    if (DDSEEN) { for (k = j; k <= NW[d]; k++) add_st(d, W[d, k]); return NW[d] + 1 }
    m = 0
    for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (w == ":::" || w == "::::" || w == ":::+" || w == "::::+") break; if (m == 0) m = k }
    if (m > 0) { add_st(d, joined(d, m, k - 1)); return NW[d] + 1 }
    if (k <= NW[d]) { t = W[d, k]; for (k = k + 1; k <= NW[d]; k++) { w = W[d, k]; if (w == ":::" || w == "::::" || w == ":::+" || w == "::::+") { t = w; continue } if (t == "::::" || t == "::::+") continue; add_st(d, w) } }
    return NW[d] + 1
  }
  if (name == "fd") {
    # fd itself is the command; the command behind each -x, --exec, -X and --exec-batch up to a ; or the end is a line of its own
    for (k = j; k <= NW[d]; k++) {
      w = W[d, k]
      if (w == "-x" || w == "--exec" || w == "-X" || w == "--exec-batch") { for (m = k + 1; m <= NW[d] && W[d, m] != ";"; m++) ; if (m > k + 1) add_ch(d, k + 1, m - 1); k = m; continue }
      if (w ~ /^-/ && w != "--") k += opt_width(VALS["fd"], w)
    }
    return -1
  }
  if (name == "tmux") return tmux_read(d, j)
  if (name == "screen") return screen_read(d, j)
  if (name == "dtach") {
    # dtach -A|-c|-n|-N socket [-e char] [-r method] [-z] command...; -a and -p attach and run none
    w = (j <= NW[d]) ? W[d, j] : ""
    if (w == "-A" || w == "-c" || w == "-n" || w == "-N") return skip_opts(d, j + 2, " -e -r ")
    return -1
  }
  if (name == "abduco") {
    # abduco [-e key] [-r] [-f] [-l] -c|-n|-A name command...; -a attaches
    m = 0
    while (j <= NW[d] && W[d, j] ~ /^-/) { w = W[d, j]; if (w == "-a") return -1; if (w == "-c" || w == "-n" || w == "-A") { m = 1; j += 2; continue } j += opt_width(" -e ", w) + 1 }
    return m ? j : -1
  }
  if (name == "wgo") {
    # wgo [flags] command [args] [:: command [args]]...: every command a line of its own; wgo run [flags] package is a go run
    j = skip_opts(d, j, VALS["wgo"])
    m = j
    for (k = j; k <= NW[d] + 1; k++) if (k > NW[d] || W[d, k] == "::") { if (k > m) { if (W[d, m] == "run") add_cht(d, "go " joined(d, m, k - 1)); else add_ch(d, m, k - 1) } m = k + 1 }
    return NW[d] + 1
  }
  if (name == "gow") {
    # gow [flags] subcommand [args]: runs go, or the executable -g names, with the words behind the flags
    t = "go"
    for (k = j; k <= NW[d] && W[d, k] ~ /^-/; k++) { w = W[d, k]; if (w ~ /^-g=/) t = substr(w, 4); else if (w == "-g" && k < NW[d]) { t = W[d, k + 1]; k++ } else if (w == "-e" || w == "-i" || w == "-w") k++ }
    if (k <= NW[d]) add_cht(d, t " " joined(d, k, NW[d]))
    return NW[d] + 1
  }
  if (name == "kinit") {
    # kinit [options] [principal [command]]: the command behind the principal
    j = skip_opts(d, j, VALS["kinit"])
    if (j <= NW[d]) j++
    return j
  }
  if (name == "gsudo" && j <= NW[d] && index(" config status cache !! ", " " W[d, j] " ") > 0) return -1
  if (name in VALS) {
    # the generic one-word programs, read by their tables
    if (SELF[name] != "" && has_optv(d, j, SELF[name], VALS[name])) return -1
    if (TEXTOPT[name] != "" || CHTOPT[name] != "") note_textopts(d, j, name)
    if (name in SELFALWAYS) return -1
    if (name in DDONLY) return behind_dd(d, j)
    j = skip_opts(d, j, VALS[name])
    if (name in SKIP1) { if (j <= NW[d]) j++ }
    if (name in JOIN) { if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 }
    return j
  }
  return -1
}
# tmux [-2CDhlNuVv] [-c shell-command] [-f file] [-L socket-name] [-S socket-path] [-T features] [command [flags]]: -c a text for the shell; then tmux commands separated by ; words, each with its options; a shell-command of one word a text for sh, of several words run as they stand (new-session, new-window, split-window, respawn-pane, respawn-window, display-popup, run-shell, pipe-pane); the first word of if-shell a text for sh; the words of send-keys up to Enter, C-m or KPEnter joined a text typed into the shell of the pane
function tmux_read(d, j,   w, k, c, a, n, t, got, m) {
  got = 0
  while (j <= NW[d]) {
    w = W[d, j]
    if (w == "--") { j++; break }
    if (substr(w, 1, 1) != "-") break
    if (w == "-c" && j < NW[d]) { add_st(d, W[d, j + 1]); got = 1; j += 2; continue }
    j += opt_width(" -c -f -L -S -T ", w) + 1
  }
  while (j <= NW[d]) {
    c = W[d, j]; j++
    if (c == ";") continue
    if (c in TMUXALIAS) c = TMUXALIAS[c]
    k = j
    while (k <= NW[d] && W[d, k] != ";") { w = W[d, k]; if (w == "--") { k++; break } if (substr(w, 1, 1) != "-") break; k += opt_width(TMUXOPTS[c], w) + 1 }
    a = k
    while (k <= NW[d] && W[d, k] != ";") k++
    n = k - a
    if (index(TMUXSHELL, " " c " ") > 0 && n > 0) { if (n == 1) add_st(d, W[d, a]); else add_ch(d, a, k - 1); got = 1 }
    else if (c == "if-shell" && n > 0) { add_st(d, W[d, a]); got = 1 }
    else if (c == "send-keys" && n > 0) { t = ""; for (m = a; m < k; m++) { w = W[d, m]; if (w == "Enter" || w == "C-m" || w == "KPEnter") break; t = t (t == "" ? "" : " ") w } if (m < k && t != "") { add_st(d, t); got = 1 } }
    j = k
  }
  return got ? NW[d] + 1 : -1
}
# screen [options] [cmd [args]]: the command words run as they stand; -X sends a screen command: stuff with a text that ends a line is typed into the shell of the window, exec and ! run a command, screen the command of a new window; attaching, listing and every other form run nothing here
function screen_read(d, j,   w, k, c, xmode) {
  xmode = 0
  while (j <= NW[d]) {
    w = W[d, j]
    if (w == "--") { j++; break }
    if (substr(w, 1, 1) != "-") break
    if (w == "-X") { xmode = 1; j++; break }
    if (w == "-r" || w == "-R" || w == "-RR" || w == "-x" || w == "-ls" || w == "-list" || w == "-wipe" || w == "-v") return -1
    if (w == "-d" || w == "-D") { j++; if (j <= NW[d] && W[d, j] ~ /^[0-9]+\./) j++; continue }
    j += opt_width(" -c -e -h -p -S -s -t -T -Logfile ", w) + 1
  }
  if (!xmode) return j <= NW[d] ? j : NW[d] + 1
  if (j > NW[d]) return NW[d] + 1
  c = W[d, j]
  if (c == "stuff") { if (j < NW[d] && ends_line(W[d, j + 1])) add_st(d, W[d, j + 1]); return NW[d] + 1 }
  if (c == "exec" || c ~ /^!/) {
    k = j + 1
    if (k <= NW[d] && W[d, k] ~ /^[.!|:]+$/) k++
    if (c ~ /^!./) add_cht(d, substr(c, 2) (k <= NW[d] ? " " joined(d, k, NW[d]) : ""))
    else if (k <= NW[d]) add_ch(d, k, NW[d])
    return NW[d] + 1
  }
  if (c == "screen") { k = skip_opts(d, j + 1, " -t -h "); if (k <= NW[d]) add_ch(d, k, NW[d]); return NW[d] + 1 }
  return -1
}
# the index of the word behind a two-word wrapper at i - the program, its
# options, its second word, the options behind that - NW+1 where it leaves no
# command, -1 where the second word is another or the program is judged itself
function skip_two(d, i, name,   j, sc, w, k, text, key, m) {
  if (name == "rvm") {
    # rvm [selector] do command: the command behind do
    for (k = i + 1; k <= NW[d]; k++) { w = W[d, k]; if (w == "do") return k < NW[d] ? k + 1 : NW[d] + 1; if (w ~ /^-/ && w !~ /^--(verbose|summary|yaml|json)$/) return -1 }
    return -1
  }
  j = skip_opts(d, i + 1, PRE[name])
  if (j > NW[d]) return -1
  sc = W[d, j]
  if (name == "nix") {
    # nix develop: the command behind -c or --command run as it stands, a shell without it; nix shell and nix env shell: the program itself, read by the install guard as a fetch-and-run form, the command behind -c a line of its own
    if (sc == "env" && j < NW[d] && W[d, j + 1] == "shell") j++
    else if (sc != "develop" && sc != "shell") return -1
    for (k = j + 1; k <= NW[d]; k++) { w = W[d, k]; if (w == "-c" || w == "--command") { if (sc == "develop") return k < NW[d] ? k + 1 : NW[d] + 1; if (k < NW[d]) add_ch(d, k + 1, NW[d]); break } }
    return sc == "develop" ? NW[d] + 1 : -1
  }
  if (index(SUBS[name], " " sc " ") == 0) return -1
  j++
  key = name " " sc
  if (name == "mise" || name == "rtx") {
    # the tools before -- are not the command; -c takes shell text; the command stands behind -- and is run as it stands; without either a shell
    while (j <= NW[d]) {
      w = W[d, j]
      if (w == "--") return j < NW[d] ? j + 1 : NW[d] + 1
      if (w == "-c" || w == "--command") { if (j < NW[d]) add_st(d, W[d, j + 1]); j += 2; continue }
      if (w ~ /^--command=/) { sub(/^--command=/, "", w); add_st(d, w); j++; continue }
      if (w ~ /^-/) { j += opt_width(MISEOPTS, w) + 1; continue }
      j++
    }
    return NW[d] + 1
  }
  if (name == "direnv") return j <= NW[d] ? j + 1 : j
  if (name == "pnpm" || name == "pn") {
    # -c or --shell-mode before exec: the words behind exec, joined, are run by a shell
    if (has_opt(d, i + 1, " -c --shell-mode ")) { text = joined(d, j, NW[d]); if (text != "") add_st(d, text); return NW[d] + 1 }
    return j
  }
  if (name == "npm") {
    # npm exec and npm x resolve a package and are the command itself; the text of -c or --call before or behind exec is a text for a shell
    for (k = i + 1; k <= NW[d]; k++) { w = W[d, k]; if (w == "-c" || w == "--call") { if (k < NW[d]) add_st(d, W[d, k + 1]); k++ } else if (w ~ /^--call=/) { sub(/^--call=/, "", w); add_st(d, w) } }
    return -1
  }
  if (name == "uv") {
    # uv run: the command behind the options of uv is run as it stands; with --with, -w, --with-editable or --with-requirements among them the form fetches a package first, is read by the install guard at its own name and hands the command on as a line of its own; -m runs a module
    if (has_optv(d, j, " -m --module ", POST[key])) return -1
    m = has_optv(d, j, " -w --with --with-editable --with-requirements ", POST[key])
    j = skip_opts(d, j, POST[key])
    if (m) { if (j <= NW[d]) add_ch(d, j, NW[d]); return -1 }
    return j
  }
  if (name == "machinectl") {
    # machinectl shell [[user@]name [path [args]]]: the command behind the name of the machine, on this host for .host; a container is elsewhere
    j = skip_opts(d, j, POST[key])
    if (j > NW[d]) return NW[d] + 1
    if (W[d, j] != ".host" && W[d, j] !~ /@\.host$/) return -1
    return j < NW[d] ? j + 1 : NW[d] + 1
  }
  if (name == "ktrace") {
    # ktrace trace [options] -c command [...]: the words behind -c up to the end or a long option are the command
    for (k = j; k <= NW[d]; k++) if (W[d, k] == "-c") { for (m = k + 1; m <= NW[d] && W[d, m] !~ /^--/; m++) ; if (m > k + 1) add_ch(d, k + 1, m - 1); break }
    return -1
  }
  if (name == "zellij" && sc == "action") {
    # zellij action new-pane and new-tab: the command behind --; write-chars: a text that ends a line is typed into the shell of the pane
    w = (j <= NW[d]) ? W[d, j] : ""
    if (w == "new-pane" || w == "new-tab") return behind_dd(d, j + 1)
    if (w == "write-chars") { k = skip_opts(d, j + 1, " -p --pane-id "); if (k <= NW[d] && ends_line(W[d, k])) add_st(d, W[d, k]); return NW[d] + 1 }
    return -1
  }
  if (name == "cargo") {
    # cargo watch: -x a cargo command and -s a shell command, each a text for the shell, the words behind -- joined one too
    for (k = j; k <= NW[d]; k++) {
      w = W[d, k]
      if (w == "--") { if (k < NW[d]) add_st(d, joined(d, k + 1, NW[d])); break }
      if (w == "-x" || w == "--exec") { if (k < NW[d]) add_st(d, "cargo " W[d, k + 1]); k++; continue }
      if (w ~ /^--exec=/) { sub(/^--exec=/, "", w); add_st(d, "cargo " w); continue }
      if (w == "-s" || w == "--shell") { if (k < NW[d]) add_st(d, W[d, k + 1]); k++; continue }
      if (w ~ /^--shell=/) { sub(/^--shell=/, "", w); add_st(d, w); continue }
      if (w ~ /^-/) k += opt_width(" -w --watch -i --ignore -d --delay -B -C --workdir --use-shell -L -E --env --features ", w)
    }
    return -1
  }
  if (name == "sops") {
    # sops exec-env and exec-file: the file, then a text the shell runs
    j = skip_opts(d, j, POST[key])
    if (j < NW[d]) add_st(d, W[d, j + 1])
    return NW[d] + 1
  }
  if (name == "teller") { m = has_optv(d, i + 1, " -s --shell ", PRE["teller"]) || has_opt(d, j, " -s --shell "); j = skip_opts(d, j, ""); if (m) { if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 } return j }
  # the generic two-word programs, read by their tables
  if (SELF2[key] != "" && has_optv(d, j, SELF2[key], POST[key])) return -1
  if (TEXTOPT2[key] != "") { for (k = j; k <= NW[d]; k++) { w = W[d, k]; if (w == "--" || w !~ /^-/) break; m = w; sub(/=.*/, "", m); if (index(TEXTOPT2[key], " " m " ") > 0) { if (index(w, "=") > 0) { sub(/^[^=]*=/, "", w); add_st(d, w) } else if (k < NW[d]) add_st(d, W[d, k + 1]) } k += opt_width(POST[key], w) } }
  if (key in DD2) return behind_dd(d, j)
  j = skip_opts(d, j, POST[key])
  if (key in SKIP2) { if (j <= NW[d]) j++; if (j <= NW[d] && W[d, j] == "--") j++ }
  if (name == "hatch") while (j <= NW[d] && W[d, j] ~ /^\+/) j++
  if (key in JOIN2) { if (j <= NW[d]) add_st(d, joined(d, j, NW[d])); return NW[d] + 1 }
  return j
}
# the number of the word the command at depth d is judged by, 0 where none
function first_of(d,   i, name, j) {
  i = 1
  while (i <= NW[d]) {
    if (is_assignment(W[d, i])) { i++; continue }
    if (is_redir_op(W[d, i])) { i += 2; continue }
    name = basename(W[d, i])
    if (index(ONEWORD, " " name " ") > 0) {
      j = skip_wrapper(d, i, name)
      if (j < 0) return i
      i = j; continue
    }
    if (index(TWOWORD, " " name " ") > 0) {
      j = skip_two(d, i, name)
      if (j < 0) { return i }
      i = j; continue
    }
    return i
  }
  return 0
}
function is_shell(name) { return index(" sh bash zsh dash ksh mksh ash fish ", " " name " ") > 0 }
# how the shell at word f of depth d takes its commands: "c" with SCRIPT set, "stdin", or "file"
function shell_mode(d, f,   j, w, cmode, sflag) {
  j = f + 1; cmode = 0; sflag = 0
  while (j <= NW[d]) {
    w = W[d, j]
    if (is_redir_op(w)) { j += 2; continue }
    if (w == "--") { j++; break }
    if (w == "-") { sflag = 1; j++; break }
    if (w ~ /^--/) { if (w == "--rcfile" || w == "--init-file") j++; j++; continue }
    if (w ~ /^[-+]/) {
      if (w ~ /^-[^-]*c/) cmode = 1
      if (w ~ /^-[^-]*s/) sflag = 1
      if (w == "-o" || w == "+o" || w == "-O" || w == "+O") j++
      j++; continue
    }
    break
  }
  while (j <= NW[d] && is_redir_op(W[d, j])) j += 2
  if (cmode) { SCRIPT = (j <= NW[d]) ? W[d, j] : ""; return "c" }
  if (sflag || j > NW[d]) return "stdin"
  return "file"
}
function clean(w) { gsub(/\n/, " ", w); gsub(/\x1f/, " ", w); return w }
function emit(d, parent, rel, pipe,   i, line) {
  NID++
  FIRSTW[d] = first_of(d)
  line = NID US parent US rel US pipe US FIRSTW[d]
  for (i = 1; i <= NW[d]; i++) line = line US clean(W[d, i])
  OUT = OUT line "\n"
  return NID
}
# a heredoc noted while the words of a command are read; its body comes after the line
function add_heredoc(delim, strip, quoted) { HPN[D]++; HD[D, HPN[D]] = delim; HS[D, HPN[D]] = strip; HQ[D, HPN[D]] = quoted; HC[D, HPN[D]] = -1; HSH[D, HPN[D]] = 0 }
# the bodies of the pending heredocs, P standing after a newline
function flush_heredocs(   k, body, line, q, d, done, s) {
  for (k = 1; k <= HPN[D] && PERR == ""; k++) {
    if (HC[D, k] == -2) continue
    body = ""; done = 0
    while (P <= N) {
      q = index(substr(S, P), "\n")
      if (q == 0) { line = substr(S, P); P = N + 1 } else { line = substr(S, P, q - 1); P += q }
      s = line
      if (HS[D, k]) sub(/^\t+/, "", s)
      if (s == HD[D, k]) { done = 1; break }
      body = body line "\n"
    }
    HC[D, k] = HC[D, k] < 0 ? 0 : HC[D, k]
    if (HSH[D, k]) parse_text(body, HC[D, k], "shell")
    else if (!HQ[D, k]) { d = D; NTN[d] = 0; note_inside(body); flush_nt(HC[D, k]) }
    HC[D, k] = -2
  }
}
# the commands noted in the words read so far, each taken apart with its holder
function flush_nt(parent,   k, n) {
  n = NTN[D]; NTN[D] = 0
  for (k = 1; k <= n && PERR == ""; k++) parse_text(NT[D, k], parent, NTR[D, k])
}
function parse_text(text, parent, rel,   sS, sP, sN) {
  sS = S; sP = P; sN = N
  D++; S = text; P = 1; N = length(S); NTN[D] = 0; HPN[D] = 0; PARENT[D] = parent; REL[D] = rel; STN[D] = 0; CHN[D] = 0
  parse_list(" ")
  if (PERR == "" && P <= N) { skip_newlines(); if (P <= N) perr(Q peek_token() Q " without the opening it closes") }
  if (PERR == "") flush_heredocs()
  D--; S = sS; P = sP; N = sN
}
function parse_list(stop,   w, c) {
  while (PERR == "") {
    skip_newlines()
    if (P > N) return
    w = peek_token()
    if (w != "" && index(stop, " " w " ") > 0) return
    if (index(" ) } ;; ;& ;;& fi then elif else do done esac in ", " " w " ") > 0) { perr(Q w Q " without the opening it closes"); return }
    if (index(" && || | |& ; & ", " " w " ") > 0) { perr(Q w Q " with no command before it"); return }
    parse_andor()
    if (PERR != "") return
    skip_blanks()
    if (P > N) return
    c = ch()
    if (c == "\n") { P++; flush_heredocs(); continue }
    if (c == "#") continue
    if (ch3() == ";;&" || ch2() == ";;" || ch2() == ";&") { w = (ch3() == ";;&") ? ";;&" : ch2(); if (index(stop, " " w " ") > 0) return; perr(Q ";;" Q " outside a case"); return }
    if (c == ";") { P++; continue }
    if (c == "&") { P++; continue }
    w = peek_token()
    if (w != "" && index(stop, " " w " ") > 0) return
    perr(Q w Q " without the opening it closes"); return
  }
}
function parse_andor(   op, w) {
  parse_pipeline()
  while (PERR == "") {
    skip_blanks()
    if (ch2() == "&&" || ch2() == "||") {
      op = ch2(); P += 2; skip_newlines()
      if (P > N) { perr("nothing stands behind " Q op Q); return }
      w = peek_token()
      if (index(" && || | |& ; & ) } ;; ;& ;;& fi then elif else do done esac in ", " " w " ") > 0) { perr("nothing stands behind " Q op Q); return }
      parse_pipeline()
    } else return
  }
}
function parse_pipeline(   last, w) {
  skip_blanks()
  while (PERR == "") {
    w = peek_token()
    if (w == "!") { P++; skip_blanks(); continue }
    if (w == "time") { P += 4; skip_blanks(); if (substr(S, P, 2) == "-p" && delim_after(P + 2)) { P += 2; skip_blanks() } continue }
    break
  }
  last = parse_command(0)
  while (PERR == "") {
    skip_blanks()
    if (ch2() == "|&") P += 2
    else if (ch() == "|" && ch2() != "||") P++
    else return
    skip_newlines()
    if (P > N) { perr("nothing stands behind " Q "|" Q); return }
    w = peek_token()
    if (index(" && || | |& ; & ) } ;; ;& ;;& fi then elif else do done esac in ", " " w " ") > 0) { perr("nothing stands behind " Q "|" Q); return }
    last = parse_command(last)
  }
}
# the redirections behind a compound command: a line of their own with no
# judged word, read as those of a simple command are, a heredoc among them noted for
# the body after the line; the id of the last command of the body stays the one a
# pipe behind the compound reads from
function compound_end(   op, w, d, first, last) {
  d = D; NW[d] = 0; NTN[d] = 0; STN[d] = 0; CHN[d] = 0
  first = HPN[d] + 1
  while (PERR == "") {
    skip_blanks()
    op = read_redir()
    if (op == "") break
    NW[d]++; W[d, NW[d]] = op
    skip_blanks()
    if (P > N || ch() == "\n" || index(";&|()", ch()) > 0) { perr("a redirection without its target"); return LASTID }
    w = read_word(); if (PERR != "") return LASTID
    NW[d]++; W[d, NW[d]] = w
    if (op ~ /<<-?$/ && op !~ /<<<$/) { add_heredoc(w, op ~ /<<-$/, WQ) }
  }
  if (NW[d] == 0) { flush_nt(PARENT[D]); return LASTID }
  last = LASTID
  judge(d, 0, first)
  LASTID = last
  return LASTID
}
function parse_command(pipe,   w, q, name) {
  skip_blanks()
  if (P > N) { perr("a command was expected and the text ended"); return 0 }
  w = peek_token()
  if (w == "(") {
    if (ch2() == "((") { P += 2; scan_balanced("arith"); return compound_end() }
    P++; q = NID; parse_list(" ) "); if (PERR != "") return 0
    if (NID == q) { perr(Q ")" Q " with no command before it"); return 0 }
    expect_token(")"); return compound_end()
  }
  if (w == "{") { P++; q = NID; parse_list(" } "); if (PERR == "" && NID == q) { perr(Q "}" Q " with no command before it"); return 0 } expect_word("}"); return compound_end() }
  if (w == "if") {
    P += 2; parse_list(" then "); expect_word("then"); parse_list(" elif else fi ")
    while (PERR == "") {
      skip_newlines(); w = peek_token()
      if (w == "elif") { P += 4; parse_list(" then "); expect_word("then"); parse_list(" elif else fi ") }
      else if (w == "else") { P += 4; parse_list(" fi ") }
      else break
    }
    expect_word("fi"); return compound_end()
  }
  if (w == "for" || w == "select") {
    P += length(w); skip_blanks()
    if (ch2() == "((") { P += 2; scan_balanced("arith") }
    else {
      read_word(); skip_blanks()
      if (ch() == "\n") skip_newlines()
      if (peek_token() == "in") {
        P += 2
        while (PERR == "") { skip_blanks(); if (P > N || ch() == "\n" || ch() == ";") break; read_word() }
        flush_nt(PARENT[D])
      }
    }
    skip_blanks(); if (ch() == ";") P++
    expect_word("do"); parse_list(" done "); expect_word("done"); return compound_end()
  }
  if (w == "while" || w == "until") { P += length(w); parse_list(" do "); expect_word("do"); parse_list(" done "); expect_word("done"); return compound_end() }
  if (w == "case") {
    P += 4; skip_blanks(); read_word(); flush_nt(PARENT[D]); expect_word("in")
    while (PERR == "") {
      skip_newlines()
      if (peek_token() == "esac") { P += 4; break }
      if (P > N) { perr(Q "esac" Q " was expected and the text ended"); return 0 }
      if (ch() == "(") P++
      while (PERR == "") { skip_blanks(); read_word(); skip_blanks(); if (ch() == "|" && ch2() != "||") { P++; continue } break }
      flush_nt(PARENT[D])
      expect_token(")"); if (PERR != "") return 0
      parse_list(" ;; ;& ;;& esac ")
      skip_blanks()
      if (ch3() == ";;&") P += 3; else if (ch2() == ";;" || ch2() == ";&") P += 2
    }
    return compound_end()
  }
  if (w == "function") { P += 8; skip_blanks(); read_word(); skip_blanks(); if (ch2() == "()") P += 2; skip_newlines(); return parse_command(0) }
  if (w == "[[") {
    P += 2
    while (PERR == "") {
      skip_newlines()
      if (ch2() == "]]" && delim_after(P + 2)) { P += 2; break }
      if (P > N) { perr("a [[ is not closed"); return 0 }
      if (index(";&|()", ch()) > 0) { P++; continue }
      read_word()
    }
    flush_nt(PARENT[D]); return compound_end()
  }
  if (w == "coproc") {
    P += 6; skip_blanks()
    q = P; while (q <= N && substr(S, q, 1) ~ /[A-Za-z0-9_]/) q++
    if (q > P) { name = q; while (name <= N && is_blank(substr(S, name, 1))) name++; if (substr(S, name, 1) == "{" || substr(S, name, 1) == "(") P = name }
    return parse_command(pipe)
  }
  if (index(" ) } ;; ;& ;;& fi then elif else do done esac in ", " " w " ") > 0) { perr(Q w Q " without the opening it closes"); return 0 }
  return parse_simple(pipe)
}
# a simple command: its words and redirections, then every command it holds
function parse_simple(pipe,   d, w, op, first) {
  d = D; NW[d] = 0; NTN[d] = 0; STN[d] = 0; CHN[d] = 0
  first = HPN[d] + 1
  while (PERR == "") {
    skip_blanks()
    if (P > N || ch() == "\n" || ch() == "#" || (index(";&|)", ch()) > 0 && ch2() != "&>")) break
    if (ch() == "(" && NW[d] == 1 && ch2() == "()" ) {
      # name() : a function definition; the body is the command that follows
      P += 2; skip_newlines(); NW[d] = 0; NTN[d] = 0
      return parse_command(0)
    }
    if (ch() == "(") { perr("a " Q "(" Q " inside a command"); return 0 }
    if (ch2() == "&&" || ch2() == "||") break
    op = read_redir()
    if (PERR != "") return 0
    if (op != "") {
      NW[d]++; W[d, NW[d]] = op
      skip_blanks()
      if (P > N || ch() == "\n" || index(";&|()", ch()) > 0) { perr("a redirection without its target"); return 0 }
      w = read_word(); if (PERR != "") return 0
      NW[d]++; W[d, NW[d]] = w
      if (op ~ /<<-?$/ && op !~ /<<<$/) add_heredoc(w, op ~ /<<-$/, WQ)
      continue
    }
    w = read_word(); if (PERR != "") return 0
    NW[d]++; W[d, NW[d]] = w
  }
  if (NW[d] == 0) return LASTID
  return judge(d, pipe, first)
}
# the command whose words stand at depth d: its line, then every command it
# holds - the texts its wrappers hand to a shell, the commands they hand on
# as words, the words of eval, the actions of find, the forms of git, the -c
# of a shell and a shell, at or batch reading its commands from stdin; LASTID
# stays this command, the one a pipe behind a compound reads from
function judge(d, pipe, first,   id, k, i, name, mode, text, j, n, hs) {
  id = emit(d, PARENT[d], REL[d], pipe)
  for (k = first; k <= HPN[d]; k++) if (HC[d, k] == -1) HC[d, k] = id
  flush_nt(id)
  LASTID = id
  if (PERR != "") return id
  i = FIRSTW[d]
  if (STN[d] > 0) {
    n = STN[d]; STN[d] = 0
    for (k = 1; k <= n && PERR == ""; k++) parse_text(ST[d, k], id, "shell")
    LASTID = id
  }
  if (CHN[d] > 0) {
    n = CHN[d]; CHN[d] = 0
    for (k = 1; k <= n && PERR == ""; k++) { if (CHT[d, k] != "") childtext(d, id, CHT[d, k]); else child(d, id, CHA[d, k], CHB[d, k]) }
    LASTID = id
  }
  if (i == 0) return id
  name = basename(W[d, i])
  if (name == "eval") {
    text = ""
    for (j = i + 1; j <= NW[d]; j++) text = text (j > i + 1 ? " " : "") W[d, j]
    if (text != "") parse_text(text, id, "shell")
    LASTID = id
    return id
  }
  if (name == "find") {
    for (j = i + 1; j <= NW[d] && PERR == ""; j++) {
      if (W[d, j] == "-exec" || W[d, j] == "-execdir" || W[d, j] == "-ok" || W[d, j] == "-okdir") {
        for (k = j + 1; k <= NW[d] && W[d, k] != ";" && W[d, k] != "+"; k++) ;
        child(d, id, j + 1, k - 1)
        j = k
      }
    }
    LASTID = id
    return id
  }
  if (name == "git") {
    git_read(d, id)
    LASTID = id
    return id
  }
  mode = ""
  if (is_shell(name)) mode = shell_mode(d, i)
  else if (name == "at" || name == "batch") mode = "stdin"
  if (mode != "") {
    if (mode == "c") { if (SCRIPT != "") parse_text(SCRIPT, id, "shell") }
    else if (mode == "stdin") {
      for (k = first; k <= HPN[d]; k++) if (HC[d, k] == id) HSH[d, k] = 1
      hs = 0
      for (j = i + 1; j <= NW[d]; j++) if (W[d, j] == "<<<" && j < NW[d]) { hs++; HS[d, hs] = W[d, j + 1] }
      for (j = 1; j <= hs && PERR == ""; j++) parse_text(HS[d, j], id, "shell")
    }
  }
  LASTID = id
  return id
}
# a text split at blanks as a command of its own at depth d+1, relation exec of its holder
function childtext(d, parent, text,   n, parts, k) {
  n = split(text, parts, /[ \t\n]+/)
  NW[d + 1] = 0; NTN[d + 1] = 0; STN[d + 1] = 0; CHN[d + 1] = 0; HPN[d + 1] = 0
  for (k = 1; k <= n; k++) if (parts[k] != "") { NW[d + 1]++; W[d + 1, NW[d + 1]] = parts[k] }
  if (NW[d + 1] == 0) return
  PARENT[d + 1] = parent; REL[d + 1] = "exec"
  judge(d + 1, 0, 1)
}
# the subcommands of git that run a command, since 13 October 2026: rebase -x and --exec, submodule foreach, the filters of filter-branch and difftool -x and --extcmd hand a text to a shell; bisect run hands its words on as a line of their own
function git_read(d, id,   c, k, w, m, gc) {
  c = 0
  for (k = FIRSTW[d] + 1; k <= NW[d]; k++) {
    w = W[d, k]
    if (w == "-C" || w == "-c" || w == "--git-dir" || w == "--work-tree" || w == "--namespace" || w == "--super-prefix" || w == "--config-env" || w == "--exec-path") { k++; continue }
    if (w ~ /^-/) continue
    c = k; break
  }
  if (c == 0) return
  gc = W[d, c]
  if (gc == "rebase") { for (k = c + 1; k <= NW[d] && PERR == ""; k++) { w = W[d, k]; if ((w == "-x" || w == "--exec") && k < NW[d]) { parse_text(W[d, k + 1], id, "shell"); k++ } else if (w ~ /^--exec=/) { sub(/^--exec=/, "", w); parse_text(w, id, "shell") } } }
  else if (gc == "bisect") { if (c < NW[d] && W[d, c + 1] == "run") { k = c + 2; while (k <= NW[d] && W[d, k] ~ /^--reset-when-found/) k++; if (k <= NW[d]) child(d, id, k, NW[d]) } }
  else if (gc == "submodule") { for (k = c + 1; k <= NW[d]; k++) if (W[d, k] == "foreach") { for (m = k + 1; m <= NW[d] && W[d, m] ~ /^-/; m++) ; if (m <= NW[d]) parse_text(W[d, m], id, "shell"); break } }
  else if (gc == "filter-branch") { for (k = c + 1; k <= NW[d] && PERR == ""; k++) { w = W[d, k]; if (w ~ /^--(setup|env-filter|tree-filter|index-filter|parent-filter|msg-filter|commit-filter|tag-name-filter)$/ && k < NW[d]) { parse_text(W[d, k + 1], id, "shell"); k++ } else if (w ~ /^--(setup|env-filter|tree-filter|index-filter|parent-filter|msg-filter|commit-filter|tag-name-filter)=/) { sub(/^--[a-z-]*=/, "", w); parse_text(w, id, "shell") } else if (w == "--subdirectory-filter" || w == "--original" || w == "-d" || w == "--state-branch") k++ } }
  else if (gc == "difftool") { for (k = c + 1; k <= NW[d] && PERR == ""; k++) { w = W[d, k]; if ((w == "-x" || w == "--extcmd") && k < NW[d]) { parse_text(W[d, k + 1], id, "shell"); k++ } else if (w ~ /^--extcmd=/) { sub(/^--extcmd=/, "", w); parse_text(w, id, "shell") } } }
}
# the words from a to b of depth d as a command of their own at depth d+1, relation exec of its holder, judged as a line is
function child(d, parent, a, b,   k) {
  if (a > b) return
  NW[d + 1] = 0; NTN[d + 1] = 0; STN[d + 1] = 0; CHN[d + 1] = 0; HPN[d + 1] = 0
  for (k = a; k <= b; k++) { NW[d + 1]++; W[d + 1, NW[d + 1]] = W[d, k] }
  PARENT[d + 1] = parent; REL[d + 1] = "exec"
  judge(d + 1, 0, 1)
}

END {
  if (J == "") err("nothing on stdin: expected the JSON of a hook")
  NP = split(J, QPARTS, /"/)
  jpart(1)
  jskip()
  if (jc() != "{") err("the input is not a JSON object")
  jvalue("")
  if ("hook_event_name" in HAVE) printf "event: %s\n", clean(FIELD["hook_event_name"])
  if ("tool_name" in HAVE) printf "tool: %s\n", clean(FIELD["tool_name"])
  if ("cwd" in HAVE) printf "cwd: %s\n", clean(FIELD["cwd"])
  if ("permission_mode" in HAVE) printf "permission_mode: %s\n", clean(FIELD["permission_mode"])
  if ("session_id" in HAVE) printf "session_id: %s\n", clean(FIELD["session_id"])
  if ("tool_input.file_path" in HAVE) printf "file: %s\n", clean(FIELD["tool_input.file_path"])
  if (!("tool_input.command" in HAVE)) { print "parsed: none"; exit 0 }
  OUT = ""; NID = 0; LASTID = 0; D = 0; PERR = ""
  parse_text(FIELD["tool_input.command"], 0, "list")
  if (PERR != "") { print "parsed: no: " PERR; exit 0 }
  print "parsed: yes"
  printf "%s", OUT
  exit 0
}
'
