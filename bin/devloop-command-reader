  expect "nice, nohup, stdbuf, time, command, builtin, noglob, setsid, watch with its words a text for sh, ionice" 0 "1|0|list|0|4|nice|-n|10|a" "2|0|list|0|3|nice|-10|b" "3|0|list|0|2|nohup|c" "4|0|list|0|3|stdbuf|-oL|d" "5|0|list|0|4|stdbuf|-o|L|e" "6|0|list|0|4|/usr/bin/time|-f|x|f" "7|0|list|0|2|command|g" "8|0|list|0|2|builtin|h" "9|0|list|0|2|noglob|i" "10|0|list|0|3|setsid|-w|k" "11|0|list|0|0|watch|-n|2|l" "12|11|shell|0|1|l" "13|0|list|0|4|ionice|-c|3|m"
