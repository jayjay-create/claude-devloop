#!/bin/bash
# Reads the input of a hook off stdin - the JSON Claude Code hands every hook -
# and prints its fields and, for a Bash call, the command taken apart as the
# shell runs it: one line per simple command, so that a hook judges every
# command at its first word and never matches a word of a quoted text, a
# heredoc for another program or the second command behind a newline. Every
# hook under hooks/ that reads its input reads it through this program and
# through nothing else, with the one line
#   INPUT=$("$HERE/../bin/devloop-command-reader") || exit 1
# since 12 October 2026, HERE being the hook's own directory resolved before
# any change of directory; a check in .github/workflows/stock-take.yml holds
# them to that. See docs/skill-conventions.md, "A hook reads its input
# through one program".
#
# Usage: devloop-command-reader < the hook's JSON
#        devloop-command-reader --self-test
#
# On exit 0, first the fields, one per line, each where the JSON carries it:
#   event: <hook_event_name>
#   tool: <tool_name>
#   cwd: <cwd>
#   permission_mode: <permission_mode>
#   session_id: <session_id>
#   file: <tool_input.file_path>
#   parsed: yes          the command was taken apart, and its lines follow
#   parsed: none         the JSON carries no tool_input.command
#   parsed: no: <why>    the command cannot be taken apart; no line follows,
#                        and what cannot be taken apart goes through every
#                        hook, since the shell runs nothing of such a command
#                        either - a quote or a substitution not closed, an
#                        operator with nothing behind it, an if without its fi
# then, for parsed: yes, one line per simple command, its fields separated by
# the unit separator, byte 31, so that an empty word stays a field:
#   <id> <parent> <relation> <pipe> <first> <word> <word> ...
#   id        counts from 1 in the order the commands stand in the text
#   parent    the id of the command this one stands in, 0 at the top
#   relation  how it stands there: list - the text itself or the body of an
#             if, for, while, until, case, a group, a subshell or a function;
#             subst - a $( ) or backtick substitution in a word of the parent;
#             procsub - a <( ) or >( ) in a word of the parent; shell - text
#             the parent runs as shell source: the argument of bash -c, sh -c,
#             zsh -c, dash -c, ksh -c or fish -c, of eval, of trap and of
#             flock -c, of su -c, mise exec -c, nix-shell --run and
#             --command, script -c and pnpm exec -c, every command of
#             hyperfine, and a heredoc or a here-string fed to a shell that
#             reads its commands from stdin; exec - the command find runs
#             behind -exec, -execdir, -ok or -okdir, and the command mise
#             exec, nix develop, nix shell or nix env shell hands on
#   pipe      the id of the command whose output this one reads, 0 where none
#   first     the number, from 1, of the word the command is judged by: the
#             first word behind the assignments, the redirections and the
#             wrappers that run their argument as the command, or 0 where no
#             such word stands - an assignment alone, a redirection alone
#   words     every word of the command with its quotes removed and its
#             escapes undone, as the shell hands it to the program, in order;
#             $( ), backticks, ${ } and $(( )) stand in a word as written, and
#             a $( ) or backtick is a command of its own as well; a
#             redirection stands as two words, the operator with its
#             descriptor as written - >, >>, >|, <, <>, >&, <&, &>, &>>, 2>,
#             2>&, <<, <<-, <<< - and then its target, the delimiter for a
#             heredoc; a line break inside a word is printed as a space
# The wrappers read over - every program that runs its argument or a text as
# a command on this machine, the group decided on 13 October 2026, derived by
# kinds since the second addendum of that day and not from single programs,
# the lists of the two vendors among them and not their end, each program read
# off its vendor's documentation with the options that take a value, named
# with its address in docs/roadmap.md under the entry on the command reader
# and its two addenda of 13 October 2026. The kinds, each for macOS, Linux and
# Windows with Git Bash: (1) privileges, a command as an administrator or as
# another user - sudo, doas, su, run0, pkexec, runuser, setpriv, gsudo, runas,
# login -f, machinectl shell and launchctl asuser, each of which stays the
# user's under every answer at the install guard; (2) process control, a time
# limit, a priority, an environment, a measurement, a recording - timeout,
# time, nice, nohup, stdbuf, command, builtin, noglob, nocorrect, env, exec,
# trap, ionice, chrt, taskset, uclampset, prlimit, numactl, setarch with
# linux32 and linux64, nocache, cpulimit, caffeinate, flock, lockf, lckdo,
# ifne, chronic, unbuffer, script, arch, xcrun, sandbox-exec, firejail,
# winpty, ssh-agent, kinit, strace, ltrace, valgrind, heaptrack, perf stat,
# record and trace, gdb --args, lldb, rr, hyperfine, dtrace -c, bpftrace -c,
# dtruss, dapptrace, dappprof, procsystime, sc_usage -E, leaks -atExit,
# ktrace trace -c, sg, pee and mispipe; (3) the environments of projects and
# versions - direnv exec, devbox run, mise exec and x with rtx, nix-shell,
# nix develop, nix shell and nix env shell, asdf, rbenv, pyenv, nodenv,
# goenv, jenv, plenv, phpenv and luaenv exec, volta run, fnm exec, pipenv,
# poetry, pdm, hatch, rye, conda, mamba, micromamba and pixi run, uv run,
# bundle exec, composer exec, tox exec, chruby-exec, rvm do, proto run,
# dotenvx run, dotenv, godotenv, env-cmd, cross-env and cross-env-shell,
# aws-vault exec, op run, doppler run, infisical run, sops exec-env and
# exec-file, chamber exec, envchain, teller run and railway run; (4) the
# programs that start many commands - xargs, find -exec, parallel, fd -x and
# -X, apply and msgexec; (5) terminal sessions and the background - tmux,
# screen, zellij, dtach, abduco, setsid, nohup, nq, tsp with ts, pueue add,
# daemon, daemonize, systemd-run, launchctl submit and bsexec, and at and
# batch, which read their commands from stdin as a shell does; (6) the
# programs that run a command when a file changes - entr, watchexec, nodemon
# --exec, reflex, chokidar -c, onchange, cargo watch, watchman-make,
# when-changed, wgo, gow and watch; (7) git's own subcommands that run a
# command - rebase -x and --exec, bisect run, submodule foreach, the filters
# of filter-branch and difftool -x and --extcmd; (8) the package managers
# and the tools of the languages that run a command of the shell and resolve
# no package - npm exec -c and npx -c, pnpm exec, yarn exec and bun run. A
# text one of them hands to a shell is shell text of its line, relation
# shell; a command one of them hands on as words is a line of its own,
# relation exec, as the command behind find -exec is. Every program of the
# group is read over to the command it runs, mise exec and nix develop among
# them since the second addendum of 13 October 2026: what a program of the
# group fetches on the side is not read, by the decision that a command is
# an installation only where it names one. nix-shell, nix shell and nix env
# shell are judged themselves, since the install guard reads nix-shell -p
# and the two nix shells as fetch-and-run forms, and so is uv run with
# --with, -w, --with-editable or --with-requirements; the command each hands
# on is a line of its own. command -v and command -V, xcrun --find, doas -C
# and -L, pkexec --version, chrt --pid and --max, taskset --pid, strace -p
# and every form of the table SELF look something up or act on a process and
# run no command; systemd-run with --host, --machine or --capsule, run0 with
# --machine and machinectl shell with a container's name run the command
# elsewhere; each of those is the command itself. A text typed into a
# terminal - screen -X stuff, zellij action write-chars, tmux send-keys - is
# shell text where it ends a line, with Enter, C-m or KPEnter behind it for
# tmux. Nested text is taken apart like the text itself: $( ) and
# backticks, <( ) and >( ), a subshell, a group, the bodies of if, for,
# while, until, case, select and a function, the argument of the shells
# named above with -c, of eval, of trap and of flock -c, a heredoc and a
# here-string fed to one of those shells where it reads its commands from
# stdin, or to at or batch. Text in quotes is a word of its command and no
# command: a command standing inside is read only where the shell runs it,
# in the forms above. Not taken apart, each with its reason in the head of
# docs/skill-conventions.md under the rule named above: code in another
# language - a heredoc or a here-string fed to any other program, python3 or
# cat say, the argument of python3 -c, node -e, ruby -e, perl -e, osascript
# -e, cmd /c and powershell -Command, and the command line runas hands to
# Windows - and a script file named to a shell; what a pipe carries into a
# shell, since that is the output of a program and stands in no word; the
# argument of env -S, which the vendor splits by rules of its own; the
# arguments of ssh, docker exec, chroot, nsenter, unshare, bwrap, wsl and
# every program that runs the command on another machine, in a container or
# in another root or namespace, which are not in the group; the arguments
# of nvm exec, whose optional version no rule tells from the command, of
# npx, npm exec and every fetch-and-run form without -c, which resolve a
# package rather than run a word and which the install guard reads at their
# own names, of a script of a package file - npm run, bun run of a script,
# mise run, deno task - which stands in a file and not in the command, and
# of every program this head does not name: what stands on no list goes
# through; a case inside $( ) whose pattern ends on a bare parenthesis,
# which is read as the end of the substitution; an arithmetic $(( )) and the
# number of a {varname}> redirection, which carry no command. A redirection
# behind a compound command - a group, a subshell, if, for, while, until,
# case, select, [[ ]], (( )) or a function's body - stands on a line of its
# own with no judged word, since 13 October 2026, and its heredoc is read
# after the line as a
# simple command's is.
# Exit 2 with one line on stderr: nothing on stdin, or input that is not a
# JSON object. --self-test produces every outcome above once and every form
# the text is taken apart in, prints one line per case and exits 1 on the
# first that does not come out as this head says. It needs bash and awk and
# no GNU tool: it runs under bash 3.2 with the awk of macOS and under
# ubuntu-latest alike, with LC_ALL=C so that every byte above 127 passes
# through unchanged.
set -u
me=devloop-command-reader

usage() { echo "$me: $1" >&2; exit 2; }

selftest() {
  local self T out rc n=0
  self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  T=$(mktemp -d "${TMPDIR:-/tmp}/devloop-command-reader.XXXXXX") || exit 1
  trap 'rm -rf "$T"' EXIT
  fail() { echo "FAIL $1"; printf '%s\n' "$out" | tr '\037' '|' | sed 's/^/    /'; exit 1; }
  # j CMD: the JSON of a Bash call carrying CMD, encoded as the tool encodes it
  j() { printf '%s' "$1" | awk 'BEGIN{RS="\001"} { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\n/, "\\n"); printf "{\"hook_event_name\":\"PreToolUse\",\"session_id\":\"s1\",\"cwd\":\"/p\",\"permission_mode\":\"auto\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"%s\",\"description\":\"d\"}}", $0 }'; }
  # run JSON: feeds the JSON, keeps exit code and output with the separator shown as |
  run() { printf '%s' "$1" | "$self" > "$T/out" 2>&1; rc=$?; out=$(tr '\037' '|' < "$T/out"); }
  runc() { run "$(j "$1")"; }
  # expect NAME EXIT LINE...: the last run exited EXIT and printed every line whole
  expect() {
    local name="$1" want="$2" s; shift 2; n=$((n+1))
    [ "$rc" -eq "$want" ] || fail "$name: exit $rc, expected $want"
    for s in "$@"; do printf '%s\n' "$out" | grep -qFx -- "$s" || fail "$name: no line '$s'"; done
    echo "ok   $name"
  }
  # lines NAME N: the last run printed N command lines
  lines() { local got; got=$(printf '%s\n' "$out" | grep -c '^[0-9]'); [ "$got" -eq "$2" ] || fail "$1: $got command lines, expected $2"; }
  absent() { printf '%s\n' "$out" | grep -qF -- "$1" && fail "$2: '$1' stands there and should not"; }

  # the fields and the input
  out=$("$self" bogus 2>&1); rc=$?;         expect "an argument that is not --self-test: exit 2" 2 "$me: expected no argument, or --self-test alone, got 1"
  run '';                                   expect "nothing on stdin: exit 2" 2 "$me: nothing on stdin: expected the JSON of a hook"
  run 'not json';                           expect "not a JSON object: exit 2" 2 "$me: the input is not a JSON object"
  run '{"tool_name":"Bash","tool_input":{"command":"ls"';  expect "an object not closed: exit 2" 2 "$me: the JSON ends inside an object"
  run '{"tool_name":"Bash","tool_input":{"command":"ls}}';  expect "a string not closed: exit 2" 2 "$me: a string in the JSON is not closed"
  run '{"tool_name":"Bash" "x":1}';         expect "a comma missing: exit 2" 2 "$me: expected , or } in the JSON object"
  run '{"tool_name":"Bash",1:2}';           expect "a key that is no string: exit 2" 2 "$me: expected a key in the JSON object"
  run '{"tool_name" "Bash"}';               expect "a colon missing: exit 2" 2 "$me: expected : after a key"
  run '{"a":[1,2}';                         expect "an array not closed: exit 2" 2 "$me: expected , or ] in the JSON array"
  run '{"a":@}';                            expect "a value that is none: exit 2" 2 "$me: unexpected character in the JSON: @"
  run '{"hook_event_name":"SessionStart","session_id":"abc-1","cwd":"/p","permission_mode":"default"}'
  expect "the fields of a session start, no command: parsed none" 0 "event: SessionStart" "session_id: abc-1" "cwd: /p" "permission_mode: default" "parsed: none"
  absent "tool:" "the fields of a session start, no command: parsed none"
  lines "the fields of a session start, no command: parsed none" 0
  run '{"tool_name":"Edit","tool_input":{"file_path":"/p/docs/agents/checks.md","old_string":"a","new_string":"b"},"cwd":"/p"}'
  expect "an edit: the file named, parsed none" 0 "tool: Edit" "file: /p/docs/agents/checks.md" "parsed: none"
  run '{ "tool_name" : "Bash" , "tool_input" : { "command" : "ls -la" , "timeout" : 5 , "x" : null , "y" : true , "z" : [ 1 , "two" , { "command" : "rm" } ] } , "tool_response" : { "stdout" : "\"command\": \"rm -rf /\"" } }'
  expect "the command read at its path alone, whatever else the JSON carries, blanks around the tokens" 0 "tool: Bash" "parsed: yes" "1|0|list|0|1|ls|-la"
  lines "the command read at its path alone, whatever else the JSON carries, blanks around the tokens" 1
  run '{"tool_name":"Bash","tool_input":{"command":"printf \"a\tb\\cé😀A\" > out"}}'
  expect "the JSON escapes undone: tab, backslash, a two-byte and a four-byte character, \\u0041" 0 "1|0|list|0|1|printf|a	b\\cé😀A|>|out"
  run '{"tool_name":"Bash","tool_input":{"command":"echo \"a\\\"b\" && brew install foo"}}'
  expect "a quote inside the string and a second command behind &&: both read" 0 "1|0|list|0|1|echo|a\"b" "2|0|list|0|1|brew|install|foo"
  run '{"tool_name":"Bash","tool_input":{"command":"make build\nnpm install"}}'
  expect "a newline in the JSON string: two commands" 0 "1|0|list|0|1|make|build" "2|0|list|0|1|npm|install"
  run "$(printf '{"tool_name":"Bash","tool_input":{"command":"make build\nnpm install"}}')"
  expect "a newline character in the string, which RFC 8259 forbids: read as a newline all the same" 0 "1|0|list|0|1|make|build" "2|0|list|0|1|npm|install"
  run '{"tool_name":"Bash","tool_input":{"command":""}}'
  expect "an empty command: parsed yes, no line" 0 "parsed: yes"
  lines "an empty command: parsed yes, no line" 0

  # the separators
  runc 'a && b || c; d | e |& f & g';       expect "every separator: && || ; | |& &" 0 "1|0|list|0|1|a" "2|0|list|0|1|b" "3|0|list|0|1|c" "4|0|list|0|1|d" "5|0|list|4|1|e" "6|0|list|5|1|f" "7|0|list|0|1|g"
  runc 'a
b
'
  expect "a newline between commands" 0 "1|0|list|0|1|a" "2|0|list|0|1|b"
  runc 'brew install \
ripgrep'
  expect "a backslash at the end of the line continues the command" 0 "1|0|list|0|1|brew|install|ripgrep"
  lines "a backslash at the end of the line continues the command" 1
  runc 'a #comment ; b
c'
  expect "a comment runs to the end of the line" 0 "1|0|list|0|1|a" "2|0|list|0|1|c"
  lines "a comment runs to the end of the line" 2
  runc 'echo a#b';                          expect "a # inside a word is no comment" 0 "1|0|list|0|1|echo|a#b"
  runc '! grep x f';                        expect "! before a pipeline" 0 "1|0|list|0|1|grep|x|f"
  runc 'time -p brew install x';            expect "time -p before a pipeline" 0 "1|0|list|0|1|brew|install|x"

  # the words
  runc '"brew" install ripgrep';            expect "a quoted command name is the command" 0 "1|0|list|0|1|brew|install|ripgrep"
  runc "echo 'a b' \"c d\" e\\ f";          expect "single quotes, double quotes and a backslash hold a word together" 0 "1|0|list|0|1|echo|a b|c d|e f"
  runc 'echo "x && brew install ripgrep"';  expect "a quoted text is one word and no command" 0 "1|0|list|0|1|echo|x && brew install ripgrep"
  lines "a quoted text is one word and no command" 1
  runc "git commit -m 'it''s' -m \"\"";     expect "two quoted parts of one word, and an empty word stays a field" 0 "1|0|list|0|1|git|commit|-m|its|-m|"
  runc "echo \$'a\\tb' \$\"c\"";            expect "\$'…' with its escapes undone and \$\"…\"" 0 "1|0|list|0|1|echo|a	b|c"
  runc 'echo "a\$b \" \\ \x"';              expect "in double quotes a backslash escapes \$ \" and itself and nothing else" 0 "1|0|list|0|1|echo|a\$b \" \\ \\x"
  runc 'echo \$HOME "$HOME/x" ${HOME}/y';   expect "a variable stays as written: \\\$HOME is literal, \$HOME and \${HOME} stay" 0 "1|0|list|0|1|echo|\$HOME|\$HOME/x|\${HOME}/y"
  runc 'arr=(a b) && echo ${arr[0]}';       expect "an array assignment is one word" 0 "1|0|list|0|0|arr=(a b)" "2|0|list|0|1|echo|\${arr[0]}"
  runc 'echo {a,b}';                        expect "a brace expansion is one word" 0 "1|0|list|0|1|echo|{a,b}"
  runc 'echo $((1+2)) $(( (3) ))';          expect "an arithmetic expansion stays in its word and is no command" 0 "1|0|list|0|1|echo|\$((1+2))|\$(( (3) ))"
  lines "an arithmetic expansion stays in its word and is no command" 1
  runc 'echo "a	b"';                        expect "a tab inside a word stays" 0 "1|0|list|0|1|echo|a	b"
  runc "echo 'a
b'";                                        expect "a line break inside a word is printed as a space" 0 "1|0|list|0|1|echo|a b"

  # the nested commands
  runc 'echo $(brew install x) `go install y@latest`'
  expect "\$( ) and backticks: the word as written, the command inside as subst of its holder" 0 "1|0|list|0|1|echo|\$(brew install x)|\`go install y@latest\`" "2|1|subst|0|1|brew|install|x" "3|1|subst|0|1|go|install|y@latest"
  runc 'x="$(echo $(brew install y))"'
  expect "a substitution inside double quotes inside a substitution, each a command of its holder" 0 "1|0|list|0|0|x=\$(echo \$(brew install y))" "2|1|subst|0|1|echo|\$(brew install y)" "3|2|subst|0|1|brew|install|y"
  runc 'echo ${X:-$(brew install z)} `echo \`uname\``'
  expect "a substitution inside \${ } and a backtick inside backticks" 0 "2|1|subst|0|1|brew|install|z" "3|1|subst|0|1|echo|\`uname\`" "4|3|subst|0|1|uname"
  runc 'diff <(curl -s a) >(cat)';          expect "<( ) and >( ): procsub of their holder" 0 "1|0|list|0|1|diff|<(curl -s a)|>(cat)" "2|1|procsub|0|1|curl|-s|a" "3|1|procsub|0|1|cat"
  runc '(cd x && make) ; { brew install a; }'
  expect "a subshell and a group: their commands at the top" 0 "1|0|list|0|1|cd|x" "2|0|list|0|1|make" "3|0|list|0|1|brew|install|a"
  runc 'if test -f x; then brew install a; elif [ -d y ]; then b; else c; fi'
  expect "if, elif and else: every list read" 0 "1|0|list|0|1|test|-f|x" "2|0|list|0|1|brew|install|a" "3|0|list|0|1|[|-d|y|]" "4|0|list|0|1|b" "5|0|list|0|1|c"
  runc 'for f in $(ls) a; do brew install $f; done; for ((i=0;i<3;i++)); do echo $i; done'
  expect "for with in and its substitution, and for (( ))" 0 "1|0|subst|0|1|ls" "2|0|list|0|1|brew|install|\$f" "3|0|list|0|1|echo|\$i"
  runc 'while read -r l; do echo "$l"; done < f; until false; do b; done'
  expect "while and until, the redirection behind done a line of its own" 0 "1|0|list|0|1|read|-r|l" "2|0|list|0|1|echo|\$l" "3|0|list|0|0|<|f" "4|0|list|0|1|false" "5|0|list|0|1|b"
  runc 'case x in x) brew install ripgrep;; (a|b) c;& d) e;;& *) f;; esac'
  expect "case: every list, the pattern separators ;; ;& ;;&, a pattern in parentheses" 0 "1|0|list|0|1|brew|install|ripgrep" "2|0|list|0|1|c" "3|0|list|0|1|e" "4|0|list|0|1|f"
  runc 'select o in a b; do echo $o; done'; expect "select" 0 "1|0|list|0|1|echo|\$o"
  runc 'f() { brew install a; }; function g { b; }; function h() ( c ); f'
  expect "a function in its three forms: the body read, the call a command" 0 "1|0|list|0|1|brew|install|a" "2|0|list|0|1|b" "3|0|list|0|1|c" "4|0|list|0|1|f"
  runc '[[ -n $(cat x) && a == b ]] && (( n++ ))'
  expect "[[ ]] and (( )): no command, a substitution inside read" 0 "1|0|subst|0|1|cat|x"
  lines "[[ ]] and (( )): no command, a substitution inside read" 1
  runc 'coproc { a; }; coproc c sleep 1'
  expect "coproc with a group, and coproc with a simple command, whose first word bash takes as the command" 0 "1|0|list|0|1|a" "2|0|list|0|1|c|sleep|1"
  runc 'sh -c "brew install ripgrep"';      expect "sh -c: the argument is shell text" 0 "1|0|list|0|1|sh|-c|brew install ripgrep" "2|1|shell|0|1|brew|install|ripgrep"
  runc "bash -lc 'a; b' x y";               expect "bash -lc: the flags clustered, the arguments behind the text" 0 "2|1|shell|0|1|a" "3|1|shell|0|1|b"
  runc 'zsh -o pipefail -c "a"; dash -ec b; ksh -c c; fish -c d'
  expect "zsh with -o and its value, dash, ksh and fish with -c" 0 "2|1|shell|0|1|a" "4|3|shell|0|1|b" "6|5|shell|0|1|c" "8|7|shell|0|1|d"
  runc 'bash script.sh; bash -- script.sh; bash - x'
  expect "a script file named to a shell: not read" 0 "1|0|list|0|1|bash|script.sh" "2|0|list|0|1|bash|--|script.sh" "3|0|list|0|1|bash|-|x"
  lines "a script file named to a shell: not read" 3
  runc 'eval "$X" brew install x';          expect "eval: its words joined are shell text" 0 "1|0|list|0|1|eval|\$X|brew|install|x" "2|1|shell|0|1|\$X|brew|install|x"
  runc "trap 'brew install x' EXIT; trap -- 'b' INT; trap -l; trap - TERM"
  expect "trap: the action is shell text, -l and - are none" 0 "1|0|list|0|0|trap|brew install x|EXIT" "2|1|shell|0|1|brew|install|x" "3|0|list|0|0|trap|--|b|INT" "4|3|shell|0|1|b" "5|0|list|0|1|trap|-l" "6|0|list|0|0|trap|-|TERM"
  runc "flock /tmp/l -c 'brew install x'; flock -w 5 /tmp/l brew install y"
  expect "flock -c with shell text, and flock with the command behind the file" 0 "1|0|list|0|0|flock|/tmp/l|-c|brew install x" "2|1|shell|0|1|brew|install|x" "3|0|list|0|5|flock|-w|5|/tmp/l|brew|install|y"
  runc 'find . -name x -exec brew install {} \; -execdir sudo rm {} +'
  expect "find -exec and -execdir: the command behind each, up to ; or +" 0 "1|0|list|0|1|find|.|-name|x|-exec|brew|install|{}|;|-execdir|sudo|rm|{}|+" "2|1|exec|0|1|brew|install|{}" "3|1|exec|0|2|sudo|rm|{}"
  runc "bash <<'EOF'
brew install ripgrep
EOF
echo done"
  expect "a heredoc fed to a shell: its body is shell text, read at the end of its line" 0 "1|0|list|0|1|bash|<<|EOF" "2|1|shell|0|1|brew|install|ripgrep" "3|0|list|0|1|echo|done"
  runc "sudo bash -s <<EOF
brew install a
EOF"
  expect "a heredoc fed to bash -s behind sudo" 0 "2|1|shell|0|1|brew|install|a"
  runc "cat > notes.md <<'EOF'
Run npx playwright install
EOF
python3 <<EOF
print('sudo make install')
EOF"
  expect "a heredoc fed to cat or python3: its body is not read" 0 "1|0|list|0|1|cat|>|notes.md|<<|EOF" "2|0|list|0|1|python3|<<|EOF"
  lines "a heredoc fed to cat or python3: its body is not read" 2
  runc "cat <<EOF
\$(brew install x) \\\$(not run)
EOF"
  expect "a heredoc with an unquoted delimiter: a substitution in its body is run by the shell, an escaped one not" 0 "1|0|list|0|1|cat|<<|EOF" "2|1|subst|0|1|brew|install|x"
  lines "a heredoc with an unquoted delimiter: a substitution in its body is run by the shell, an escaped one not" 2
  runc "cat <<-EOF
	\$(a)
	EOF"
  expect "<<-: tabs stripped before the delimiter" 0 "2|1|subst|0|1|a"
  runc "cat <<A <<B; echo x
\$(a)
A
\$(b)
B"
  expect "two heredocs on one line, each body after the line in order" 0 "1|0|list|0|1|cat|<<|A|<<|B" "2|0|list|0|1|echo|x" "3|1|subst|0|1|a" "4|1|subst|0|1|b"
  runc "cat <<EOF
\$(a)"
  expect "a heredoc without its delimiter: the body runs to the end, as bash reads it" 0 "2|1|subst|0|1|a"
  runc 'bash <<< "brew install ripgrep"; cat <<< "$(a)"'
  expect "a here-string: shell text for a shell, a word with its substitution for cat" 0 "2|1|shell|0|1|brew|install|ripgrep" "3|0|list|0|1|cat|<<<|\$(a)" "4|3|subst|0|1|a"
  runc 'for f in a; do echo $(b) $f; done | tee out; { c; } | d'
  expect "a pipe behind a compound: the last command of its body, not a nested one" 0 "1|0|list|0|1|echo|\$(b)|\$f" "2|1|subst|0|1|b" "3|0|list|1|1|tee|out" "4|0|list|0|1|c" "5|0|list|4|1|d"
  runc 'echo x | sh; printf "brew install x" | bash'
  expect "what a pipe carries into a shell is not read" 0 "2|0|list|1|1|sh" "4|0|list|3|1|bash"
  lines "what a pipe carries into a shell is not read" 4

  # the redirections
  runc 'echo x > f 2>&1 >> g 2> h &> i &>> j < k <> l >| m 1>&2'
  expect "every redirection: the operator with its descriptor, then the target" 0 "1|0|list|0|1|echo|x|>|f|2>&|1|>>|g|2>|h|&>|i|&>>|j|<|k|<>|l|>||m|1>&|2"
  runc '> out brew install x';              expect "a redirection before the command: the first word is behind it" 0 "1|0|list|0|3|>|out|brew|install|x"
  runc 'echo 2>f 2 > g';                    expect "digits before > are a descriptor, a separate 2 is a word" 0 "1|0|list|0|1|echo|2>|f|2|>|g"
  runc 'exec > log; > f';                   expect "exec with a redirection alone, and a redirection alone: no first word" 0 "1|0|list|0|0|exec|>|log" "2|0|list|0|0|>|f"
  runc '{ printf x; } > .claude/unattended.local; ( echo a ) >> f 2>&1; for l in a b; do echo $l; done > g; if true; then a; fi < h; f() { b; } > log; f'
  expect "a redirection behind a group, a subshell, for, if and a function body: a line of its own with no judged word" 0 "1|0|list|0|1|printf|x" "2|0|list|0|0|>|.claude/unattended.local" "3|0|list|0|1|echo|a" "4|0|list|0|0|>>|f|2>&|1" "5|0|list|0|1|echo|\$l" "6|0|list|0|0|>|g" "7|0|list|0|1|true" "8|0|list|0|1|a" "9|0|list|0|0|<|h" "10|0|list|0|1|b" "11|0|list|0|0|>|log" "12|0|list|0|1|f"
  runc "while read l; do echo \$l; done <<EOF
brew install x
EOF
echo done"
  expect "a heredoc behind a compound: noted for the body after the line, which is no command" 0 "1|0|list|0|1|read|l" "2|0|list|0|1|echo|\$l" "3|0|list|0|0|<<|EOF" "4|0|list|0|1|echo|done"
  lines "a heredoc behind a compound: noted for the body after the line, which is no command" 4
  runc '{ c; } > o | d; { echo $(a); } > "$(b)"'
  expect "a pipe behind a compound with a redirection reads from the last command of the body; a substitution in the target is a command of the redirection line" 0 "1|0|list|0|1|c" "2|0|list|0|0|>|o" "3|0|list|1|1|d" "4|0|list|0|1|echo|\$(a)" "5|4|subst|0|1|a" "6|0|list|0|0|>|\$(b)" "7|6|subst|0|1|b"

  # the first word behind assignments and wrappers
  runc 'GOBIN=/srv/tools FOO="a b" go install x@latest'
