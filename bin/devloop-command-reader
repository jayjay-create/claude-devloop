  VALS["strace"] = " -a -b -e -E -I -o -O -p -P -s -S -u -U -X --columns --detach-on --trace --env --interruptible --output --summary-syscall-overhead --trace-path --string-limit --summary-sort-by --user --summary-columns --const-print-style --stack-trace-frame-limit --syscall-limit --signal --signals --status --read --write --decode-pids --inject --fault --kvm --attach --argv0 --color --trace-fds --abbrev --verbose --raw "; SELF["strace"] = " -h --help -V --version "
