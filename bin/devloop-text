#!/bin/sh
# Prints shared/<name>.md, the text a skill inserts at load, with every
# ${CLAUDE_PLUGIN_ROOT} in it replaced by the plugin's directory, the one
# above this program's bin/. Claude Code substitutes that variable in a
# skill's own text; whether it does so in what an insert line printed is not
# measured, and a shared text naming a program of the plugin by it has to
# reach the model as a path either way. Since 7 October 2026.
# See docs/skill-conventions.md, "Text shared between skills".
set -u
if [ $# -ne 1 ]; then
  echo "devloop-text: expected exactly one name, got $#" >&2
  exit 2
fi
name=$1
case $name in
  ''|*[!a-z0-9-]*)
    echo "devloop-text: '$name' is not a name: only a-z, 0-9 and - are allowed" >&2
    exit 2
    ;;
esac
file=$(dirname "$0")/../shared/$name.md
if [ ! -f "$file" ]; then
  echo "devloop-text: $file does not exist" >&2
  exit 2
fi
root=$(cd "$(dirname "$0")/.." && pwd) || exit 2
# The directory escaped for sed's replacement: a backslash, an ampersand and
# the delimiter would otherwise be read as sed reads them.
esc=$(printf '%s\n' "$root" | sed 's/[\&|]/\\&/g')
sed "s|\${CLAUDE_PLUGIN_ROOT}|$esc|g" "$file" || exit 2
