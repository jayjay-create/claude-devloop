#!/bin/bash
# Runs a command and ends it after a fixed number of seconds, so that no
# command a skill bounds runs over the time limit of a Claude Code Bash call:
# the changelog of Claude Code says a command that reaches that limit is
# moved to the background and goes on running there, not ended, and nothing
# here has measured that; a skill that repeats it would then start a second
# one beside the first. GNU timeout does this and is not on a stock macOS.
# bin/devloop-setup-state bounds its fetch through this program since 10
# November 2026, until then with a copy of its own, and
# bin/devloop-start-conditions every query to GitHub since 25 October 2026.
# See docs/skill-conventions.md, "Environment constraints, measured", the
# paragraph on the time limit of a call.
#
# Usage: devloop-bounded SECONDS COMMAND [ARGUMENT ...]
#        devloop-bounded --self-test
#
# The command's output, input and exit code pass through unchanged. Where it
# ends before the bound, this program ends with it at once: the watchdog and
# its sleep are ended too, and nothing of them holds the output open. Where
# it has not ended after SECONDS, it is ended with everything it started,
# by SIGTERM as GNU timeout does and, where something of it stands one second
# later, by SIGKILL, as GNU timeout does under -k, so that a command which
# ignores SIGTERM is ended as well and this program returns at most two
# seconds after SECONDS; one line goes to stderr,
#   no answer within SECONDS seconds: COMMAND ARGUMENT ...
# and the exit code is 124, GNU timeout's, after the SIGKILL too, where GNU
# timeout exits 137. Where the command ends in the same
# instant the bound fires, the bound's answer stands. Ended itself, by
# SIGTERM, SIGINT or SIGHUP, it ends the command and the watchdog first.
# Exit 2 with one line on stderr where SECONDS is not a whole number above
# zero or no command follows it; --self-test alone is the one exception.
#
# How the command and everything it started are ended, since 10 November
# 2026: the command starts in a process group of its own, as under GNU
# timeout, and the bound ends that group by SIGTERM, the command first and
# then every process of the group at once, so that a shell among them has
# the signal before any of its children ends and prints "Terminated" for
# none of them. A process that leaves the group on purpose, a daemon, is
# beyond the bound, as under GNU timeout; and the command cannot read a
# terminal, as under GNU timeout without --foreground. Until that day the
# children were found with pgrep and ended one by one, deepest first: a
# child born between the listing and the kill ran on, holding the output
# open, which is how the job hooks on every system hung on macos-latest on
# 1 November 2026 in the self-test's case of a fetch over a transport that
# never answers; a shell whose child was ended before itself printed
# "Terminated" for it, the self-test red on macos-latest on 5 November 2026;
# and under Windows with Git Bash, where pgrep is not on PATH, nothing but
# the command itself was ever ended. Under Git Bash a native Windows program
# the command starts, git among them, is held by the runtime's own process
# for it, which stands in the group: SIGTERM to that process ends the native
# program and, of what it started, what the runtime's walk over the Windows
# process table reaches, read in winsup/cygwin/exceptions.cc and
# winsup/cygwin/include/cygwin/exit_process.h of
# git-for-windows/msys2-runtime at 5a1665c8, the runtime of Git for Windows
# 2.56; SIGSTOP is not sent, since that runtime drops every signal to a
# stopped process. What that walk reaches and what it does not, read in the
# same sources: it lists, by the Windows parent numbers, the processes under
# the native program that have no Cygwin pid and ends them; a process under a
# listed one that has a Cygwin pid, a process of Git Bash, it sends the
# signal, that process alone and where it leads its process group, and does
# not list, exit_process.h lines 313 to 319, so that nothing under it is
# looked for. A process of Git Bash started by a native program has no Cygwin
# parent and leads a group of its own, pinfo.cc line 99; an exec in it hands
# its Cygwin pid to the program it exec'd and waits for it, a process without
# a Cygwin pid to the walk from then on, while an exec in a process with a
# Cygwin parent exits at once, spawn.cc lines 798 to 812, 906 to 908 and 929.
# The limit, in one sentence: under Windows with Git Bash a process that a
# process of Git Bash under a native Windows program started and that the
# runtime's walk does not look for is not ended at the bound; the block of
# milestone 12 on it in docs/defects.md holds that, and nothing is built for
# it. Its cases, read and not measured under Git Bash: a shell that starts
# its program as a child and waits for it is sent the signal alone, and the
# program runs on; a shell exec'd into a second shell is listed, the second
# shell is sent the signal alone, and what that one started as a child runs
# on; and where the second shell exec'd into a program instead, it has
# exited, and the program hangs on a parent number no list holds. The one
# thing a process of Git Bash started that the walk does look for is the
# program a shell started by the native program exec'd into, the shell listed
# and the program sent the signal: measured on windows-latest by run
# 42876247351 of pull request #239, the self-test's fetch over such a
# transport back at the bound with its pipe released. git's own transports,
# ssh and git-remote-https, are direct children of git and are ended. The
# sentence stands so since the decision of 10 November 2026 on the limit, the
# roadmap entry of that date on the bound on every system: until then it
# named a process that a native program started through a shell exec'd into a
# second shell, and this head said of what one shell starts as a child that
# it was read and stood in the note of the block alone. Until the change of
# that day after run 42876247351 this head said the limit twice and
# differently, as that sentence and as a transport that is a shell exec'd
# into a shell exec'd into a program. The self-test hung on windows-latest on
# 10 November 2026 with the transport sh -c "sleep 7337" --, two shells under
# git, the second exec'ing into the sleep, and what held its pipe there is
# not read, the paragraph on the self-test below. The
# watchdog is a subshell with a sleep: ended, it ends its sleep by the job
# table and waits for it, so that nothing of the bound runs on once this
# program has returned; until that day a signal between the start of the
# sleep and the line that noted its process number left the sleep running,
# the self-test red on alpine on 1 November 2026. Ended itself, this program
# ends the command's group by SIGTERM and, where something of it stands half
# a second later, by SIGKILL, through a helper that ends with the group, and
# exits once the command is reaped: Claude Code ends a hook that runs past
# its limit with SIGTERM to the hook's process group and SIGKILL to that
# group five seconds later, read in its program at 2.1.321 on this machine,
# which reaches this program and not the groups of the command and the
# watchdog; measured on 10 November 2026, a command that ignores SIGTERM
# survived such an end until this escalation came in.
#
# At the bound, since 11 November 2026: the watchdog sends the command's
# group SIGTERM, looks every tenth of a second whether anything of it still
# stands, and sends what stands one second after the SIGTERM SIGKILL, which
# no process can catch or ignore; this program returns once the command is
# reaped and the watchdog has ended, so that the whole group has been sent
# SIGKILL by then where anything of it stood. Until that day the watchdog
# sent SIGTERM alone, as GNU timeout does without -k, and this program waited
# for the command without a limit: measured on 11 November 2026 at 46030ab on
# macOS with bash 3.2.57, and under Linux with bash 5.2.21 by the measurement
# that came with the order of that day, devloop-bounded 1 sh -c 'trap ""
# TERM; sleep 6' came back after six seconds, with the line and 124, and a
# command that never ends would not have come back at all, which is what the
# bound is there to rule out. The one second, and the half second where this
# program is ended itself, are each timed by a sleep of their own and not by
# counting the looks: a process start under Git Bash costs many times what it
# costs elsewhere, and ten looks, each a sleep of a tenth, would run past the
# second there. That timer is ended and reaped before the watchdog or the
# helper exits. Half a second where this program is ended itself, two seconds
# until 11 November 2026, so that a bound inside a bound comes out whole: the
# inner program, ended by the outer one's SIGTERM, has sent its own command
# SIGKILL and exited before the outer one, a second after that SIGTERM, sends
# SIGKILL to its group, which holds the inner program and its helper and not
# the inner command, a group of its own; with the two seconds the inner
# command would have outlived both where it ignores SIGTERM. Measured on 11
# November 2026 on macOS and in alpine:3.22, devloop-bounded 1 devloop-bounded
# 60 sh -c 'trap "" TERM; sleep 7357 & sleep 7359' back with 124 after 1.64
# to 1.68 seconds and neither sleep left; under Windows with Git Bash it is
# not measured and holds as long as the inner program is done within that
# second.
# What SIGKILL to the group reaches under Windows with Git Bash, read in the
# sources named above at 5a1665c8 and measured there by the job hooks on
# every system first: kill with a negative number sends every process of Git
# Bash whose group that is the signal, as it does for SIGTERM,
# winsup/cygwin/signal.cc lines 327 to 337 and 350 to 390; no handler can be
# set for SIGKILL, lines 41 and 441 to 445 there, and it goes through to a
# stopped process, where every other signal is dropped, exceptions.cc lines
# 1556 to 1569; a process of Git Bash exits on it, lines 1626 to 1627 and
# 1666 to 1667; the runtime's process for a native Windows program runs the
# walk it runs on SIGTERM, lines 1673 to 1692, and ends the native program
# and the processes listed under it by TerminateProcess at once, without the
# call of ExitProcess inside them that SIGTERM tries first, exit_process.h
# lines 232 to 258, a process of Git Bash under them that leads its group
# being sent SIGKILL, lines 313 to 319. So SIGKILL reaches there the
# processes SIGTERM reaches and no other, the limit above standing as it
# stands, and ends those of them that ignored SIGTERM.
#
# What stands of the group, since 13 November 2026: a process of it that has
# not ended. Until that day the watchdog's look was kill with the signal 0 to
# the group and nothing else, and under Linux that finds an ended process
# nobody has reaped, a zombie, as well: in a container whose process 1 does
# not reap, as tail -f /dev/null keeps the container of a job on GitHub, a
# process of the command that had lost its parent and ended on the SIGTERM
# stood in the group so, and the watchdog looked out its whole second for it,
# devloop-bounded 1 sh -c 'sleep 7331 & sleep 7333' back after 2.06 to 2.08
# seconds in alpine:3.22 where everything had ended at the bound, measured on
# 11 and 13 November 2026. Since that day the look under Linux reads the
# processes of the group off /proc, the function stands below, and a zombie
# counts for nothing: that call back after 1.01 to 1.02 seconds in the same
# container, as in one whose process 1 reaps. The helper that ends the group
# where this program is ended itself looks the same way and waits its half
# second for no zombie. On macOS and under Windows with Git Bash the look is
# kill with 0 as before, which counts no ended process there: measured on
# macOS 26.6.2 and read in bsd/kern/kern_sig.c line 1715 of xnu-12377.121.6,
# and read for Git Bash in winsup/cygwin/signal.cc lines 363 to 364 and
# pinfo.cc lines 597 to 599 of the runtime named above, the self-test's cases
# in which the bound fires on a command that takes SIGTERM 1.16 and 1.29
# seconds after the line before them on windows-latest in run 43017830242.
# What the look does not reach: where /proc is not there, or names the shell
# by another number than bash knows it by, as in a namespace of process
# numbers without a /proc of its own, the look is kill with 0 and the
# watchdog waits for a zombie as before; and a process /proc does not show
# the shell, another user's under hidepid, or one born after the look listed
# the group while its parent ended before the look read it, counts as ended,
# so that it is sent SIGKILL at once and not a second after the SIGTERM. Not
# measured under Windows with Git Bash: anything of this change; the job
# hooks on every system measures it there first.
#
# What reaches the command's stderr, since 13 November 2026: what the command
# writes, and the one line the shell writes for a command it cannot start,
# "command not found" or "bad interpreter" with exit 127 or 126, which says
# alone why nothing ran and which the shell writes once the command's stderr
# is set. Until that day a line of bash's own could stand there before the
# command's: under job control bash puts a background job into its process
# group from both sides of the fork, the child for itself and the parent for
# the child, jobs.c lines 1746 and 1817 of bash 3.2.57, and on macOS the call
# that loses that race can fail with EPERM though the group is made, measured
# on 13 November 2026 with both calls made at once after each of 40000 forks,
# the child's failing twice and the parent's twice, the child leading its
# group after every one; the parent does not read its result, and the child
# writes "child setpgid (N to N): Operation not permitted" to the shell's
# stderr, line 1747, before the command's redirections. Measured on macOS
# 26.6.2 with bash 3.2.57: the line in 6 of 20000 runs of a command that ends
# at once on 11 November 2026 and in 21 of 40000 on 13 November 2026, every
# exit code as it should be; of 14 runs with the line in which the command
# looked, 4 named the command and 10 the watchdog, the second of the two
# starts, and in every one the command led a group of its own. The self-test
# of bin/devloop-tool-state, which reads the first line of a bounded
# command's stderr as its message, was red once by it. Since that day the
# shell's stderr points to /dev/null while it forks at those two starts, and
# the command has its caller's stderr back before it starts, the comment at
# the starts below. What goes with it: a line of bash on a fork that fails at
# one of the two starts reaches nobody either. What it does not reach: with
# the descriptors 3 to 9 all held by the caller the command starts with the
# stderr the shell has, and the line can stand there on macOS as before; with
# the caller's stderr closed it starts the same way, a line having nowhere to
# go. Why the call fails is not read: bsd/kern/kern_prot.c lines 608 to 610
# and bsd/kern/kern_proc.c lines 2982 to 3062 of xnu-12377.121.6, the nearest
# published source, give a process that calls for itself EPERM only where it
# leads a session, and the kernel of that Mac, xnu-12377.161.14, is not
# published. Not measured under Windows with Git Bash: the two starts as they
# stand since that day; the job hooks on every system measures them first.
#
# --self-test produces every outcome above once without a network, prints
# one line per case and exits 1 on the first that does not come out as this
# header says. It needs bash, sh, sleep, cat, uname and git, and no GNU tool
# and no pgrep: it runs on macOS, Linux, Alpine and Windows with Git Bash.
# That nothing of the bound runs on it reads off a pipe: every run gets the
# write end of one on file descriptor 3, which everything the bound starts
# inherits, and the case is red where the read end is not released within
# two seconds of the program's return, the process that holds it named by
# nothing but the fact.
# The command that ignores SIGTERM, since 11 November 2026, on all four
# systems: sh -c 'trap "" TERM; sleep 7353 & sleep 7355', a shell that
# ignores the signal and two sleeps it starts, which inherit that; the case
# asks for the line, for 124, for the pipe released, and for the whole call
# back within 3000 milliseconds, the bound of one second and the two seconds
# this header allows after it. The time is bash's own, the reserved word time
# under TIMEFORMAT=%3R, which every bash from 3.2 on carries and which prints
# the real time to the millisecond: it runs from before the shell forks for
# the call until the call's output is at its end and the call is reaped, so
# that it holds the start of this program, before its bound begins to run,
# and the wait for everything that holds the output; a case that is green has
# measured less than the two seconds after the bound, never more. The other
# cases are held to whole seconds, the shell's SECONDS, as before, but for
# the one that follows.
# The command that ends on the SIGTERM with all it started, since 13 November
# 2026, on all four systems: sh -c 'sleep 7373 & sleep 7375', whose first
# sleep has lost its parent once the shell has ended; the case asks for the
# line, for 124, for the pipe released and for the whole call back within
# 1900 milliseconds by the same time of bash, the bound of one second and
# nine tenths. It is red where the watchdog waits out its second for a
# process that has ended: such a call is not back before 2000, and a copy of
# this program with the look of before failed the case with 2056 in a
# container of alpine:3.22 kept by tail -f /dev/null, as the job hooks on
# every system (alpine) runs the self-test, and passed it in one started with
# docker run --init. Why 1900: under Windows with Git Bash, where a process
# start costs most, the cases in which the bound fires on a command that
# takes SIGTERM stood 1.16 and 1.29 seconds after the line before them in run
# 43017830242, the end of the case before and the case's own checks lying in
# that, so that six tenths are left there; under CPU load the call took 1017
# to 1032 milliseconds on macOS, twenty and sixty busy loops on ten cores,
# and 1066 to 1416 in that container with 1100 zombies standing in it, where
# the copy with the look of before took 2048 to 2161, and the self-test
# passed eight times under each load on both, measured on 13 November 2026.
# Four cases on the descriptors, since the same day, on all four systems:
# descriptor 9 standing free is closed for the command; held by the caller it
# reaches the command; with 3 to 9 all held, and with the caller's stderr
# closed, the two cases in which the command starts with the stderr the shell
# has, the command runs all the same, its output and exit code through.
#
# The fetch over a transport that never answers checks on every system what
# the bound promises there, since the change of 10 November 2026 after the
# run of the checks named below, over two transports that take no argument
# and print nothing, so that git reads nothing of theirs as an answer on any
# system. The first is one process under git, exec sleep 7341 #: git runs a
# command with a space through one shell and appends the host and the
# command, which the # keeps out of it, and the shell execs into the sleep.
# It runs under GIT_SSH_VARIANT=simple, so that git starts it once, for the
# fetch itself, on git's pipes and with git's stderr, as it starts an ssh
# that does not answer; that case runs on all four systems. Without the
# variable git asks a transport it does not know by name with -G first, its
# input and output on /dev/null, and waits for it, connect.c lines 1412 to
# 1425 of git-for-windows/git at v2.56.0.windows.4, measured on macOS and in
# alpine:3.22 with GIT_TRACE; and under Windows git hands a child its three
# standard handles and no other, compat/mingw.c lines 2234 to 2292 and 2355
# to 2373 there, so that a transport standing in that first call holds
# nothing this self-test reads and could run on unseen. The second is a
# transport of several processes, sh -c "sleep 7337 & wait" --, a shell that
# waits for its sleep, which git asks with -G first and which stands there:
# it runs on macOS, Linux and Alpine, where the bound ends the whole group,
# and is left out under Windows with Git Bash, where its sleep is a process
# that a process of Git Bash under git started and that the runtime's walk
# does not look for, the shell that waits for it being sent the signal alone,
# with a line that says so, names lines 313 to 319 of exit_process.h, on
# which that hangs, and names the block of docs/defects.md on the limit above
# by its title. The line names the place in the source since the change of 10
# November 2026 after run 42876247351 of pull request #239, green on all five
# checks, whose job on windows-latest printed the line as it stood and passed
# with 12 cases, the fetch over the one process back 1.29 seconds after the
# case before it; the case over several processes that run did not measure
# there. Since the decision of that day on the limit the line says the limit
# and the title of the block as they stand now.
# Until the change after run 42805995483 the one transport was tail -f
# /dev/null, since the third commit of that day, and before it
# sh -c "sleep 7337" --. GNU tail prints
# the header "==> /dev/null <==" once it is given more than one file, which
# git read as the answer and ended on, "protocol error: bad line length
# character: ==> ", exit 128, so that both self-tests were red on
# ubuntu-latest and windows-latest on 10 November 2026, run 42805995483 of
# pull request #239; the tail of macOS took the -G for a file and stood in
# that first call, and the tail of busybox prints no header beside a file it
# cannot open, both green there. And sh -c "sleep 7337" -- ran as one sleep
# under git on macOS and in alpine:3.22, each shell exec'ing into what it
# runs, measured on 10 November 2026, so that it tested no transport of
# several processes there. That transport stood in the call with -G when the
# self-test hung on windows-latest, on three handles of NUL by the reading
# above, so that it held no pipe of the self-test; what did is not read. One
# reading, not measured: the runtime's walk ends the descendants before git
# itself, exit_process.h lines 332 to 360, and git, its first call ended,
# starts the transport again for the fetch, with its stderr, after the walk
# has listed the processes.
set -u
me=devloop-bounded

usage() { echo "$me: $1" >&2; exit 2; }

# Ends a process group by SIGTERM: its leader first, so that a shell has the
# signal before any of its children ends and prints nothing for them, then
# the whole group at once. The group is named by its leader's number.
end_group() { kill -TERM -- "$1" 2>/dev/null; kill -TERM -- "-$1" 2>/dev/null; }

# stands GROUP: whether a process of the group stands that has not ended.
# kill with the signal 0 says so on macOS and under Windows with Git Bash;
# under Linux it finds an ended process that nobody has reaped as well, so
# that there every process of the group is read off /proc, with read and no
# process started: the one found running last or the leader first, then all,
# and the group stands where one of them is no zombie, or is one whose first
# thread has ended while another runs, more than one entry under task. Where
# /proc is not there, or does not name this shell by the number bash knows it
# by, the answer of kill stands, as on the other systems. The number found
# running is kept in alive, a variable of the caller.
stands() {
  kill -0 -- "-$1" 2>/dev/null || return 1
  case ${OSTYPE:-} in linux*) ;; *) return 0 ;; esac
  local f l h t
  read -r l < /proc/self/stat && [ "${l%% *}" = "${BASHPID:-}" ] || return 0
  for f in "/proc/${alive:-$1}" /proc/[0-9]*; do
    read -r l < "$f/stat" || continue
    # a line that does not hold the group's number as a field is of no process of the group; one that does is taken apart behind the name, which ends at the last ") ": the state, the parent, the group
    case $l in *" $1 "*) ;; *) continue ;; esac
    h=${l%) *}; l=${l:${#h}+2}; h=${l#* * }
    [ "${h%% *}" = "$1" ] || continue
    case $l in [ZX]\ *) t=("$f"/task/[0-9]*); [ "${#t[@]}" -gt 1 ] || continue ;; esac
    alive=${f#/proc/}; return 0
  done
  return 1
} 2>/dev/null

# kill_group_after GROUP DURATION: looks every tenth of a second whether
# anything of the group stands and sends it SIGKILL once DURATION, what sleep
# takes, has passed or nothing stands any more, which then reaches nothing.
# The duration is a sleep of its own, ended by SIGKILL, since it is started
# where SIGTERM is ignored and inherits that, and reaped before this returns.
kill_group_after() {
  local t alive=
  sleep "$2" & t=$!
  while stands "$1" && kill -0 "$t" 2>/dev/null; do sleep 0.1; done
  kill -KILL -- "-$1" 2>/dev/null
  kill -KILL "$t" 2>/dev/null; wait "$t" 2>/dev/null
}

selftest() {
  local self T out rc n=0 k=0 t0 t1 ms
  self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  T=$(mktemp -d "${TMPDIR:-/tmp}/devloop-bounded.XXXXXX") || exit 1
  trap 'rm -rf "$T"' EXIT
  # run: the program with its arguments, output and exit code kept, timed; file descriptor 3 is the probe's pipe: release reads it
  # to its end and leaves a mark, which released looks for
  release() { exec >/dev/null 2>&1; cat; : > "$T/released.$k"; }
  run() { k=$((k+1)); t0=$SECONDS; out=$("$self" "$@" 2>&1 3> >(release)); rc=$?; t1=$((SECONDS - t0)); }
  # timed: as run, the real time of the whole call in ms, milliseconds, off bash's own time, which writes it as seconds with three decimals to the shell's stderr, here a file whose last line is read
  timed() { local l TIMEFORMAT=%3R; k=$((k+1)); { time out=$("$self" "$@" 2>&1 3> >(release)); } 2> "$T/time.$k"; rc=$?; ms=; while read -r l; do ms=$l; done < "$T/time.$k"; ms=${ms//[!0-9]/}; ms=$((10#${ms:-999999})); }
  fail() { echo "FAIL $1"; printf '%s\n' "$out" | sed 's/^/    /'; exit 1; }
  # expect NAME EXIT SUBSTRING...: the last run exited EXIT and printed every substring
  expect() {
    local name="$1" want="$2" s; shift 2; n=$((n+1))
    [ "$rc" -eq "$want" ] || fail "$name: exit $rc, expected $want"
    for s in "$@"; do printf '%s\n' "$out" | grep -qF -- "$s" || fail "$name: nothing holds '$s'"; done
    echo "ok   $name"
  }
  absent() { printf '%s\n' "$out" | grep -qF -- "$1" && fail "$2: '$1' stands there and should not"; }
  within() { [ "$t1" -le "$2" ] || fail "$1: took $t1 seconds, expected at most $2"; }
  # released: nothing of the last run holds the probe's pipe two seconds after the program returned
  released() { local i=0; until [ -e "$T/released.$k" ]; do i=$((i+1)); [ "$i" -le 20 ] || fail "$1: something the bound started still runs two seconds after the program returned, holding the probe's pipe"; sleep 0.1; done; }
  git_q() { git -c user.name=t -c user.email=t@t -c commit.gpgsign=false "$@"; }

  run;                  expect "no argument: exit 2" 2 "expected SECONDS and a command, got nothing"
  run x true;           expect "seconds not a number: exit 2" 2 "expected a whole number of seconds above zero, got 'x'"
  run 0 true;           expect "seconds zero: exit 2" 2 "expected a whole number of seconds above zero, got '0'"
  run -1 true;          expect "seconds negative: exit 2" 2 "expected a whole number of seconds above zero, got '-1'"
  run 1.5 true;         expect "seconds not whole: exit 2" 2 "expected a whole number of seconds above zero, got '1.5'"
  run 5;                expect "no command: exit 2" 2 "expected a command after the seconds"
  run --self-test x;    expect "--self-test with another argument: not the self-test, exit 2" 2 "expected a whole number of seconds above zero, got '--self-test'"
  # ends in time: output and exit code through, back at once, nothing of the bound left
  run 7339 sh -c 'echo out; echo err >&2; exit 0'
  expect "ends in time with 0: output through, exit 0" 0 "out" "err"
  absent "no answer" "ends in time with 0: output through, exit 0"
  within "ends in time with 0: back at once, not at the bound" 2
  released "ends in time with 0: nothing of the bound runs on"
  run 7339 sh -c 'exit 3'
  expect "ends in time with 3: exit 3 through" 3
  absent "no answer" "ends in time with 3: exit 3 through"
  within "ends in time with 3: back at once, not at the bound" 2
  released "ends in time with 3: nothing of the bound runs on"
  k=$((k+1)); t0=$SECONDS; out=$(printf 'in\n' | "$self" 7339 cat 2>&1 3> >(release)); rc=$?; t1=$((SECONDS - t0))
  expect "input through: cat prints what it was fed" 0 "in"
  within "input through: back at once" 2
  released "input through: nothing of the bound runs on"
  # the descriptors of the caller reach the command as they are, whatever the start does with one of them for the command's stderr: 9 free, taken and closed again for the command; 9 held, left alone; 3 to 9 all held and stderr closed, the two cases in which the command starts with the stderr the shell has
  k=$((k+1)); t0=$SECONDS; out=$("$self" 7339 sh -c '( : >&9 ) 2>/dev/null && echo open || echo closed; echo err >&2' 2>&1 3> >(release) 9>&-); rc=$?; t1=$((SECONDS - t0))
  expect "descriptor 9 free: closed for the command, stderr through" 0 "closed" "err"
  k=$((k+1)); t0=$SECONDS; out=$("$self" 7339 sh -c 'echo nine >&9; echo err >&2' 2>&1 3> >(release) 9> "$T/d9"); rc=$?; t1=$((SECONDS - t0)); out="$out $(cat "$T/d9")"
  expect "descriptor 9 held by the caller: reaches the command, stderr through" 0 "err" "nine"
  k=$((k+1)); t0=$SECONDS; out=$("$self" 7339 sh -c 'for d in 4 5 6 7 8 9; do echo "d$d" >&$d; done; echo err >&2' 2>&1 3> >(release) 4> "$T/d4" 5> "$T/d5" 6> "$T/d6" 7> "$T/d7" 8> "$T/d8" 9> "$T/d9"); rc=$?; t1=$((SECONDS - t0)); out="$out $(cat "$T"/d[4-9])"
  expect "descriptors 3 to 9 all held by the caller: reach the command, stderr through" 0 "err" "d4" "d5" "d6" "d7" "d8" "d9"
  k=$((k+1)); t0=$SECONDS; out=$("$self" 7339 sh -c 'echo out; exit 5' 2>&- 3> >(release)); rc=$?; t1=$((SECONDS - t0))
  expect "stderr closed by the caller: output and exit code through" 5 "out"
  released "stderr closed by the caller: nothing of the bound runs on"
  # does not end: ended with what it started, the line, 124
  run 1 sh -c 'sleep 7331 & sleep 7333'
  expect "does not end: ended with what it started, the line, exit 124" 124 "no answer within 1 seconds: sh -c sleep 7331 & sleep 7333"
  absent "Terminated" "does not end: ended with what it started, the line, exit 124"
  within "does not end: back at the bound" 3
  released "does not end: what the command started is ended too"
  # does not end, and what it started ends on the SIGTERM with it, a sleep that has lost its parent by then: the whole call back within 1900 milliseconds, the bound of one second and nine tenths, short of the second the watchdog allows what ignores the signal; red where the watchdog waits that second out for a process that has ended and that nobody reaps, as in a container whose process 1 does not
  timed 1 sh -c 'sleep 7373 & sleep 7375'
  expect "does not end, all of it ended on the SIGTERM: the line, exit 124" 124 "no answer within 1 seconds: sh -c sleep 7373 & sleep 7375"
  [ "$ms" -le 1900 ] || fail "does not end, all of it ended on the SIGTERM: back after $ms milliseconds, expected at most 1900, the bound of one second and nine tenths: the watchdog waited for a process that had ended"
  released "does not end, all of it ended on the SIGTERM: nothing of it runs on"
  # does not end and ignores SIGTERM, a shell and the two sleeps it starts: ended by SIGKILL a second after the bound, the line, 124, the whole call back within 3000 milliseconds, the bound of one second and the two seconds the header allows after it
  timed 1 sh -c 'trap "" TERM; sleep 7353 & sleep 7355'
  expect "ignores SIGTERM: ended all the same, the line, exit 124" 124 'no answer within 1 seconds: sh -c trap "" TERM; sleep 7353 & sleep 7355'
  [ "$ms" -le 3000 ] || fail "ignores SIGTERM: back after $ms milliseconds, expected at most 3000, the bound of one second and two more"
  released "ignores SIGTERM: what the command started is ended too"
  # a fetch over a transport that never answers, built as bin/devloop-setup-state builds it, on every system: exec sleep 7341 #, one process under git, started once, for the fetch itself, under GIT_SSH_VARIANT=simple
  git_q init -q "$T/repo" && git_q -C "$T/repo" remote add origin "git@localhost:devloop-bounded-selftest-$$/x.git"
  k=$((k+1)); t0=$SECONDS; out=$(cd "$T/repo" && GIT_SSH_VARIANT=simple GIT_SSH_COMMAND='exec sleep 7341 #' "$self" 1 git fetch -q origin 2>&1 3> >(release)); rc=$?; t1=$((SECONDS - t0))
  expect "a fetch over a transport that never answers: the line, exit 124" 124 "no answer within 1 seconds: git fetch -q origin"
  within "a fetch over a transport that never answers: back at the bound" 3
  released "a fetch over a transport that never answers: the transport is ended"
  # the same over a transport of several processes, a shell that waits for its sleep, on macOS, Linux and Alpine; left out under Windows with Git Bash, where the bound does not end it, with a line that says so and names the place in the runtime's source on which that hangs and the block
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
      echo "left out under Windows with Git Bash: a fetch over a transport of several processes that never answers, since the bound does not end there a process that a process of Git Bash under git, a native Windows program, started and that the runtime's walk does not look for: the walk sends the shell that waits for its sleep the signal alone and looks for nothing under it, winsup/cygwin/include/cygwin/exit_process.h lines 313 to 319 of git-for-windows/msys2-runtime at 5a1665c8; docs/defects.md, the block \"under Windows with Git Bash the bound does not end a process that a process of Git Bash under a native Windows program started and that the runtime's walk does not look for, the self-test's fetch case hung so on windows-latest\"" ;;
    *)
      k=$((k+1)); t0=$SECONDS; out=$(cd "$T/repo" && GIT_SSH_COMMAND='sh -c "sleep 7337 & wait" --' "$self" 1 git fetch -q origin 2>&1 3> >(release)); rc=$?; t1=$((SECONDS - t0))
      expect "a fetch over a transport of several processes that never answers: the line, exit 124" 124 "no answer within 1 seconds: git fetch -q origin"
      within "a fetch over a transport of several processes that never answers: back at the bound" 3
      released "a fetch over a transport of several processes that never answers: the transport is ended" ;;
  esac
  echo "SELF-TEST PASSED: $n cases"
  exit 0
}
[ $# -eq 1 ] && [ "$1" = --self-test ] && selftest

[ $# -ge 1 ] || usage "expected SECONDS and a command, got nothing"
case $1 in
  ''|*[!0-9]*) usage "expected a whole number of seconds above zero, got '$1'" ;;
esac
[ "$1" -gt 0 ] || usage "expected a whole number of seconds above zero, got '$1'"
[ $# -ge 2 ] || usage "expected a command after the seconds"
secs=$1; shift

# Job control for the two starts below and nothing else: under it bash puts
# a background job into a process group of its own, named by its number.
# At each of the two the shell's stderr points nowhere while it forks, so
# that what bash itself writes there, its line on setpgid, reaches nobody;
# the command has its caller's stderr back before it starts, off a descriptor
# that stands free, the first of 9 down to 3, closed again for the command.
# With none of them free, or with the caller's stderr closed, the command
# starts with the stderr the shell has.
set -m
e=9; while [ "$e" -ge 3 ] && { : >&"$e"; } 2>/dev/null; do e=$((e-1)); done
if [ "$e" -ge 3 ] && : >&2; then
  eval "{ \"\$@\" <&0 2>&$e $e>&- & } $e>&2 2>/dev/null"
else
  "$@" <&0 &
fi
pid=$!
# The watchdog sleeps the bound out, ends the command's group by SIGTERM,
# sends what of it stands one second later SIGKILL and exits 99, deaf to
# TERM from the end of its sleep on, since the command's end wakes this
# program, which ends the watchdog, before the watchdog has ended the rest
# of the group; this program waits for it below, so that it returns with the
# group ended. Ended while it sleeps, it ends its sleep, read off its
# job table so that no moment is missed, waits for it and exits 143, so
# that nothing of it runs on; its output goes nowhere, so that it holds no
# pipe open.
{ ( trap 'kill $(jobs -p) 2>/dev/null; wait; exit 143' TERM; sleep "$secs" & wait; trap '' TERM; end_group "$pid"; kill_group_after "$pid" 1; exit 99 ) >/dev/null 2>&1 & } 2>/dev/null
wd=$!
set +m
# Ended itself: the command's group by SIGTERM, what of it stands half a
# second later by SIGKILL through a helper that ends with the group, then the
# watchdog; the exit code once the command is reaped.
ended() { end_group "$pid"; ( kill_group_after "$pid" 0.5 ) >/dev/null 2>&1 & kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null; wait "$pid" 2>/dev/null; exit "$1"; }
trap 'ended 143' TERM
trap 'ended 130' INT
trap 'ended 129' HUP
# bash reports a job ended by a signal on its stderr, "Terminated: 15"; the
# redirect on wait keeps that off the output, the command's own stderr is
# untouched by it.
wait "$pid" 2>/dev/null; rc=$?
trap - TERM INT HUP
kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null; wrc=$?
if [ "$wrc" -eq 99 ]; then
  echo "no answer within $secs seconds: $*" >&2
  exit 124
fi
exit "$rc"
