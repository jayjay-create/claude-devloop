HERE=$(cd "$(dirname "$0")" && pwd)
BOUNDED=$HERE/devloop-bounded
BOUND=60
DAY=$(date +%Y-%m-%d)
SYSTEM=${DEVLOOP_TOOL_STATE_SYSTEM:-$(uname -s)}
WIN=""
case $SYSTEM in MINGW*|MSYS*|CYGWIN*|Windows*) WIN=yes ;; esac
# node resolves from the project and from nothing else that answers: the lookup starts at the project's puppeteer where one stands in its node_modules, else at the project, and a module whose real path lies outside the project's node_modules is refused with exit 3, since 28 October 2026
PUPPETEER_JS='const fs=require("fs"),path=require("path");const name=process.argv[1],cache=process.argv[2],proj=fs.realpathSync(process.argv[3]);const inside=path.join(proj,"node_modules")+path.sep;const within=p=>fs.realpathSync(p).startsWith(inside);const home=process.env.HOME;const show=p=>home&&p.startsWith(home+path.sep)?"~"+p.slice(home.length):p;const from=[proj];try{const d=path.dirname(require.resolve("puppeteer/package.json",{paths:[proj]}));if(within(d))from.unshift(d)}catch(e){}const need=id=>{const p=require.resolve(id,{paths:from});if(!within(p)){process.stderr.write(id+" resolved outside the project'"'"'s node_modules, at "+show(p)+"\n");process.exit(3)}return require(p)};const r=need("puppeteer-core/internal/revisions.js").PUPPETEER_REVISIONS;const b=need("@puppeteer/browsers");const id=r[name]||"";console.log(id);console.log(id&&b.computeExecutablePath({browser:name,buildId:id,cacheDir:cache}));'
WAY="a tool that is missing is handed to the person as a backed command with both ways before anything is built against a stand-in, build-work step 3 point 7"

FORM=${1:-}
[ -n "$FORM" ] || usage "expected --planning, --build or --installed first, got nothing"
shift
case $FORM in
  --planning|--build) [ $# -ge 1 ] || usage "expected at least one TOOL after $FORM" ;;
  --installed) [ $# -eq 2 ] || usage "expected exactly a COMMAND and a TOOL after --installed, got $# arguments" ;;
  *) usage "expected --planning, --build or --installed first, got '$FORM'" ;;
esac
# check_tool TOOL: a bare word as it is called, or VENDOR:NAME of one of the three vendors; anything else ends the program before a line is printed
check_tool() {
  case $1 in
    playwright:[A-Za-z0-9]*|puppeteer:[A-Za-z0-9]*|cypress:binary) ;;
    *:*) usage "a browser is named VENDOR:NAME with playwright, puppeteer or cypress as the vendor, and cypress:binary for Cypress, got '$1'" ;;
    ''|-*|*[!A-Za-z0-9._+-]*) usage "a TOOL is a bare word as it is called - letters, digits, dot, hyphen, plus and underscore - or VENDOR:NAME for a browser, got '$1'" ;;
  esac
}
[ "$FORM" != --installed ] || [ -n "$1" ] || usage "the COMMAND of --installed is empty"
[ "$FORM" != --installed ] || check_tool "$2"
[ "$FORM" = --installed ] || for t in "$@"; do check_tool "$t"; done

PROJECT_DIR=${CLAUDE_PROJECT_DIR:-$PWD}
cd "$PROJECT_DIR" 2>/dev/null || usage "the project directory $PROJECT_DIR cannot be entered"
T=$(mktemp -d "${TMPDIR:-/tmp}/devloop-tool-state.XXXXXX") || usage "mktemp -d failed"
trap 'rm -rf "$T"' EXIT
BAD=0

# say LINE: a line of a tool, with the day it was read; bad: the exit becomes 1
say() { echo "$1 (on $DAY)"; }
bad() { BAD=1; }
# tilde PATH: a home directory at the opening written as ~, as bin/devloop-install-note writes a folder
tilde() { local p=$1; case $p in "$HOME"|"$HOME"/*) p="~${p#"$HOME"}" ;; esac; printf '%s' "$p"; }
# cap WORD: the word with its first letter in capitals, the vendor's name as it is written
cap() { printf '%s%s' "$(printf '%s' "${1%"${1#?}"}" | tr '[:lower:]' '[:upper:]')" "${1#?}"; }
# flat: the input on one line
flat() { tr '\n' ' ' | sed 's/   */ /g; s/ *$//'; }
# ask LABEL COMMAND...: the query under the bound; OUT its output, RC its exit code and FAIL the clause of a line that it did not answer, empty where it answered: its first line on stderr that is no stack frame, else its output, else the code it ended with
ask() {
  local label=$1 err; shift
  OUT=$("$BOUNDED" "$BOUND" "$@" 2>"$T/err"); RC=$?
  err=$(grep -v -e '^ ' -e '^$' -e '^node:' -e '^Require stack' "$T/err" | head -n 1)
  FAIL=""
  case $RC in
    0) ;;
    127) [ "${1##*/}" = "$1" ] && FAIL="$label did not answer: $1 is not on PATH" || FAIL="$label did not answer: ${err:-ended with 127}" ;;
    *) FAIL="$label did not answer: ${err:-${OUT:-ended with $RC}}" ;;
  esac
}
# stands_at FOLDER TOOL: the path of the tool in the folder, TOOL.exe, TOOL.cmd and TOOL.bat on Windows counting as well; nothing where none stands
stands_at() { local x; for x in "" ${WIN:+.exe .cmd .bat}; do [ -e "$1/$2$x" ] && { printf '%s' "$1/$2$x"; return; }; done; }
# cache SETTING_NAME DARWIN_FOLDER LINUX_FOLDER VENDOR: CACHE the vendor's cache folder, the setting where it is set, else the folder shared/backed-command.md names for this system; empty, with CAUSE set, where neither names one
cache() {
  local set; eval "set=\${$1:-}"
  CACHE=""; CAUSE=""
  [ -z "$set" ] || { CACHE=${set%/}; return; }
  case $SYSTEM in
    Darwin) CACHE=$HOME/$2 ;;
    Linux) CACHE=$HOME/$3 ;;
    *) CAUSE="shared/backed-command.md names no folder for $4 on this system ($SYSTEM) and $1 is not set" ;;
  esac
}

# tool_line TOOL: the line of a command on the search path
tool_line() {
  local p
  p=$(command -v -- "$1" 2>/dev/null)
  [ -n "$p" ] && [ "${p#/}" != "$p" ] && { say "$1: found at $(tilde "$p")"; return; }
  say "$1: not found on the search path"; bad
}
# browser_line VENDOR NAME: the line of a browser for tests, found only in the version the project's test tool needs
browser_line() {
  local vendor=$1 name=$2 arg="$1:$2" folder="" version="" probe="" id="" exe="" rel
  CAUSE=""; FAIL=""
  case $vendor in
    playwright)
      # the project's own command and never npx, which falls back to a package outside the project, since 28 October 2026
      [ -e node_modules/.bin/playwright ] || CAUSE="the project has no Playwright package to say which version of $name it needs, no node_modules/.bin/playwright"
      [ -n "$CAUSE" ] || ask "node_modules/.bin/playwright install --dry-run $name" node_modules/.bin/playwright install --dry-run "$name"
      [ -n "$CAUSE" ] || [ -z "$FAIL" ] || CAUSE="the project's Playwright did not say which version of $name it needs: $FAIL"
      [ -n "$CAUSE" ] || { version=$(printf '%s\n' "$OUT" | grep -m1 .); folder=$(printf '%s\n' "$OUT" | sed -n 's/^ *Install location: *//p' | head -n 1); folder=${folder%/}; probe=$folder; }
      [ -n "$CAUSE" ] || [ -n "$folder" ] || CAUSE="the dry run printed no install location: $(printf '%s\n' "$OUT" | flat)" ;;
    cypress)
      version=$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' node_modules/cypress/package.json 2>/dev/null | head -n 1)
      [ -n "$version" ] || CAUSE="the project has no Cypress package to say which version it needs, no version in node_modules/cypress/package.json"
      [ -n "$CAUSE" ] || cache CYPRESS_CACHE_FOLDER Library/Caches/Cypress .cache/Cypress Cypress
      [ -n "$CAUSE" ] || { folder=$CACHE/$version; probe=$folder; version="Cypress $version"; } ;;
    puppeteer)
      # only where the project holds the package: node would resolve a module from the directories above the project, NODE_PATH and its global folders as well, since 28 October 2026
      [ -e node_modules/puppeteer-core/package.json ] || [ -e node_modules/puppeteer/package.json ] || CAUSE="the project has no Puppeteer package to say which build of $name it needs, neither node_modules/puppeteer-core nor node_modules/puppeteer"
      [ -n "$CAUSE" ] || cache PUPPETEER_CACHE_DIR .cache/puppeteer .cache/puppeteer Puppeteer
      [ -n "$CAUSE" ] || ask "node, asked for the build of $name and its folder under $(tilde "$CACHE")," node -e "$PUPPETEER_JS" "$name" "$CACHE" "$PWD"
      [ -n "$CAUSE" ] || [ -z "$FAIL" ] || CAUSE="the project's Puppeteer did not say which build of $name it needs: $FAIL"
      [ -n "$CAUSE" ] || { id=$(printf '%s\n' "$OUT" | sed -n 1p); exe=$(printf '%s\n' "$OUT" | sed -n 2p); }
      [ -n "$CAUSE" ] || [ -n "$id" ] || CAUSE="the project's Puppeteer names no build of $name, PUPPETEER_REVISIONS having no entry for it"
      [ -n "$CAUSE" ] || { rel=${exe#"$CACHE"/}; folder=$CACHE/$(printf '%s' "$rel" | cut -d/ -f1-2); probe=$exe; version="$name $id"; } ;;
  esac
  [ -z "$CAUSE" ] || { say "$arg: not read, because $CAUSE"; bad; return; }
  [ -e "$probe" ] && [ -n "$(ls -A "$probe" 2>/dev/null)" ] && { say "$arg: found at $(tilde "$folder"), $version as the project's $(cap "$vendor") needs it"; return; }
  say "$arg: not found: nothing stands at $(tilde "$folder"), the folder of $version as the project's $(cap "$vendor") needs it"; bad
}
# read_tool TOOL: the line of a tool, a browser where the name carries a colon
read_tool() { case $1 in *:*) browser_line "${1%%:*}" "${1#*:}" ;; *) tool_line "$1" ;; esac; }
# has_flag FLAG... -- WORD...: whether one of the flags stands among the words
has_flag() { local f w; f=" "; while [ "$1" != -- ]; do f="$f$1 "; shift; done; shift; for w in "$@"; do case $f in *" $w "*) return 0 ;; esac; done; return 1; }
# installed_line COMMAND TOOL: the line of --installed, the folder read off the installer named by the command's first word after any VAR=value
installed_line() {
  local tool=$2 installer="" dir="" q="" p w
  CAUSE=""; FAIL=""
  # shellcheck disable=SC2086
  set -- $1
  for w in "$@"; do case $w in *=*) continue ;; esac; installer=$w; break; done
  case $installer in
    brew) ask "brew --prefix" brew --prefix; dir=$OUT/bin; q="brew --prefix" ;;
    npm) has_flag -g --global -- "$@" && { ask "npm prefix -g" npm prefix -g; dir=$OUT/bin; [ -z "$WIN" ] || dir=$OUT; q="npm prefix -g"; } || CAUSE="npm without -g or --global installs inside a project, which is no tool outside it" ;;
    pnpm) ask "pnpm bin -g" pnpm bin -g; dir=$(printf '%s\n' "$OUT" | grep '/' | tail -n 1); q="pnpm bin -g" ;;
    yarn) ask "yarn global bin" yarn global bin; dir=$(printf '%s\n' "$OUT" | grep '/' | tail -n 1); q="yarn global bin" ;;
    bun) ask "bun pm bin -g" bun pm bin -g; dir=$(printf '%s\n' "$OUT" | grep '/' | tail -n 1); q="bun pm bin -g" ;;
    go) ask "go env GOBIN" go env GOBIN; dir=$OUT; q="go env GOBIN"; [ -n "$FAIL" ] || [ -n "$dir" ] || { ask "go env GOPATH" go env GOPATH; dir=${OUT%%:*}/bin; q="go env GOPATH, GOBIN being empty"; } ;;
    pipx) ask "pipx environment --value PIPX_BIN_DIR" pipx environment --value PIPX_BIN_DIR; dir=$OUT; q="pipx environment --value PIPX_BIN_DIR" ;;
    uv) ask "uv tool dir --bin" uv tool dir --bin; dir=$OUT; q="uv tool dir --bin" ;;
    gem) ask "gem environment" gem environment; dir=$(printf '%s\n' "$OUT" | sed -n 's/.*EXECUTABLE DIRECTORY: *//p' | head -n 1); q="the EXECUTABLE DIRECTORY of gem environment" ;;
    cargo) dir=${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}/bin; q="CARGO_INSTALL_ROOT, CARGO_HOME or ~/.cargo as cargo documents them, cargo having no query for it" ;;
    *) CAUSE="this program reads the folder of brew, npm, pnpm, yarn, bun, go, pipx, uv, gem and cargo off the installer, and '$installer' is none of them" ;;
  esac
  [ -n "$CAUSE" ] || [ -z "$FAIL" ] || CAUSE=$FAIL
  [ -n "$CAUSE" ] || [ -n "${dir%/bin}" ] || CAUSE="$q printed no folder"
  [ -z "$CAUSE" ] || { say "$tool: not read, because $CAUSE"; bad; return; }
  dir=${dir%/}
  p=$(stands_at "$dir" "$tool")
  [ -n "$p" ] && { say "$tool: found at $(tilde "$p"), the folder $installer writes to, read off $q"; return; }
  say "$tool: not found at $(tilde "$dir/$tool"), the folder $installer writes to, read off $q; a copy elsewhere on the search path does not count"; bad
}
# installed_lines COMMAND TOOL: the folder line, then the search-path line, since 28 October 2026
installed_lines() { installed_line "$1" "$2"; tool_line "$2"; }
# record_line: the line on the install record under --build, read through bin/devloop-install-record
record_line() {
  local rec rc tools ref date cause
  rec=$("$HERE/devloop-install-record" "$PROJECT_DIR" 2>&1); rc=$?
  tools=$(printf '%s\n' "$rec" | sed -n 's/^tools: //p' | head -n 1)
  ref=$(printf '%s\n' "$rec" | sed -n 's/^ref: //p' | head -n 1)
  date=$(printf '%s\n' "$rec" | sed -n 's/^answered: //p' | head -n 1)
  cause=$(printf '%s\n' "$rec" | sed -n 's/^cause: //p' | head -n 1)
  case "$rc:$tools" in
    0:yes) echo "record: tools yes on $ref, answered $date: a tool that is missing is installed by this run at the build, backed, with 600000 milliseconds on the call, build-work step 3 point 7" ;;
    0:*) echo "record: tools no on $ref, answered $date: $WAY" ;;
    *) echo "record: none, because ${cause:-the reader answered nothing}: as under no, $WAY" ;;
  esac
}

case $FORM in
  --installed) case $2 in *:*) read_tool "$2" ;; *) installed_lines "$1" "$2" ;; esac ;;
  --planning) for t in "$@"; do read_tool "$t"; done; echo "record: not read here; whether the run installs a tool that is missing at the build or the person gets the command for it is decided by the install record as it stands at the build, build-work step 3 point 7, and the planning settles nothing of it" ;;
  --build) for t in "$@"; do read_tool "$t"; done; record_line ;;
esac
exit "$BAD"
