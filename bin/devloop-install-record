#!/bin/bash
# Prints the install record: the section "## Install permission" of
# docs/agents/environment.md as it stands on the default branch as last
# fetched, refs/remotes/origin/<default>, never as it stands in the working
# tree. The install guard and the session-start hook both read the record
# through this program, so that the two cannot disagree about it.
# See docs/skill-conventions.md, "The install guard reads a record".
#
# With --dependency, since 22 October 2026, the same reading of the section
# "## Dependency permission" of the same file, the record on whether the run
# may add check tools to the project's packages - start condition 7 of the
# mode with nobody there, where the install record is condition 6. The guard
# on the mark, hooks/pre-tool-use-mark-guard.sh, reads both conditions
# through this program when the mark is written, so that the hook and the
# install guard read one record one way. Under --dependency the keys are
# dependency-tools and dependency-answered, there are no place and no route
# lines, and every cause names that section.
#
# On exit 0, one key per line:
#   ref: origin/<default>
#   tools: yes|no
#   place: <one line per place the record names, spelled as the record spells it>
#   route: <one line per route the record names, a name the guard resolves on
#           the machine the run is on: brew, go, npm, pnpm, yarn, bun, cargo,
#           gem, pipx, uv, pip>
#   answered: <the date the record carries, or none>
# On exit 1 one line, "cause: <which of the causes it was>", and nothing else;
# each cause is one whole clause without a label and a colon of its own, so
# that the install guard can join it behind "because", since 21 October 2026.
# Exit 2 on an option it does not know or on more than one directory. The one
# directory argument is the project directory; without it, CLAUDE_PROJECT_DIR,
# and without that the current directory.
set -u
HEADING='## Install permission'
KEY='install-tools'
ANSWERED_KEY='install-answered'
DIRS=0
PROJECT_DIR=""
BAD=""
for a in "$@"; do
  case "$a" in
    --dependency) HEADING='## Dependency permission'; KEY='dependency-tools'; ANSWERED_KEY='dependency-answered' ;;
    -*) BAD="unknown option $a; the one option is --dependency" ;;
    *) DIRS=$((DIRS + 1)); PROJECT_DIR="$a" ;;
  esac
done
[ "$DIRS" -le 1 ] || BAD="expected at most one directory argument, the project directory, got $DIRS"
if [ -n "$BAD" ]; then
  echo "devloop-install-record: $BAD" >&2
  exit 2
fi
PROJECT_DIR="${PROJECT_DIR:-${CLAUDE_PROJECT_DIR:-$PWD}}"
FILE='docs/agents/environment.md'

cd "$PROJECT_DIR" 2>/dev/null || { echo "cause: the project directory $PROJECT_DIR cannot be entered"; exit 1; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo "cause: this is not a git repository, so there is no default branch to read the record off"; exit 1; }

# The default branch, resolved exactly as hooks/pre-tool-use-branch-guard.sh
# resolves it; a check under "Before a handover, run these" holds the three
# copies together, bin/devloop-setup-state's among them.
DEFAULT=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
DEFAULT="${DEFAULT#origin/}"
if [ -z "$DEFAULT" ]; then
  for c in main master; do
    if git show-ref --verify --quiet "refs/heads/$c"; then DEFAULT="$c"; break; fi
  done
fi
[ -n "$DEFAULT" ] || { echo "cause: there is no default branch, since origin/HEAD names none and neither main nor master exists"; exit 1; }

REF="refs/remotes/origin/$DEFAULT"
git rev-parse --verify --quiet "$REF" >/dev/null 2>&1 || { echo "cause: the default branch $DEFAULT has not been fetched, so $REF cannot be read"; exit 1; }
CONTENT=$(git show "$REF:$FILE" 2>/dev/null) || { echo "cause: there is no $FILE on origin/$DEFAULT as last fetched"; exit 1; }
printf '%s\n' "$CONTENT" | grep -qxF "$HEADING" || { echo "cause: $FILE on origin/$DEFAULT has no section \"$HEADING\", so the question was never answered"; exit 1; }

SECTION=$(printf '%s\n' "$CONTENT" | awk -v h="$HEADING" '$0 == h { s = 1; next } s && /^## / { exit } s')
TOOLS=$(printf '%s\n' "$SECTION" | grep -m1 "^$KEY:" | sed "s/^$KEY:[[:space:]]*//; s/[[:space:]]*\$//")
case "$TOOLS" in
  yes|no) ;;
  '') echo "cause: the section \"$HEADING\" on origin/$DEFAULT has no $KEY line"; exit 1 ;;
  *) echo "cause: $KEY reads \"$TOOLS\" on origin/$DEFAULT, where yes and no are the only values"; exit 1 ;;
esac
ANSWERED=$(printf '%s\n' "$SECTION" | grep -m1 "^$ANSWERED_KEY:" | sed "s/^$ANSWERED_KEY:[[:space:]]*//; s/[[:space:]]*\$//")

echo "ref: origin/$DEFAULT"
echo "tools: $TOOLS"
if [ "$KEY" = install-tools ]; then
  printf '%s\n' "$SECTION" | grep '^install-place:' | sed 's/^install-place:[[:space:]]*//; s/[[:space:]]*$//' | while IFS= read -r p; do
    [ -n "$p" ] && echo "place: $p"
  done
  printf '%s\n' "$SECTION" | grep '^install-route:' | sed 's/^install-route:[[:space:]]*//; s/[[:space:]]*$//' | while IFS= read -r r; do
    [ -n "$r" ] && echo "route: $r"
  done
fi
echo "answered: ${ANSWERED:-none}"
exit 0
