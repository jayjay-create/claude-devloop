def answer(root, c, path):
    """What the command of a check prints, on stdout and on stderr, the empty lines left out."""
    p = subprocess.run([shutil.which("bash", path=path), "--noprofile", "--norc", "-c", c["command"]], cwd=root, env={"PATH": path}, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return [[l for l in s.decode("utf-8", "replace").split("\n") if l.strip()] for s in (p.stdout, p.stderr)]


def read_list(root, name):
    """The lines of a list: every line of the file but the empty ones and those that start with #."""
    try:
        text = open(os.path.join(root, name), encoding="utf-8").read()
    except (OSError, UnicodeDecodeError) as e:
        raise CannotRun("the list %s cannot be read: %s" % (name, getattr(e, "strerror", None) or "it is no UTF-8"))
    return [l.rstrip() for l in text.split("\n") if l.strip() and not l.startswith("#")]


def place(line, where):
    """The file, with the line where the command names one, and the text of a line a command printed."""
    line = line.strip()
    m = PLACE.match(line)
    return (m.group(1) + (":" + m.group(2) if m.group(2) else ""), m.group(3) or "") if m else (where, line)


def quoted(lines):
    return ", ".join('"%s"' % l for l in lines) or "nothing"


def judge(root, c, path=PATH):
    """The finds of one check, none where it is green: each the place, the text and what makes it green."""
    out, err = answer(root, c, path)
    where, green = c["where"], c["green"]
    finds = [(where, "stderr: " + l.strip(), STDERR) for l in err]
    if c["kind"] == "list":
        name = "%s/%s.txt" % (LISTS, c["key"])
        left = collections.Counter(read_list(root, name))
        for raw in out:
            line = NUMBER.sub(r"\1:", raw.rstrip(), count=1)
            if left[line] > 0:
                left[line] -= 1
                continue
            finds.append(place(raw, where) + (NEW % (name, c["read"], line),))
        return finds + [place(line, where) + (GONE % (name, c["read"]),) for line in sorted(left.elements())]
    got = [l.strip() for l in out]
    want = c["want"](root, got)
    if c["kind"] == "answer":
        return finds + [(where, "prints %s where %s is green" % (quoted(got), quoted(want)), "Green: " + green)] * (sorted(got) != sorted(want))
    left = collections.Counter(want)
    for line in got:
        if left[line] > 0:
            left[line] -= 1
            continue
        finds.append(place(line, where) + ("the check prints this line. Green: " + green,))
    return finds + [place(line, where) + ("the check does not print this line. Green: " + green,) for line in sorted(left.elements())]


def verdicts(root, path=PATH):
    """Every check with its finds, in the order of the section."""
    if not os.path.isfile(os.path.join(root, ".claude-plugin", "plugin.json")) or not skills(root):
        raise CannotRun("the directory above this program is not devloop's repository: it carries no .claude-plugin/plugin.json or no skills/*/SKILL.md")
    missing = [t for t in TOOLS if not shutil.which(t, path=path)]
    if missing:
        raise CannotRun("the commands run with PATH=%s, and it holds no %s" % (path, ", no ".join(missing)))
    return [(c, judge(root, c, path)) for c in CHECKS]


def run(root, path=PATH):
    """Every check once: the exit code, and the lines to print."""
    try:
        found = verdicts(root, path)
    except CannotRun as e:
        return 2, ["devloop-handover-checks cannot run: %s" % e]
    lines = ['devloop-handover-checks: %d checks of "Before a handover, run these", each command run as env -i PATH=%s bash --noprofile --norc in the repository this program stands in' % (len(CHECKS), path)]
    for c, finds in found:
        lines.append("%s  %s: %s" % ("RED" if finds else "ok ", c["key"], c["says"]))
        for where, text, green in finds:
            lines += ["     %s%s" % (where, ": " + text if text else ""), "       " + green]
    red = [c["key"] for c, finds in found if finds]
    last = "red: %d checks green, %d red: %s" % (len(CHECKS) - len(red), len(red), ", ".join(red)) if red else "green: %d checks green, 0 red" % len(CHECKS)
    return int(bool(red)), lines + [last]


# ---------------------------------------------------------------- self-test

INSERT = "!`${CLAUDE_PLUGIN_ROOT}/bin/devloop-text %s`"
GRANT = "allowed-tools: Bash(${CLAUDE_PLUGIN_ROOT}/bin/devloop-text *)"
NOTICE = "**If `[shell command execution disabled by policy]` stands anywhere in this"
ARM = "${CLAUDE_PLUGIN_ROOT}/bin/devloop-arm <number>"
FORMS = "A status is `filled`, `empty` or `skipped (user): <the user's reason>`."
OFFER = "Say what is missing and offer to bring it up to date."
HANDOVER = "The build picks up once the tool stands where that command puts it."
SECOND = "None: stop, the build has it so."
LOCKED = "An armed pull request goes to `start-work` from here."
DEFAULT = '#!/bin/sh\nDEFAULT=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)\nif [ -z "$DEFAULT" ]; then\n  DEFAULT=main\nfi\n'
GUARD = "#!/bin/sh\ncat <<'EOF'\n%s\nEOF\n"
EXPAND = r'''#!/bin/sh
# the fixture's stand-in for scripts/devloop-expand: 0 where every insert line of the file names a file under shared/
missing=$(for n in $(sed -n 's/^!`.*devloop-text \([a-z0-9-]*\)`$/\1/p' "$1"); do [ -f "shared/$n.md" ] || echo "$n"; done)
[ -z "$missing" ]
'''
BUILD, PLAN, START = "skills/build-work/SKILL.md", "skills/plan-work/SKILL.md", "skills/start-work/SKILL.md"


def skill(name, body, locked=False, under=None):
    """A skill of the fixture: frontmatter with the grant, the notice, the opening and the line on skill names, the body, the closing."""
    opening = [INSERT % "language-opening", "", INSERT % "skill-name", ""]
    top = ["# " + name, "", under, ""] + opening if under else opening + ["# " + name, ""]
    front = ["---", "name: " + name, "description: a skill of the fixture"] + ["disable-model-invocation: true"] * locked + [GRANT, "---", ""]
    return "\n".join(front + [NOTICE, "text, nothing was inserted: say so and stop.**", ""] + top + body + ["", INSERT % "closing"]) + "\n"


def put(T, rel, text, mode=None):
    path = os.path.join(T, rel)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(path, mode or 0o644)


def get(T, rel):
    return open(os.path.join(T, rel), encoding="utf-8").read()


def swap(T, rel, old, new):
    text = get(T, rel)
    assert old in text, "the fixture's %s does not carry %r" % (rel, old)
    with open(os.path.join(T, rel), "w", encoding="utf-8") as f:
        f.write(text.replace(old, new, 1))


def add(T, rel, line):
    # a line into a skill of the fixture, above its closing block
    swap(T, rel, "\n" + INSERT % "closing", "\n" + line + "\n\n" + INSERT % "closing")


def fixture(T):
    """The green repository of the self-test, built anew: three skills, the shared texts, the programs and hooks the commands read, the two documents, the lists, and git's record of it."""
    for n in os.listdir(T):
        shutil.rmtree(os.path.join(T, n))
    put(T, ".claude-plugin/plugin.json", '{"name": "fixture", "skills": ["./skills/build-work", "./skills/plan-work", "./skills/start-work"]}\n')
    put(T, BUILD, skill("build-work", [LOCKED, "", "## Unattended mode", "", "The run ends once nothing is ready and no loose issue labelled `raised-here` is left."]))
    put(T, PLAN, skill("plan-work", [OFFER, "", SECOND]))
    put(T, START, skill("start-work", ["Ask what they would like to build."], locked=True, under="## How to talk while doing all this"))
    put(T, "shared/language-opening.md", "Write in the language of the person.\n")
    put(T, "shared/skill-name.md", "Name a skill by its name.\n")
    put(T, "shared/closing.md", "Close in the same language.\n")
    put(T, "shared/arming-command.md", "    " + ARM + "\n")
    put(T, "shared/status-forms.md", FORMS + "\n")
    put(T, "shared/install-tool.md", HANDOVER + "\n")
    put(T, "docs/roadmap.md", "# Roadmap\n\n## Named, not built as skills\n\n| Name | What it is |\n|---|---|\n| `tidy-notes` | named, not built |\n\n## Entries\n\n- An entry on `build-work`, on `tidy-notes` and on the flag `--auto`.\n")
    put(T, "docs/skill-conventions.md", "# Conventions\n\n    " + ARM + "\n")
    put(T, "hooks/pre-tool-use-merge-guard.sh", GUARD % ARM)
    put(T, "hooks/pre-tool-use-table-guard.sh", GUARD % FORMS)
    put(T, "hooks/post-tool-use-table-guard.sh", GUARD % FORMS)
    put(T, "hooks/pre-tool-use-branch-guard.sh", DEFAULT)
    for name in ("install-record", "setup-state", "start-conditions"):
        put(T, "bin/devloop-" + name, DEFAULT, 0o755)
    put(T, "scripts/devloop-expand", EXPAND, 0o755)
    put(T, LISTS + "/invocability.txt", "# the count of the locks per skill\n\n%s:0\n%s:0\n%s:1\n" % (BUILD, PLAN, START))
    put(T, LISTS + "/locked-skills.txt", "%s:%s\n" % (BUILD, LOCKED))
    put(T, LISTS + "/offers.txt", "%s:%s\n" % (PLAN, OFFER))
    put(T, LISTS + "/handovers.txt", "shared/install-tool.md:%s\n" % HANDOVER)
    put(T, LISTS + "/second-statement.txt", "%s:%s\n" % (PLAN, SECOND))
    for args in (["init", "-q"], ["add", "-A"]):
        subprocess.run([shutil.which("git", path=PATH)] + args, cwd=T, env={"PATH": PATH}, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def selftest():
    """Every outcome of the program once, in a throwaway directory outside the repository: every check green and red, a list with a new line and with a line gone, a line on stderr, and each exit code."""
    T = tempfile.mkdtemp(prefix="devloop-handover-checks-selftest.")
    try:
        return selftest_in(T)
    finally:
        shutil.rmtree(T, ignore_errors=True)


def selftest_in(T):
    cases = [
        # the check, red or new or gone, the case, the change to the green fixture, what a find of the check must carry
        ("registered", "red", "a directory under skills/ that plugin.json does not name", lambda: put(T, "skills/more-work/SKILL.md", skill("more-work", [])), "present but unregistered: ['more-work']"),
        ("roadmap-names", "red", "a word of the roadmap one edit from the name of a skill", lambda: put(T, "docs/roadmap.md", get(T, "docs/roadmap.md") + "- A run of `build-works`.\n"), "build-works is 1 from build-work"),
        ("roadmap-names", "red", "the table of the named ones without a row, nothing to hold the roadmap against", lambda: swap(T, "docs/roadmap.md", "| `tidy-notes` | named, not built |\n", ""), "nothing to hold the roadmap against: 0 rows"),
        ("roadmap-names", "red", "no roadmap to read: silence on stdout, the error on stderr", lambda: os.remove(os.path.join(T, "docs/roadmap.md")), "docs/roadmap.md: stderr: "),
        ("invocability", "new", "a second lock, the list holding 0 for the skill", lambda: swap(T, PLAN, GRANT, "disable-model-invocation: true\n" + GRANT), PLAN + ": 1"),
        ("invocability", "gone", "a lock lifted, the list holding 1 for the skill", lambda: swap(T, START, "disable-model-invocation: true\n", ""), START + ": 1"),
        ("locked-skills", "new", "a second skill naming the locked one", lambda: add(T, PLAN, "Then run `start-work`."), PLAN + ":20: Then run `start-work`."),
        ("locked-skills", "new", "a second line naming the locked one in a file the list carries", lambda: add(T, BUILD, "Then run `start-work`."), BUILD + ":22: Then run `start-work`."),
        ("locked-skills", "gone", "the skill of the list naming it no more", lambda: swap(T, BUILD, "`start-work`", "the entry point"), BUILD + ": " + LOCKED),
        ("shared-copies", "red", "a line of a shared text written out in a skill", lambda: add(T, PLAN, FORMS), PLAN),
        ("insert-lines", "red", "a line that names the program and is no insert line", lambda: add(T, PLAN, "Run bin/devloop-text by hand."), ": Run bin/devloop-text by hand."),
        ("insert-lines", "red", "an insert line naming no file under shared/", lambda: add(T, PLAN, INSERT % "no-such-text"), "no shared/no-such-text.md"),
        ("grant", "red", "a skill that inserts without the grant", lambda: swap(T, PLAN, GRANT + "\n", ""), PLAN + ": inserts without the allowed-tools line"),
        ("language-block", "red", "a skill that does not end on the closing block", lambda: swap(T, PLAN, "\n" + INSERT % "closing" + "\n", "\n"), PLAN + ": does not end on the closing language block"),
        ("language-block", "red", "the opening of start-work above its heading: a line the check does not print", lambda: swap(T, START, "## How to talk while doing all this\n\n", ""), START + ': opening under "## How to talk while doing all this" | the check does not print this line'),
        ("notice", "red", "the notice reworded in one skill, two checksums", lambda: swap(T, PLAN, "stands anywhere", "stands somewhere"), '"3" where "one line of cksum", "3" is green'),
        ("notice", "red", "the notice gone from every skill, one checksum of nothing and the count 0", lambda: [swap(T, f, NOTICE, "**Where nothing was inserted") for f in (BUILD, PLAN, START)], '"0" where "4294967295 0", "3" is green'),
        ("expansion", "red", "an insert line that does not expand", lambda: add(T, PLAN, INSERT % "no-such-text"), PLAN + ": expansion failed"),
        ("executable", "red", "a program under bin/ that cannot start", lambda: os.chmod(os.path.join(T, "bin/devloop-setup-state"), 0o644), "bin/devloop-setup-state: not executable"),
        ("executable", "red", "a file under scripts/ that git does not track", lambda: put(T, "scripts/left-behind", "x\n", 0o755), "bin/ or scripts/ has files git does not track"),
        ("arming-guard", "red", "the arming command changed in the merge guard", lambda: swap(T, "hooks/pre-tool-use-merge-guard.sh", ARM, ARM + " --now"), 'prints "0" where "1" is green'),
        ("arming-conventions", "red", "the arming command changed in the conventions", lambda: swap(T, "docs/skill-conventions.md", ARM, ARM + " --now"), 'prints "0" where "1" is green'),
        ("default-branch", "red", "the default branch resolved otherwise in one of the four files", lambda: swap(T, "bin/devloop-setup-state", "DEFAULT=main", "DEFAULT=master"), 'prints "2", "4" where "1", "4" is green'),
        ("default-branch", "red", "the opening line of the block changed in all four files, four checksums of nothing", lambda: [swap(T, f, "DEFAULT=$(git symbolic-ref", "DEFAULT_X=$(git symbolic-ref") for f in ("bin/devloop-install-record", "bin/devloop-setup-state", "bin/devloop-start-conditions", "hooks/pre-tool-use-branch-guard.sh")], 'prints "1", "0" where "1", "4" is green'),
        ("status-forms", "red", "the sentence on the forms changed in one of the two guards", lambda: swap(T, "hooks/pre-tool-use-table-guard.sh", "A status is", "A status reads"), 'prints "1", "0" where "1", "1" is green'),
        ("offers", "new", "an offer added to a skill", lambda: add(T, PLAN, "Then offer to go on."), PLAN + ":20: Then offer to go on."),
        ("offers", "gone", "an offer of the list reworded", lambda: swap(T, PLAN, "and offer to bring", "and bring"), PLAN + ": " + OFFER),
        ("handovers", "new", "a handover added to a shared text", lambda: put(T, "shared/fetch.md", "This picks up as soon as they say so.\n"), "shared/fetch.md:1: This picks up as soon as they say so."),
        ("handovers", "gone", "a handover of the list reworded", lambda: swap(T, "shared/install-tool.md", "picks up once", "goes on when"), "shared/install-tool.md: " + HANDOVER),
        ("unattended-finish", "red", "the section on the unattended mode without the label of the loose issues", lambda: swap(T, BUILD, "`raised-here`", "raised here"), BUILD + ": the unattended finish does not mention loose raised-here issues"),
        ("second-statement", "new", "the finish decided a second time", lambda: add(T, BUILD, "None: stop and say so."), ": None: stop and say so."),
        ("second-statement", "gone", "a statement of the list gone", lambda: swap(T, PLAN, SECOND, "Nothing more."), PLAN + ": " + SECOND),
    ]
    by_key = {c["key"]: c for c in CHECKS}
    seen, failed = 0, []

    def case(name, ok):
        nonlocal seen
        seen += 1
        failed.extend([] if ok else [name])
        print("%s %s" % ("ok  " if ok else "FAIL", name))

    fixture(T)
    green_code, green_lines = run(T)
    green = {c["key"]: "ok   %s: %s" % (c["key"], c["says"]) in green_lines for c in CHECKS}
    for key, kind, name, change, want in cases:
        fixture(T)
        change()
        finds = judge(T, by_key[key])
        red = any(want in "%s%s | %s" % (where, ": " + text if text else "", why) and why.startswith({"red": "", "new": "new,", "gone": "gone,"}[kind]) for where, text, why in finds)
        case("%s: %s: %s %s, green %s" % (key, name, kind, "seen" if red else "not seen", "seen" if green[key] else "not seen"), red and green[key])
    owed = ["%s %s" % (c["key"], kind) for c in CHECKS for kind in (("new", "gone") if c["kind"] == "list" else ("red",)) if (c["key"], kind) not in {(k[0], k[1]) for k in cases}]
    case("every check with a case for each of its outcomes, red, or new and gone where it has a list%s" % ("; none for %s" % ", ".join(owed) * bool(owed)), not owed)

    case("exit 0: every check green, the last line opening with green: and carrying the counts", green_code == 0 and green_lines[-1] == "green: %d checks green, 0 red" % len(CHECKS))
    fixture(T)
    add(T, PLAN, "Then offer to go on.")
    code, lines = run(T)
    case("exit 1: a check red, the last line opening with red: and carrying the counts and the name", code == 1 and lines[-1] == "red: %d checks green, 1 red: offers" % (len(CHECKS) - 1) and "RED  offers: " + by_key["offers"]["says"] in lines)
    with contextlib.redirect_stderr(io.StringIO()) as said:
        code = main(["devloop-handover-checks", "--nothing-it-takes"])
    case("exit 2: an argument the program does not take, the usage on stderr", code == 2 and said.getvalue().startswith("usage: "))
    fixture(T)
    code, lines = run(os.path.join(T, "docs"))
    case("exit 2: a directory that is not devloop's repository", code == 2 and len(lines) == 1 and "is not devloop's repository" in lines[0])
    code, lines = run(T, os.path.join(T, "docs"))
    case("exit 2: a tool of the commands that the path does not hold", code == 2 and len(lines) == 1 and "it holds no bash, no python3" in lines[0])
    os.remove(os.path.join(T, LISTS, "offers.txt"))
    code, lines = run(T)
    case("exit 2: a list that cannot be read", code == 2 and len(lines) == 1 and "the list %s/offers.txt cannot be read: No such file or directory" % LISTS in lines[0])

    print("SELF-TEST FAILED: %d of %d cases: %s" % (len(failed), seen, "; ".join(failed)) if failed else "SELF-TEST PASSED: %d cases" % seen)
    return int(bool(failed))


def main(argv):
    if argv[1:] == ["--self-test"]:
        return selftest()
    if argv[1:]:
        sys.stderr.write("usage: devloop-handover-checks [--self-test]\n")
        return 2
    code, lines = run(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    (sys.stderr if code == 2 else sys.stdout).write("\n".join(lines) + "\n")
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
