        ("Line with a capital", "plan-lines", THE_PLAN, "Line 12 of `skills/build-work/SKILL.md` decides it.", ["Line 12, a line of `skills/build-work/SKILL.md`"]),
        ("lines in the plural, the file behind the last number", "plan-lines", THE_PLAN, "Decided for lines 12 to 14 of `skills/build-work/SKILL.md`.", ["lines 12 to 14, a line of `skills/build-work/SKILL.md`"]),
        ("a file known by its slash alone, without an ending", "plan-lines", THE_PLAN, "Held at `scripts/devloop-expand` line 3.", ["line 3, a line of `scripts/devloop-expand`"]),
        ("a file known by its ending alone, without a slash", "plan-lines", THE_PLAN, "Held at `README.md` line 5.", ["line 5, a line of `README.md`"]),
        ("a line behind a second file, given to that file and not to the archive named first", "plan-lines", THE_PLAN, "Measured in `%s` line 7 and in `skills/build-work/SKILL.md` line 12." % ARCHIVED, ["line 12, a line of `skills/build-work/SKILL.md`"]),
    ):
        got, note = reads(lambda: more(T, rel, text))
        case("found, the paragraph read: %s" % name, places_of(got) == ["%s: %s:%d: %s" % (key, rel, {RATIONALE: 8, THE_PLAN: 10}[rel], w) for w in want])
    for name, change in (
        ("a bold item above the first heading of docs/roadmap.md, which is no entry", lambda: swap(T, ROADMAP, "# Roadmap\n\n", "# Roadmap\n\n- **%s** A note above every heading.\n\n" % GATE)),
        ("a head that never closes, read to the end of the file and no further", lambda: more(T, ROADMAP, "- **A head that never closes, on the last line of the file")),
        ('a bold item under "## Known gaps" of a document that is neither docs/roadmap.md nor an archive, which is no entry', lambda: put(T, "docs/notes.md", "# Notes\n\n## Known gaps\n\n- **%s** A copy.\n" % THREE)),
        ("a list item the branch adds right under a paragraph, which begins a paragraph of its own and leaves the one above unread", lambda: swap(T, THE_PLAN, "and no run meets it.\n", "and no run meets it.\n- An item right under it.\n")),
        ("a heading the branch adds right under a paragraph, which begins a paragraph of its own and leaves the one above unread", lambda: swap(T, THE_PLAN, "and no run meets it.\n", "and no run meets it.\n## A heading right under it\n")),
    ):
        got, note = reads(change)
        case("nothing found: %s" % name, not got)
    got, note = reads(lambda: [swap(T, ROADMAP, "\n\n## Decisions taken against", "\n- **First of two entries.** Decided: (a).\n- **Second of two entries.** Decided: (b).\n\n## Decisions taken against"), more(T, RATIONALE, 'Decided as (b) of entry "First of two entries.".')])
    case("an entry ends before the next entry: a letter that the entry behind it carries is not its own, red", places_of(got) == ['entry-letters: %s:8: (b), in "(b)" of the entry "First of two entries."' % RATIONALE])
    got, note = reads(lambda: swap(T, THE_PLAN, "The counter runs out late,", "The counter runs out very late,"))
    case("a branch that changes one line alone, which git gives as a hunk without a count, answers for the paragraph of that line", places_of(got) == ["plan-lines: %s:5: line 28, a line of `kernel/pid.c`" % THE_PLAN])
    got, note = reads(lambda: more(T, RATIONALE, TWO))
    case("a find on a head misquoted says how the quote goes on up to its closing mark, and nothing of what stands behind the mark", len(got) == 1 and 'the head goes on with "hree parts." and the quote with "wo parts.". Green:' in got[0])
    got, note = reads(lambda: more(T, RATIONALE, 'Held in entry "The plan decided, in three parts. And a fourth" since.'))
    case("a find on a quote that goes on behind a whole head says that the head ends there, and how the quote goes on", len(got) == 1 and 'behind "decided, in three parts." the head ends and the quote goes on with " And a fourth". Green:' in got[0])
    got, note = reads(lambda: more(T, RATIONALE, 'Held in entry "The plan decided, in three parts and so on without an end'))
    case("a find on a head misquoted in a quote that never closes says how the quote goes on in its next 16 characters", len(got) == 1 and 'the head goes on with "." and the quote with " and so on witho". Green:' in got[0])
    got, note = reads(lambda: swap(T, ROADMAP, "\n\n## Decisions taken against", "\n- **A new entry, written twice.** One.\n- **A new entry, written twice.** Two.\n\n## Decisions taken against"))
    case("a new head the branch writes twice: red at the first of the two, and the find says that it stood 0 times at the commit the branch forked from", places_of(got) == ["entry-heads: docs/roadmap.md:14: - **A new entry, written twice.**"] and "at docs/roadmap.md:14, docs/roadmap.md:15, and the branch adds it: at the commit it forked from, %s, it stood 0 times. Green:" % tgit(T, "rev-parse", "origin/main")[:7] in got[0])
    got, note = reads(lambda: put(T, "docs/stock-take.tsv", 'thing\tone\tbuilt, the roadmap entry of 1 January 2026 "The plan decided, in two parts."\nthing\ttwo\tline 3 of the entry "%s"\n' % THREE))
    case("in docs/stock-take.tsv every line is a paragraph, and a source git does not track yet is read in every line", places_of(got) == ['entry-heads: docs/stock-take.tsv:1: entry of 1 January 2026 "The plan decided, in two parts."'] and REFERENCES + "the 4 paragraphs of 3 sources" in note)
    got, note = reads(lambda: [put(T, LISTS + "/notes.txt", TWO + "\n"), put(T, "docs/roadmap-archive-2.md", "# Roadmap\n\n## Known gaps\n\n- **An entry archived.** %s\n" % TWO)])
    case("a file under docs/handover-checks/ and an archive are no sources: a reference that breaks in either is not read", not got and REFERENCES + "the 2 paragraphs of 2 sources" in note)
    got, note = reads(lambda: [more(T, THE_PLAN, SKILL_LINE), commit(T, "the branch")])
    case("a line the branch committed is read like one that stands in the working tree alone", places_of(got) == ["plan-lines: %s:10: line 12, a line of `skills/build-work/SKILL.md`" % THE_PLAN])
    got, note = reads(lambda: archive(False))
    case("the entries moved into a new archive: no head added, the entry the branch names found once there", not got and REFERENCES + "the 2 paragraphs of 2 sources" in note)
    got, note = reads(lambda: archive(True))
    case("a new archive whose entries stay in docs/roadmap.md: the head added, and the entry named twice by the branch standing twice", len(got) == 3 and all("the head stands 2 times, at docs/roadmap.md:12, docs/roadmap-archive-2.md:12" in g for g in got) and places_of(got)[2] == "entry-heads: docs/roadmap.md:12: - **%s**" % THREE and "and the branch adds it: at the commit it forked from, %s, it stood once" % tgit(T, "rev-parse", "origin/main")[:7] in got[2])
    fixture(T)
    squashed()
    code, lines = run(T)
    case("on main after a squash merge HEAD is the commit the branch forked from: nothing read, every check green", code == 0 and lines[1] == REFERENCES + "the 0 paragraphs of 0 sources under docs/ that carry a line this branch adds or changes against %s, git merge-base HEAD origin/main" % tgit(T, "rev-parse", "HEAD")[:7] and lines[-1] == "green: %d checks green, 0 red" % len(CHECKS))
    got, note = reads(onto_main)
    case("HEAD the branch merged onto main, as in the workflow: the commit forked from is origin/main, the lines of the branch are read and a line main got meanwhile is not", places_of(got) == ["plan-lines: %s:10: line 12, a line of `skills/build-work/SKILL.md`" % THE_PLAN] and tgit(T, "rev-parse", "HEAD^1") == tgit(T, "rev-parse", "origin/main") and REFERENCES + "the 3 paragraphs of 2 sources under docs/ that carry a line this branch adds or changes against %s," % tgit(T, "rev-parse", "origin/main")[:7] in note)
    fixture(T)
    code, lines = run(T, everything=True)
    case("--all: every line of every source read, the line docs/plan.md named before the branch red", code == 1 and lines[1].startswith(REFERENCES + "every line of the 4 sources under docs/, ") and lines[1].endswith(" paragraphs, with --all") and "     %s:5: line 28, a line of `kernel/pid.c`" % THE_PLAN in lines and lines[-1] == "red: %d checks green, 1 red: plan-lines" % (len(CHECKS) - 1))
    got, note = reads(lambda: [again(), squashed()], True)
    case("--all: a head of docs/roadmap.md that an archive carries too is red, on main as well, where without --all nothing is read", places_of(got) == ["entry-heads: docs/roadmap.md:14: - **%s**" % GATE, "plan-lines: %s:5: line 28, a line of `kernel/pid.c`" % THE_PLAN] and "at docs/roadmap.md:14, docs/roadmap-archive-1.md:7. Green:" in got[0] and reads(lambda: [again(), squashed()])[0] == [])
    fixture(T)
    swap(T, THE_PLAN, "`kernel/pid.c` line 28 at v1", "`kernel/pid.c` at v1")
    with contextlib.redirect_stdout(io.StringIO()) as said:
        code = main(["devloop-handover-checks", "--all"], T)
    case("--all as the one argument of the program: every line read, every check green, exit 0", code == 0 and " paragraphs, with --all\n" in said.getvalue() and said.getvalue().endswith("green: %d checks green, 0 red\n" % len(CHECKS)))
    with contextlib.redirect_stderr(io.StringIO()) as said:
        code = main(["devloop-handover-checks", "--all", "--self-test"], T)
    case("exit 2: --all beside another argument, the usage on stderr", code == 2 and said.getvalue().startswith("usage: "))
    fixture(T)
    tgit(T, "update-ref", "-d", "refs/remotes/origin/main")
    code, lines = run(T)
    case("exit 2: no origin/main, so no commit the branch forked from: one line that says so, and no last line", code == 2 and len(lines) == 1 and "cannot run: git merge-base HEAD origin/main ended with " in lines[0] and "--all reads every line and asks git nothing" in lines[0])
    case("exit 2: no origin/main: behind the code git ended with, the line carries the first line git said", code == 2 and re.search(r"origin/main ended with [0-9]+, \S.*: without that answer", lines[0]) is not None)
    code, lines = run(T, everything=True)
    case("--all without origin/main: git asked nothing, every line read", code == 1 and lines[-1] == "red: %d checks green, 1 red: plan-lines" % (len(CHECKS) - 1))
    got, note = reads(lambda: put(T, "docs/roadmap-archive-2.md", "# Roadmap\n\n## Known gaps\n\n- **%s** Old.\n" % GATE), True)
    case("--all: a head that two archives carry and docs/roadmap.md does not is not red, an archive being mended by no branch", places_of(got) == ["plan-lines: %s:5: line 28, a line of `kernel/pid.c`" % THE_PLAN])
    fixture(T)
    tgit(T, "update-ref", "refs/remotes/origin/main", tgit(T, "commit-tree", "-m", "another history", "HEAD^{tree}").strip())
    code, lines = run(T)
    case("exit 2: origin/main shares no commit with HEAD, git ending with 1 and saying nothing: one line that says so, nothing of git's behind the 1, and no last line", code == 2 and len(lines) == 1 and "cannot run: git merge-base HEAD origin/main ended with 1: without that answer" in lines[0])

    print("SELF-TEST FAILED: %d of %d cases: %s" % (len(failed), seen, "; ".join(failed)) if failed else "SELF-TEST PASSED: %d cases" % seen)
    return int(bool(failed))


def main(argv, root=None):
    if argv[1:] == ["--self-test"]:
        return selftest()
    everything = argv[1:] == ["--all"]
    argv = argv[:1] if everything else argv
    if argv[1:]:
        sys.stderr.write("usage: devloop-handover-checks [--all | --self-test]\n")
        return 2
    code, lines = run(root or os.path.dirname(os.path.dirname(os.path.abspath(__file__))), everything=everything)
    (sys.stderr if code == 2 else sys.stdout).write("\n".join(lines) + "\n")
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
