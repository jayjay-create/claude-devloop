#!/usr/bin/env python3
"""devloop-handover-checks: the checks under "Before a handover, run these" in
docs/skill-conventions.md, every one but the run of the workflow's steps, each
held against the answer it has when it is green.

Usage
    scripts/devloop-handover-checks              every check, in the
                                                 repository this file stands in
    scripts/devloop-handover-checks --self-test  every outcome once, in a
                                                 throwaway directory outside
                                                 the repository

Exit 0 where every check is green; 1 where one is red; 2 where the program
cannot run: an argument it does not take, a directory above it that is not
devloop's repository, a tool its commands name that the path they run with
does not hold, a list that cannot be read. The last line says which of the
first two: it opens with "green:" or with "red:" and carries the count of the
green checks and of the red ones, the red ones by name. Where it cannot run it
prints one line on stderr that says why, and no such last line.

What a check is. One call of check() below: a name, the sentence that says
what it holds, its command and the answer that is green. The command is the
one of the command block the section carried for the check, word for word
but for two, decided on 23 November 2026: default-branch counts in a second
line the files that carry the opening line of the block it checksums, since
four checksums of nothing are one line too; locked-skills prints every place
that names a locked skill, grep -n, where the block printed every file,
grep -l, since a second place in a file its list carries would otherwise go
unseen. The run of the workflow's steps, scripts/devloop-run-workflow, is
none of them: it runs the workflow that runs this program.

How a command runs. With bash --noprofile --norc -c, in the root of the
repository, in the environment env -i PATH=/usr/bin:/bin leaves. So grep, sed
and awk are the system's programs and no alias or function of a session's
shell, no locale of a session decides what awk counts or how a list sorts, and
a check answers in a session of Claude Code what it answers in a terminal and
in the workflow. The commands need bash, python3 and git and what POSIX gives
beside them, and no GNU tool: the program runs on macOS as on ubuntu-latest.

What is green. Two kinds of answer.
- A fixed one: silence, a count, two empty lists, one line per skill. The
  lines a command prints are held against it with the blanks around them
  taken off, since wc pads its count on macOS and not under GNU, and in no
  order. Where an answer depends on the number of the skills, the program
  counts the files skills/*/SKILL.md, so that this number stands in no
  second place.
- A list of lines read. The checks on invocability, on locked skills, on
  offers, on handovers and on a second statement of the unattended finish
  print lines somebody has to judge, and a program judges none. Each has a
  file under docs/handover-checks/, named by the check, that carries the
  lines the check prints which were read and found right, one a line, as the
  command prints it with the line number taken out: FILE:TEXT for a line of
  grep -n, FILE:COUNT for the line of grep -c that invocability prints. Equal
  is green. A line the command prints that the list does not carry is new, a
  line of the list that the command prints no more is gone; either is red and
  printed, and the branch that changed it reads it against the paragraph of
  its check and brings the list in line. In such a file a line that starts
  with # and an empty line are no line of the list.
In both kinds a line on stderr is red: a command that printed an error has
not answered, and silence behind an error is how a check comes to look as if
it passed.

What a red find carries: the check's name, the file and the line where the
command names them, the text, and what makes it green.

What the program does not hold: that a line of a list is right. Whoever wrote
it there read it.
"""

import collections
import contextlib
import glob
import io
import os
import re
import shutil
import subprocess
import sys
import tempfile

PATH = "/usr/bin:/bin"
TOOLS = ("bash", "python3", "git", "grep", "sed", "awk", "cat", "cksum", "sort", "wc", "tail", "find")
LISTS = "docs/handover-checks"
PARAGRAPH = 'the paragraph of this check under "Before a handover, run these" in docs/skill-conventions.md'
STDERR = "the command wrote this to stderr, and a command that printed an error has not answered. Green: it runs without one and prints what is green"
NEW = 'new, the list %s does not carry it. Green: the line is read against %s; where it holds, it goes into the list as "%s", and where it does not, the file is mended'
GONE = "gone, the list %s carries it and the check prints it no more. Green: the change that took it is read against %s, and the line leaves the list"
NUMBER = re.compile(r"^([^:]+):[0-9]+:")
PLACE = re.compile(r"^((?:skills|shared|bin|scripts|hooks|docs)/[^:\s]*)(?::([0-9]+)(?=:))?(?::\s*(.*))?$")
CHECKS = []


class CannotRun(Exception):
    pass


def skills(root):
    return sorted(os.path.relpath(p, root).replace(os.sep, "/") for p in glob.glob(os.path.join(root, "skills", "*", "SKILL.md")))


def nothing(root, got):
    return []


def openings(root, got):
    # one line per skill: the opening before any heading, in start-work under the heading on how to talk
    return ["%s: opening %s" % (f, 'under "## How to talk while doing all this"' if f == "skills/start-work/SKILL.md" else "before any heading") for f in skills(root)]


def one_notice(root, got):
    # one line of cksum, whatever its number, and the count of the skills
    one = len(got) == 2 and re.match(r"^[0-9]+ [0-9]+$", got[0])
    return [got[0] if one else "one line of cksum", str(len(skills(root)))]


def check(key, says, where, command, kind, green=None, want=nothing, read=PARAGRAPH):
    CHECKS.append({"key": key, "says": says, "where": where, "command": command.strip("\n"), "kind": kind, "green": green, "want": want, "read": read})


check("registered",
      "Every skill on disk is registered, and every registered skill exists",
      ".claude-plugin/plugin.json and skills/",
      r'''
python3 -c "
import json,pathlib
m=[p.split('/')[-1] for p in json.load(open('.claude-plugin/plugin.json'))['skills']]
d=sorted(p.name for p in pathlib.Path('skills').iterdir())
print('registered but missing:', sorted(set(m)-set(d)))
print('present but unregistered:', sorted(set(d)-set(m)))"
''',
      "answer",
      'both lists empty: every directory under skills/ stands under "skills" in .claude-plugin/plugin.json, and every entry there has its directory',
      want=lambda root, got: ["registered but missing: []", "present but unregistered: []"])

check("roadmap-names",
      "No name in the roadmap resembles a real one without being one",
      "docs/roadmap.md",
      r'''
python3 -c "
import re,pathlib,functools
t=open('docs/roadmap.md').read()
w=set(re.findall(r'\x60([a-z0-9-]*)\x60',t))
d={p.name for p in pathlib.Path('skills').iterdir() if p.is_dir()}
s=t.split('\n## Named, not built as skills\n',1)
r=set(re.findall(r'^\|\s*\x60([a-z0-9-]+)\x60\s*\|',s[1].split('\n## ',1)[0],re.M)) if len(s)==2 else set()
n=d|r
e=functools.lru_cache(None)(lambda a,b:len(a+b) if len(a)==0 or len(b)==0 else min(e(a[1:],b)+1,e(a,b[1:])+1,e(a[1:],b[1:])+1-(a[0]==b[0])))
if len(r)==0 or len(d)==0: print('nothing to hold the roadmap against: %d rows under the table, %d directories under skills/'%(len(r),len(d)))
for x,m in [(x,m) for x in sorted(w-n) for m in sorted(n) if len(m)>=6 and e(x,m)<=2]: print('%s is %d from %s'%(x,e(x,m),m))
"
''',
      "lines",
      'silence: the word is written as the name it was meant to be, or its name gets a directory under skills/ or a row of the table "Named, not built as skills"; and the table carries a row and skills/ a directory')

check("invocability",
      "Invocability is set deliberately, not by omission",
      "skills/*/SKILL.md",
      r'''
grep -c 'disable-model-invocation' skills/*/SKILL.md
''',
      "list",
      read='"## Who may invoke a skill" in docs/skill-conventions.md, which decides for every skill whether a lock stands in its frontmatter, 1, or none, 0')

check("locked-skills",
      "No skill is told to run a skill that is locked against being run",
      "skills/*/SKILL.md and shared/*.md",
      r'''
for s in $(grep -l 'disable-model-invocation' skills/*/SKILL.md | sed 's|skills/||;s|/SKILL.md||'); do
  grep -n "\`$s\`" skills/*/SKILL.md shared/*.md | grep -v "^skills/$s/SKILL.md:"
done
''',
      "list")

check("shared-copies",
      "No shared text still stands written out in a skill",
      "skills/*/SKILL.md",
      r'''
cat shared/*.md | awk 'length >= 40' | grep -Fl -f - skills/*/SKILL.md
''',
      "lines",
      "silence: the copy goes from the skill this line names, which carries a line of forty characters or more of a file under shared/ and inserts that text instead")

check("insert-lines",
      "Every insert line has exactly the form the frontmatter grants, and names a file that exists",
      "skills/*/SKILL.md",
      r'''
grep -n -e '^!`' -e 'devloop-text' skills/*/SKILL.md | awk '{ l=$0; sub(/^[^:]*:[^:]*:/, "", l) } l != "allowed-tools: Bash(${CLAUDE_PLUGIN_ROOT}/bin/devloop-text *)" && l !~ /^!`\$\{CLAUDE_PLUGIN_ROOT\}\/bin\/devloop-text [a-z0-9-]+`$/'
for n in $(grep -ho 'devloop-text [a-z0-9-]*`$' skills/*/SKILL.md | sed 's/devloop-text //;s/`$//' | sort -u); do [ -f "shared/$n.md" ] || echo "no shared/$n.md"; done
''',
      "lines",
      "silence: a line that starts with the insert marker or names bin/devloop-text is the grant or an insert line of the granted form, and the name behind devloop-text is a file under shared/")

check("grant",
      "Every skill that inserts anything carries the grant that lets the program run at load without a prompt",
      "skills/*/SKILL.md",
      r'''
for f in skills/*/SKILL.md; do grep -q '^!`' "$f" && ! grep -qF 'allowed-tools: Bash(${CLAUDE_PLUGIN_ROOT}/bin/devloop-text *)' "$f" && echo "$f: inserts without the allowed-tools line"; done
''',
      "lines",
      "silence: the frontmatter of a skill that inserts carries the line allowed-tools: Bash(${CLAUDE_PLUGIN_ROOT}/bin/devloop-text *)")

check("language-block",
      "The language block stands at its two places in every file",
      "skills/*/SKILL.md",
      r'''
for f in skills/*/SKILL.md; do
  [ "$(tail -n 1 "$f")" = '!`${CLAUDE_PLUGIN_ROOT}/bin/devloop-text closing`' ] || echo "$f: does not end on the closing language block"
  awk -v f="$f" '/^## /{h=$0} /devloop-text language-opening`$/{n++; o=NR; print f": opening " (h=="" ? "before any heading" : "under \"" h "\"")} /devloop-text skill-name`$/{m++; if(NR!=o+2) print f": skill-name line not two lines under the opening"} END{if(n!=1) print f": opening block inserted " n+0 " times"; if(m!=1) print f": skill-name line inserted " m+0 " times"}' "$f"
done
''',
      "lines",
      'one line per skill saying where the opening stands, before any heading and in start-work under "## How to talk while doing all this", and nothing else: the closing block is the last line of the file, and the opening and the line on skill names are inserted once each, the second two lines under the first',
      want=openings)

check("notice",
      "The notice above the first insert line is the same paragraph in every skill",
      "skills/*/SKILL.md",
      r'''
for f in skills/*/SKILL.md; do sed -n '/^\*\*If `\[shell command execution disabled by policy\]`/,/^$/p' "$f" | cksum; done | sort -u
grep -l '^\*\*If `\[shell command execution disabled by policy\]`' skills/*/SKILL.md | wc -l
''',
      "answer",
      "one line of cksum and the count of the skills: the paragraph from **If `[shell command execution disabled by policy]` to the next empty line stands in every skill and reads the same in all",
      want=one_notice)

check("expansion",
      "Every skill expands without error",
      "skills/*/SKILL.md",
