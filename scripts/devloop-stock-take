        case("a segment starting like the not-stated note and not carrying it",
             err("note 'outcome with nobody there not stated yet' does not "
                 "carry the form"),
             states.get(NOBODY_T) == "Undetermined")
        case("the root note on a thing whose site is not under skills/",
             err("carries 'enters the unattended mode', but its site is not "
                 "under skills/"),
             res.roots == [SP])
        case("a unit with no anchorable line at all",
             ("skills/zeta/SKILL.md", 3) in
             {(f, n) for f, n, _ in res.unanchorable_units}
             and ("skills/zeta/SKILL.md", 7) in
             {(f, n) for f, n, _ in res.unanchorable_units},
             ("skills/zeta/SKILL.md", 1) not in
             {(f, n) for f, n, _ in res.unanchorable_units}
             and not any(f == A for f, _, _ in res.unanchorable_units))
        case("the table cannot be read",
             has(res_missing, "cannot read ") and res_missing.things == [],
             not any("cannot read" in e for e in res.table_errors))
        case("the header is not the 20 columns",
             has(res_header, "line 1: the header is not the 20 columns this "
                 "tool names") and res_header.things == [],
             not any("the header is not" in e for e in res.table_errors))
        case("git failing on the shallow check, a directory that is no "
             "repository included",
             res_norepo.refused is not None
             and "not a git repository" in res_norepo.refused
             and (asserted.append(res_norepo.refused) or True),
             res.refused is None)
        case("--only without a path",
             only_code == 2
             and "--only needs at least one path" in only_err.getvalue()
             and (asserted.append("--only needs at least one path") or True),
             res.refused is None)
        # shallow clone
        shallow = os.path.join(tmp, "shallow")
        subprocess.run(["git", "clone", "-q", "--depth", "1", "file://" + root,
                        shallow], check=True, capture_output=True)
        res_shallow = collect(analyse(shallow, table))
        case("shallow clone",
             res_shallow.refused is not None and "shallow" in res_shallow.refused
             and (asserted.append(res_shallow.refused) or True),
             res.refused is None)
        # the report's own lines, which the count of messages below does not
        # read: python3 -m trace --count --missing over the self-test found
        # these three never reached on 23 September 2026
        case("the report of a table with no root",
             "SKILLS THE UNATTENDED MODE REACHES: not computed, no root"
             in render(res_no_root),
             "SKILLS THE UNATTENDED MODE REACHES: %d" % len(res.reached)
             in render(res) and "not computed" not in render(res))
        case("the report of a refused repository",
             render(res_shallow).startswith("REFUSED: shallow clone")
             and "BROKEN RECORDS" not in render(res_shallow),
             render(res).startswith("BROKEN RECORDS: "))
        case("the report where every run counts",
             "RUNS THAT DO NOT COUNT\n  none\n" in render(res_clean),
             "RUNS THAT DO NOT COUNT\n  line " in render(res)
             and "\n  none\n" not in render(res))
        case("exit code 2 on a broken record and on a refused repository",
             exit_code(res) == 2 and exit_code(res_shallow) == 2
             and exit_code(res_norepo) == 2,
             exit_code(res_clean) == 0 and not res_clean.broken_count()
             and not res_clean.uncovered)
        case("exit code 1 on an uncovered line",
             exit_code(res_gaps) == 1 and not res_gaps.broken_count()
             and res_gaps.uncovered,
             exit_code(res_clean) == 0)
    # every message the tool can produce, against what the cases asserted
    templates = message_templates(os.path.abspath(__file__))
    without = []
    for shape, line, template in templates:
        rx = template_regex(template)
        hits = [m for m in produced
                if (rx.search(m) if shape == "fragment" else rx.fullmatch(m))]
        if not any(a in m for m in hits for a in asserted):
            without.append((line, template))
    for line, template in without:
        print("no case: line %d: %s" % (line, template))
    if failures:
        print("SELF-TEST FAILED: " + ", ".join(failures))
        return 2
    print("SELF-TEST PASSED: %d cases; of the %d messages this tool rejects, "
          "refuses or answers with, read off its own source, %d are asserted "
          "by a case and %d by none; the lines of the report are not in that "
          "count" % (len(cases), len(templates), len(templates) - len(without),
                     len(without)))
    return 0


# ---------------------------------------------------------------- main

def main(argv):
    if "--self-test" in argv:
        return selftest()
    only = []
    if "--only" in argv:
        only = argv[argv.index("--only") + 1:]
        if not only:
            print("--only needs at least one path", file=sys.stderr)
            return 2
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    res = analyse(root, only=only)
    sys.stdout.write(render(res))
    return exit_code(res)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
