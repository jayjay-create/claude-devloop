        def thing(name, file, anchor, kind="skill branch", ev=True, **kw):
            d = dict(type="thing", name=name, kind=kind, file=file, anchor=anchor)
            if ev:
                d.update(evidence_file=file, evidence_anchor=anchor)
            d.update(kw)
            return rec(**d)

        def run(name, date, anchor, **kw):
            d = dict(type="run", name=name, date=date, source="entry",
                     run_file=R, run_anchor=anchor)
            d.update(kw)
            return rec(**d)

