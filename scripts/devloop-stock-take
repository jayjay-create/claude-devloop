        def block(title, found, fix, status, wrong="w", should="s", **extra):
            out = ["### " + title, "- Wrong: " + wrong]
            if should is not None:
                out.append("- Should: " + should)
            if found is not None:
                out.append("- Found: " + found)
            if fix is not None:
                out.append("- Fix: " + fix)
            if status is not None:
                out.append("- Status: " + status)
            for k in ("Note", "Trigger", "Bench", "Cost"):
                if k in extra:
                    out.append("- %s: %s" % (k, extra[k]))
            return "\n".join(out) + "\n"

        def anchor(rel, text):
            return '`%s` "%s"' % (rel, text)

