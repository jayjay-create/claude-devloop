             and GB_NEW_KEPT not in g_green["changed"]
             and not any(GB_NEW_KEPT in e for e in res_g_green.guard_errors))
        case("a title with quotes, backticks and a colon: red without its "
             "line, green with the fixed form carrying it whole",
             gerr(res_g_red, "the block %r stood in docs/defects.md at %s, %s"
                  % (GB_QUOTED, g1[:7], no_line)),
             GB_QUOTED in g_green["removed"]
             and not any(GB_QUOTED in e for e in res_g_green.guard_errors))
        case("a branch behind main, whose main gained a block after the branch "
             "point: the block is no removal, nothing red",
             gerr(res_g_red, "the branch point, and stands in the working tree "
                  "no more"),
             not res_g_behind.guard_errors
             and res_g_behind.guard["removed"] == []
             and res_g_behind.guard["base"] == g1
             and GB_MAIN not in res_g_behind.guard["added"])
        case("no origin/main: the blocks are not held against a branch point, "
             "said in one line and not red",
             res_norigin.guard == {"note": "origin/main is not here, so the "
                                   "blocks are not held against a branch point"}
             and "  origin/main is not here, so the blocks are not held "
                 "against a branch point\n" in render(res_norigin),
             "note" not in g_green and g_green["base"] == g1)
        case("no commit shared by HEAD and origin/main: the blocks are not held "
             "against a branch point, said in one line and not red",
             res_g_lonely.guard == {"note": "HEAD and origin/main share no "
                                    "commit, so the blocks are not held "
                                    "against a branch point"}
             and not res_g_lonely.guard_errors
             and "  HEAD and origin/main share no commit, so the blocks are "
                 "not held against a branch point\n" in render(res_g_lonely),
             "note" not in g_green)
        case("the defects file not at the branch point: nothing to hold the "
             "blocks against, said in one line and not red",
             res.guard == {"base": c3, "note": "docs/defects.md does not stand "
                           "at %s, the branch point, so there is nothing to "
                           "hold the blocks against" % c3[:7]}
             and not res.guard_errors,
             "note" not in g_green)
        case("the report: the blocks held against the branch point, the "
             "counts and each change named",
             "BLOCKS HELD AGAINST THE BRANCH POINT (git merge-base HEAD "
             "origin/main; a change needs its line in docs/roadmap.md)\n"
             "  branch point %s: blocks removed 2, renamed 3, Should changed 2, "
             "added 0; lines of the fixed forms added to docs/roadmap.md: 7\n"
             "    removed         %s\n    removed         %s\n"
             "    renamed         %s / %s\n    renamed         %s / %s\n"
             "    renamed         %s / %s\n"
             "    Should changed  %s\n    Should changed  %s\n"
             % (g1[:7], GB_GONE, GB_QUOTED, GB_OLD, GB_NEW, GB_OLD_CH, GB_NEW_CH,
                GB_OLD_KEPT, GB_NEW_KEPT, GB_SHOULD, GB_NEW_CH)
             in render(res_g_green)
             and "  against the branch point: the block %r stood" % GB_GONE
             in render(res_g_red),
             "BLOCKS HELD AGAINST THE BRANCH POINT" in render(res_norigin)
             and "    removed" not in render(res_g_behind))
        # the archives of the roadmap, section F: what the tool reads in
        # one, and the archives held against the branch point
        a_states = {d["name"]: d["state"] for d in res_a_green.defects}

        def aerr(sub):
            return has(res_a_changed, sub)
        case("a Found naming a head that stands in an archive of the roadmap "
             "alone, or in the roadmap alone: green; in both, or in neither: "
             "red, the files named",
             aerr("Found names a head standing 2 times under '## Known gaps' "
                  "in docs/roadmap.md and docs/roadmap-archive-1.md: %r"
                  % AH_BOTH)
             and aerr("Found names no head under '## Known gaps' in "
                      "docs/roadmap.md or docs/roadmap-archive-1.md: %r"
                      % AH_NOWHERE),
             a_states.get(AD_ARCHIVE) == "Recorded, not built"
             and a_states.get(AD_ROADMAP) == "Recorded, not built"
             and not res_a_green.defect_errors)
        case("a Fix pointing at an archive of the roadmap",
             aerr("Fix points at docs/roadmap-archive-1.md, where no repair "
                  "stands"),
             states.get(DEF_CHECK) == "Walked")
        case("a defect closed as left on purpose, decided in an archived "
             "entry: the decision line found once, the archive's closing line "
             "that quotes it left out of the count; a text standing twice, or "
             "not at all, in the archive: red; a run and a Trigger pointing "
             "at a line of the archive",
             aerr("closed as left on purpose: %r in docs/roadmap-archive-1.md: "
                  "found more than once, on lines 9 and 10, so it is not an "
                  "anchor" % A_TWICE)
             and aerr("closed as left on purpose: %r in "
                      "docs/roadmap-archive-1.md: not found" % A_GONE),
             a_states.get(AD_LEFT) == "Closed"
             and all(r["counts"] for r in res_a_green.runs)
             and len(res_a_green.runs) == 1
             and not res_a_green.broken_count())
        case("an archive that stood at the branch point, changed, removed or "
             "renamed: red with its name; unchanged: green",
             has(res_a_changed, "the archive docs/roadmap-archive-1.md is not "
                 "what stood at %s, the branch point: an archive never changes"
                 % a1[:7])
             and has(res_a_removed, "the archive docs/roadmap-archive-1.md "
                     "stood at %s, the branch point, and stands in the working "
                     "tree no more: an archive is neither renamed nor removed"
                     % a1[:7])
             and has(res_a_renamed, "the archive docs/roadmap-archive-1.md "
                     "stood at %s, the branch point, and stands in the working "
                     "tree no more" % a1[:7])
             and has(res_a_renamed, "the archive docs/roadmap-archive-2.md is "
                     "new on this branch and is not docs/roadmap.md as it "
                     "stood at %s, the branch point" % a1[:7])
             and exit_code(res_a_changed) == 2 and exit_code(res_a_removed) == 2,
             not res_a_green.archive_errors
             and res_a_green.archives == {"base": a1, "held": [ARCH1],
                                          "added": []}
             and exit_code(res_a_green) == 0)
        case("an archive the branch adds, docs/roadmap.md at the branch point "
             "byte for byte under the next free number: green; another "
             "number, another content, or no roadmap at the branch point: red",
             has(res_a_number, "the archive docs/roadmap-archive-3.md is new on "
                 "this branch and carries the number 3, where the next free "
                 "number after %s, the branch point, is 2" % a1[:7])
             and has(res_a_content, "the archive docs/roadmap-archive-2.md is "
                     "new on this branch and is not docs/roadmap.md as it "
                     "stood at %s, the branch point" % a1[:7])
             and has(res_a_no_roadmap, "the archive docs/roadmap-archive-1.md "
                     "is new on this branch, and no docs/roadmap.md stood at "
                     "%s, the branch point, for it to be a copy of" % a0[:7])
             and exit_code(res_a_number) == 2,
             not res_a_added.archive_errors
             and res_a_added.archives == {"base": a1, "held": [ARCH1],
                                          "added": [ARCH2]}
             and exit_code(res_a_added) == 0)
        case("no origin/main, or no commit shared with it: the archives are "
             "not held against a branch point, said in one line and not red",
             res_norigin.archives == {"note": "origin/main is not here, so the "
                                      "archives of the roadmap are not held "
                                      "against a branch point"}
             and res_g_lonely.archives == {"note": "HEAD and origin/main share "
                                           "no commit, so the archives of the "
                                           "roadmap are not held against a "
                                           "branch point"}
             and not res_norigin.archive_errors
             and not res_g_lonely.archive_errors,
             "note" not in res_a_green.archives
             and "note" not in res.archives and res.archives["base"] == c3)
        case("the report: the archives of the roadmap held against the branch "
             "point, under a heading of their own, the errors under BROKEN "
             "RECORDS",
             "ARCHIVES OF THE ROADMAP HELD AGAINST THE BRANCH POINT (git "
             "merge-base HEAD origin/main; an archive never changes)\n"
             "  branch point %s: archives standing there 1, added by this "
             "branch 1\n    held            %s\n    added           %s\n"
             % (a1[:7], ARCH1, ARCH2) in render(res_a_added)
             and "  archives: the archive docs/roadmap-archive-1.md is not "
                 "what stood at" in render(res_a_changed)
             and "BROKEN RECORDS: %d\n" % res_a_changed.broken_count()
             in render(res_a_changed),
             "  origin/main is not here, so the archives of the roadmap are "
             "not held against a branch point\n" in render(res_norigin)
             and "    added" not in render(res_a_green)
             and "  branch point %s: archives standing there 0, added by this "
                 "branch 0\n" % c3[:7] in render(res))
    # every message the tool can produce, against what the cases asserted
    templates = message_templates(os.path.abspath(__file__))
    without = []
    for shape, line, template in templates:
        rx = template_regex(template)
        hits = [m for m in produced
                if (rx.search(m) if shape == "fragment" else rx.fullmatch(m))]
        if not any(a in m for m in hits for a in asserted):
            without.append((line, template))
    for line, template in without:
        print("no case: line %d: %s" % (line, template))
    if failures:
        print("SELF-TEST FAILED: " + ", ".join(failures))
        return 2
    print("SELF-TEST PASSED: %d cases; of the %d messages this tool rejects, "
          "refuses or answers with, read off its own source, %d are asserted "
          "by a case and %d by none; the lines of the report are not in that "
          "count" % (len(cases), len(templates), len(templates) - len(without),
                     len(without)))
    return 0


# ---------------------------------------------------------------- main

def main(argv):
    if "--self-test" in argv:
        return selftest()
    only = []
    if "--only" in argv:
        only = argv[argv.index("--only") + 1:]
        if not only:
            print("--only needs at least one path", file=sys.stderr)
            return 2
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    res = analyse(root, only=only)
    sys.stdout.write(render(res))
    return exit_code(res)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
