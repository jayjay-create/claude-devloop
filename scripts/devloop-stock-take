            thing(SECOND, A, "## Second",
                  note="calls beta; with nobody there: not reached per " + SP),
            thing(THIRD, A, "## Third"),
            thing("gamma / Gamma / straight path", G, "# Gamma"),
            thing("gamma / Gamma / third form where nothing reaches", G,
                  "```markdown", ev=False, note="calls beta; " + NOBODY_NONE),
            thing("epsilon / Epsilon / straight path", E, "# Epsilon"),
            # green: a second file of a skill takes its path as the source;
            # a heading standing twice in one file takes the enclosing one
            thing("skills/alpha/LOGIC.md / Alpha / straight path", L, "# Alpha"),
            thing("epsilon / First / straight path", E, "## First"),
            thing("epsilon / First > Twice / straight path", E,
                  "Text under the first twice."),
            thing("epsilon / Second / straight path", E, "## Second"),
            thing("epsilon / Second > Twice / straight path", E,
                  "Text under the second twice."),
            # red: the skill's name as the source of a file that is not its
            # SKILL.md; the bare heading where it stands twice
            thing("alpha / Alpha / the skill's name on a second file", L,
                  "If the extra file says so", ev=False),
            thing("epsilon / Twice / bare heading", E, "under the second twice",
                  ev=False),
            thing(NOTE_SP, "shared/note.md", "somebody writes in German, answer",
                  kind="shared text"),
            thing(NOTE_G, "shared/note.md", "When somebody writes in German",
                  kind="shared text"),
            thing("shared/inserted.md / whole file / straight path",
                  "shared/inserted.md", "Inserted text, second wording.",
                  kind="shared text", note="calls epsilon"),
            # red: a reach claim in a skill nothing reaches; a per in one; a
            # reach claim in shared text; the third form where the mode reaches
            thing("gamma / Gamma / reached claim where nothing reaches", G,
                  "heading inside it is not a unit", ev=False,
                  note="calls beta; with nobody there: reached per " + NOBODY_T),
            thing("gamma / Gamma / per where nothing reaches", G,
                  "If a fence stands here, the heading", ev=False,
                  note="calls beta; with nobody there: not reached per " + SP),
            thing("shared/note.md / whole file / claim in shared text",
                  "shared/note.md", "answer in German, always.", kind="shared text",
                  ev=False,
                  note="calls beta; with nobody there: reached per " + NOBODY_T),
            thing("alpha / Alpha / third form where the mode reaches", A,
                  "it rains, carry on with the ordinary", ev=False,
                  note="calls beta; " + NOBODY_NONE),
            thing(CHECK, "docs/skill-conventions.md",
                  "ls skills/ | grep -c nothing-of-that-name",
                  kind="check command", note="green prints nothing"),
            thing(GUARD, "hooks/guard.sh", "echo blocked >&2", kind="hook outcome"),
            # red: a unit part that is not "whole file" in a file without units
            thing("hooks/guard.sh / guard / unit part in a file without units",
                  "hooks/guard.sh", "[ -d docs/agents ] || exit 0",
                  kind="hook outcome", ev=False),
            thing("docs/roadmap.md / Known gaps / a defect", R,
                  "A defect measured on 2026-01-06", kind="defect", ev=False,
                  evidence_file=R, evidence_anchor="Recorded, not built."),
            # red: anchor missing
            thing("alpha / Alpha / missing anchor", A,
                  "this text stands nowhere in the file", ev=False),
            # red: anchor found twice (a short whole line that repeats)
            thing("hooks/guard.sh / whole file / double", "hooks/guard.sh", "exit 0",
                  kind="hook outcome", ev=False),
            # red: two things on one anchor
            thing("alpha / Alpha / same anchor twin", A,
                  "If the sky is blue, say that it is blue", ev=False),
            # red: two things with one name
            thing(GREY, A, "the sky is grey, say that", ev=False),
            # red: named skill whose directory exists; green: one that does
            # not; both sit on their rows of the named table, and the row of
            # the name a thing does the work of is part of that thing
            thing(NAMED + "beta", R, "`beta` | A name whose directory exists",
                  kind="named skill", ev=False,
                  note="grep -rn beta skills/ came back empty"),
            thing(NAMED + "delta", R,
                  "`delta` | A name whose directory does not exist",
                  kind="named skill", ev=False,
                  note="grep -rn delta skills/ came back empty"),
            rec(type="not-a-thing", file=R,
                anchor="`implement-ticket` | Build one task",
                note="part of: " + SP),
            # red: unknown type; unknown kind
            rec(type="thang", file=A, anchor="The third unit, stable", note="rationale"),
            thing("alpha / Third / twig", A, "unit, stable from the first",
                  kind="skill twig", ev=False),
            # red: a name without its three parts
            thing("alpha-only", A, "say that it is blue today", ev=False),
            # red: a name carrying the separator of the note forms
            thing("alpha / Alpha / semicolon; separated", A,
                  "The third unit, stable from", ev=False),
            # red: a name whose source is not the site's
            thing("omega / Third / wrong source", A,
                  "stable from the first commit on", ev=False),
            # red: a heading inside a fenced block taken for a unit
            thing("gamma / Fake / straight path", G, "## Fake"),
            # red: a second straight path of one unit
            thing(SP, A, "rains, carry on with the ordinary work", ev=False),
            # red: calls naming no directory; per naming no thing;
            # not stated per a thing without the note; the work of nobody
            thing("alpha / Alpha / calls nowhere", A, "say that it is grey and stop",
                  ev=False,
                  note="calls delta; with nobody there: reached per " + BLUE),
            thing("alpha / Alpha / per nowhere", A,
                  "Plain prose that decides nothing at all here", ev=False,
                  note="calls beta; with nobody there: reached per alpha / Alpha / nowhere"),
            thing("alpha / Alpha / not stated wrongly", A,
                  "carry on with the ordinary work, whistling", ev=False,
                  note="calls beta; with nobody there: not stated per " + GREY),
            thing("alpha / Alpha / does unknown work", A, "let the user decide how",
                  ev=False, note="does the work of nothing-of-that-name"),
            # runs
            run(GREY, "2026-01-06", "A defect measured on 2026-01-06, on the first",
                version="0.1.0"),
            run(GREY, "2026-01-11", "A run of alpha on 2026-01-11, on the second",
                version="0.2.0"),
            run(BLUE, "2026-01-11", "A run of alpha without a version",
                source="none"),
            run(BLUE, "2026-01-06", "A run of blue before the rain line changed",
                version="0.1.0"),
            run(BLUE, "2026-01-12", "A run of blue after the rain line changed",
                version="0.2.0"),
            run(CHECK, "2026-01-01", "A run of the check on the day of the change",
                version="0.1.0"),
            run(CHECK, "2026-01-02", "A run of the check the day after",
                version="0.1.0"),
            run(NOTE_G, "2026-01-11", "A run on the shared note", version="0.2.0"),
            run(GUARD, "2026-01-11", "A run that names a commit of main",
                commit=c2[:7]),
            run(GUARD, "2026-01-13", "A run that names a commit of a side branch",
                commit=c4[:7]),
            run(SP, "2026-01-06", "A run of the first unit before it changed",
                version="0.1.0"),
            run(SP, "2026-01-12", "A run of the first unit after it changed",
                version="0.2.0"),
            run(SECOND, "2026-01-06",
                "A run of the second unit before its insert changed",
                version="0.1.0"),
            run(THIRD, "2026-01-06", "A run of the third unit, which never changed",
                version="0.1.0"),
            # red: a run on a name no thing carries
            run("alpha / Alpha / nowhere", "2026-01-06",
                "A run on a thing nobody recorded", version="0.1.0"),
            # not-a-thing, green: part of; rationale
            rec(type="not-a-thing", file=A, anchor="Unless it rains, carry on",
                note="part of: " + BLUE),
            rec(type="not-a-thing", file=A, anchor="decides nothing at all here",
                note="rationale"),
            # red: an empty required field; a filled field the type does not
            # use; a reason not on the list; a part of naming no thing
            rec(type="not-a-thing", file=A, anchor="A second unit that says"),
            rec(type="not-a-thing", file=A, anchor="says one thing and decides nothing",
                note="rationale", kind="skill branch"),
            rec(type="not-a-thing", file=A, anchor="second unit that says one thing",
                note="prose"),
            rec(type="not-a-thing", file="skills/beta/SKILL.md", anchor="# Beta",
                note="part of: alpha / Alpha / nowhere"),
            # red: the root note on a record that is not a thing
            rec(type="not-a-thing", file=A, anchor="and let the user decide how",
                note="rationale; " + ROOT),
            # findings: green, and red without its should part
            rec(type="finding", file=G,
                anchor="If a fence stands here, the heading inside it",
                note="the fence is not explained" + SHOULD + "say why it stands"),
            rec(type="finding", file="docs/skill-conventions.md",
                anchor="One check, silent when green:", note="the check is wrong"),
            # red: a record whose first tab became spaces (19 fields)
            thing("alpha / Alpha / tab lost", A, "Plain prose that decides",
                  ev=False).replace("\t", "    ", 1),
        ]
        table = os.path.join(root, "docs", "stock-take.tsv")
        write(root, "docs/stock-take.tsv", "\n".join(rows) + "\n")
        res = analyse(root, table)
        print(render(res))
        # the same table with no root at all
        no_root = os.path.join(root, "docs", "no-root.tsv")
        write(root, "docs/no-root.tsv",
              "\n".join(r.replace("; " + ROOT, "") for r in rows) + "\n")
        res_no_root = analyse(root, no_root)
        errors = [e for _, e in res.broken] + res.table_errors
        runs = {(r["thing"]["name"], r["rec"]["date"]): r for r in res.runs}
        states = {t["name"]: t["state"] for t in res.things}
        uncovered = {(f, a) for f, a, b, _ in res.uncovered}
        unanch = {(f, n) for f, n, _ in res.unanchorable}
        no_sp = {(f, n) for f, n, _ in res.no_straight_path}

        def err(sub):
            return any(sub in e for e in errors)

        def counts(name, date):
            return runs[(name, date)]["counts"]

        def reason(name, date):
            return runs[(name, date)]["reason"]

        case("anchor missing",
             err("'this text stands nowhere in the file' in skills/alpha/SKILL.md: not found"),
             states.get(BLUE) is not None)
        case("anchor found twice",
             err("'exit 0' in hooks/guard.sh: found more than once"),
             states.get(GUARD) is not None)
        case("two thing records with one anchor",
             err("same site anchor as the thing on line"),
             states.get(GREY) is not None)
        case("run whose version predates the last change",
             not counts(GREY, "2026-01-06")
             and "predates" in reason(GREY, "2026-01-06")
             and "SKILL.md:4 (site)" in reason(GREY, "2026-01-06"),
             counts(GREY, "2026-01-11") and states[GREY] == "Walked")
        case("run with no recorded version",
             not counts(BLUE, "2026-01-11")
             and "not recorded" in reason(BLUE, "2026-01-11"),
             counts(GREY, "2026-01-11"))
        case("check-command run on the day of the change",
             not counts(CHECK, "2026-01-01"),
             counts(CHECK, "2026-01-02") and states[CHECK] == "Walked")
        case("uncommitted evidence line",
             not counts(NOTE_G, "2026-01-11")
             and "uncommitted" in reason(NOTE_G, "2026-01-11")
             and states[NOTE_G] == "Built, never walked",
             counts(GUARD, "2026-01-11"))
        case("a line of the set nobody covers",
             (G, 7) in uncovered
             and any(f == R and "`omega-skill`" in t
                     for f, _, _, t in res.uncovered),
             (A, 6) not in uncovered and (A, 3) not in uncovered
             and not any(f == R and ("`delta`" in t or "`implement-ticket`" in t)
                         for f, _, _, t in res.uncovered))
        case("named skill whose directory exists",
             err("named skill, but skills/beta exists"),
             states.get(NAMED + "delta") == "Undetermined"
             and not err("skills/delta exists"))
        case("record with a wrong number of fields",
             any("19 fields instead of 20" in e for e in res.table_errors),
             states.get("docs/roadmap.md / Known gaps / a defect")
             == "Recorded, not built")
        case("a line of the set that can carry no unique anchor, listed",
             ("hooks/guard.sh", 5) in unanch and ("hooks/guard.sh", 6) in unanch,
             ("hooks/guard.sh", 4) not in unanch
             and ("hooks/guard.sh", 2) not in unanch)
        case("run whose commit is not an ancestor of origin/main",
             err("commit %s is not an ancestor of origin/main" % c4[:7]),
             counts(GUARD, "2026-01-11"))
        case("unknown type",
             err("unknown type 'thang'"),
             states.get(BLUE) is not None)
        case("unknown kind",
             err("unknown kind 'skill twig'"),
             states.get(GREY) is not None)
        case("an empty required field",
             err("note is empty"),
             (A, 6) not in uncovered)
        case("a field filled that its type does not use",
             err("kind is filled, which a not-a-thing does not use"),
             (A, 5) not in uncovered)
        case("two things with one name",
             err("same name as the thing on line"),
             states.get(GREY) is not None)
        case("a run on a name no thing carries",
             err("no thing named 'alpha / Alpha / nowhere'"),
             counts(GREY, "2026-01-11"))
        case("a reason not on the list",
             err("reason 'prose' is not on the list"),
             res.reason_counts.get("rationale", 0) == 1)
        case("a part of naming no thing",
             err("part of 'alpha / Alpha / nowhere', which names no thing"),
             res.reason_counts.get("part of", 0) == 2)
        case("a thing name without its three parts",
             err("name 'alpha-only' does not have the three parts"),
             states.get(BLUE) is not None)
        case("a calls naming no directory under skills/",
             err("calls 'delta', but skills/delta is not a directory"),
             states.get(BLUE) is not None
             and not any(BLUE in e for e in errors))
        case("a per naming no thing",
             err("per 'alpha / Alpha / nowhere' names no thing"),
             states.get(BLUE) is not None)
        case("run before a change to a part-of line of its thing",
             not counts(BLUE, "2026-01-06")
             and "(part of)" in reason(BLUE, "2026-01-06")
             and "SKILL.md:6" in reason(BLUE, "2026-01-06"),
             counts(BLUE, "2026-01-12") and states[BLUE] == "Walked")
        case("run before a change inside the unit of its straight path",
             not counts(SP, "2026-01-06") and "(unit)" in reason(SP, "2026-01-06"),
             counts(SP, "2026-01-12") and states[SP] == "Walked")
        case("run before a change to a shared file inserted into the unit",
             not counts(SECOND, "2026-01-06")
             and "shared/inserted.md:1 (inserted)" in reason(SECOND, "2026-01-06"),
             counts(THIRD, "2026-01-06") and states[THIRD] == "Walked")
        case("a heading inside a fenced block taken for a unit",
             err("name's unit part 'Fake' is not the heading of the unit the "
                 "site lies in, 'Gamma'"),
             states.get("gamma / Gamma / straight path") is not None
             and not any(f == G for f, _, _ in res.no_straight_path))
        case("a unit part that is not 'whole file' where the file has no units",
             err("name's unit part 'guard' is not 'whole file', which a file "
                 "without units takes"),
             states.get(GUARD) is not None
             and not any(GUARD in e for e in errors))
        case("a unit with no straight path",
             ("skills/beta/SKILL.md", 1) in no_sp,
             (A, 1) not in no_sp and (A, 9) not in no_sp and (A, 14) not in no_sp)
        case("a unit with two straight paths",
             err("second straight path of the unit 'Alpha'"),
             states.get(SP) is not None)
        case("a not stated per naming a thing without that note",
             err("'not stated per' names 'alpha / Alpha / grey sky', which does "
                 "not carry"),
             states.get(NOBODY_T) == "Undetermined"
             and not any(BLUE in e for e in errors))
        case("a finding without its should part",
             err("a finding's note has the form"),
             any(f == G and n == 7 for f, n, _ in res.findings)
             and (G, 7) in uncovered)
        case("a does the work of naming no named skill",
             err("does the work of 'nothing-of-that-name', which the table"),
             not any(SP in e for e in errors))
        case("a name carrying the separator of the note forms",
             err("carries '; ', which the note forms use"),
             states.get(BLUE) is not None)
        case("a name whose source is not the site's",
             err("name's source part 'omega' is not 'alpha'"),
             states.get(THIRD) is not None)
        case("two files of one skill carrying the same heading",
             err("name's source part 'alpha' is not 'skills/alpha/LOGIC.md'"),
             states.get("skills/alpha/LOGIC.md / Alpha / straight path")
             is not None and (L, 1) not in no_sp)
        case("one file carrying the same heading twice",
             err("name's unit part 'Twice' is not the heading of the unit the "
                 "site lies in, 'Second > Twice'"),
             states.get("epsilon / First > Twice / straight path") is not None
             and states.get("epsilon / Second > Twice / straight path")
             is not None
             and not any(f == E for f, _, _ in res.no_straight_path))
        case("a reached claim in a skill the set does not carry",
             err("'with nobody there: reached per' stands in gamma, which "
                 "nothing reaches"),
             not any(BLUE in e for e in errors) and res.reached is not None
             and "beta" in res.reached and "gamma" not in res.reached)
        case("a per on a call in a skill that is not reached",
             err("'with nobody there: not reached per' stands in gamma, which "
                 "nothing reaches"),
             not any(SECOND in e for e in errors))
        case("a reach claim on a call in shared text",
             err("stands in shared text, where no reach claim can be made"),
             "epsilon" in (res.reached or {})
             and "shared/inserted.md" in res.reached.get("epsilon", ""))
        case("no thing carrying the root note",
             any("no thing carries" in e for e in res_no_root.table_errors)
             and res_no_root.reached is None,
             res.roots == [SP] and "alpha" in (res.reached or {}))
        case("the root note on a record that is not a thing",
             err("which only a thing may carry"),
             res.roots == [SP])
        case("the third form in a skill the mode reaches",
             err("stands in alpha, which the mode reaches"),
             not any("third form where nothing reaches" in e for e in errors))
        # shallow clone
        shallow = os.path.join(tmp, "shallow")
        subprocess.run(["git", "clone", "-q", "--depth", "1", "file://" + root,
                        shallow], check=True, capture_output=True)
        res_shallow = analyse(shallow, table)
        case("shallow clone",
             res_shallow.refused is not None and "shallow" in res_shallow.refused,
             res.refused is None)
    if failures:
        print("SELF-TEST FAILED: " + ", ".join(failures))
        return 2
    print("SELF-TEST PASSED: %d cases, every red outcome once, every green "
          "counterpart once" % len(cases))
    return 0


# ---------------------------------------------------------------- main

def main(argv):
    if "--self-test" in argv:
        return selftest()
    only = []
    if "--only" in argv:
        only = argv[argv.index("--only") + 1:]
        if not only:
            print("--only needs at least one path", file=sys.stderr)
            return 2
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    res = analyse(root, only=only)
    sys.stdout.write(render(res))
    return exit_code(res)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
