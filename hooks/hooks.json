{
  "description": "Session status with the session's identifier, the check suite, guards on the main branch, on merging, on the check table, on installing outside the repository, on the mark of a run with nobody there and on a command that sets the identity of a commit itself, the permission mode stated beside bin/devloop-permission-mode, and a no to every permission prompt while that mark stands",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-branch-guard.sh" },
                   { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-mark-guard.sh" } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "if": "Bash(git *)", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-branch-guard.sh" },
                   { "type": "command", "if": "Bash(gh pr merge*)", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-merge-guard.sh" },
                   { "type": "command", "if": "Bash(git *)", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-table-guard.sh" },
                   { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-install-guard.sh" },
                   { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-mark-guard.sh" },
                   { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-identity-guard.sh" } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/permission-request-unattended.sh" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-checks.sh" },
                   { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-table-guard.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-checks.sh" } ] }
    ]
  }
}
