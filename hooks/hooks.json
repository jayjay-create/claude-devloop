{
  "description": "Session status with the session's identifier, the install record and a rule on installing given to every subagent at its start, the check suite, guards on the main branch, on merging, on the check table, on installing outside the repository, on the mark of a run with nobody there and on a command that sets the identity of a commit itself, the permission mode stated beside bin/devloop-permission-mode, and a no to every permission prompt while that mark stands, the note on PostToolUse and PostToolUseFailure that the output style of devloop does not apply in this session, and the line in docs/agents/environment.md on what an install the record let through did, written on PostToolUse of a Bash call that succeeded, and the record of an install auto mode refused by one of the ways the rule for its classifier names, written by the install guard on PermissionDenied of a Bash call for the question at the next start with --auto",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-branch-guard.sh" },
                   { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-mark-guard.sh" } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-branch-guard.sh" },
                   { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-merge-guard.sh" },
                   { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-table-guard.sh" },
                   { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-install-guard.sh" },
                   { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-mark-guard.sh" },
                   { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-identity-guard.sh" } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "onFailure": "block", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/permission-request-unattended.sh" } ] }
    ],
    "PermissionDenied": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use-install-guard.sh" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh" } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start-install.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-checks.sh" },
                   { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-table-guard.sh" } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-install-fact.sh" } ] },
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-output-style.sh" } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-install-fact.sh" } ] },
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-output-style.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-checks.sh" } ] }
    ]
  }
}
